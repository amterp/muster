// Every command captured here names its targets `stdout`, `stderr` and `code`, and never
// anything else - not even `_`.
//
// Rad fills a capture by name when every target is spelled one of those three, and by
// position otherwise - and v0.12 reorders the positional form from (code, stdout, stderr)
// to (stdout, stderr, code). A named capture reads the same either way, so bumping
// deps/rad.pin does not mean re-reading every one.
//
// It is worth being strict about because the failure is quiet. `uname -s` captured
// positionally binds the exit code on one side and "Darwin" on the other, and the gate
// died at the `.trim()` two lines later, naming a type rather than a command.
//
// Where one result is wanted, this reads it off the command instead - `$`cmd`.stdout` -
// which has no slots to get wrong and lets the value keep a name that says what it is.
// The captures that remain are the ones that also need the other stream swallowed: an
// accessor captures only the stream it names, and the rest still reach the terminal.

fn announce(name):
    print(bold("\n▸ {name}"))

// What the machine is doing, sampled once and said out loud at the top of every run.
//
// Per-OS, so this is the shell's answer to hand over rather than the core's - the same as
// the log path and the screens. A load average means nothing without a core count beside
// it, and on Apple silicon the count that matters is the *performance* cores: past that
// many runnable threads the scheduler starts putting work on the efficiency cores, which
// run this kind of code at roughly half the speed. That is the line between a run that is
// merely slow and a run whose numbers lie, and it is where --perf refuses.
//
// Returns [cores, fast_cores, load1, load5, load15]. Nothing here can fail a run: a machine
// that will not answer yields zeros, and zero reads as "unknown" at every use. Refusing to
// build because a sysctl was missing would be absurd.
fn machine():
    stdout, stderr, code = quiet $`uname -s` catch:
        stdout = ""
    if stdout.trim() == "Darwin":
        stdout, stderr, code = quiet $`sysctl -n hw.ncpu` catch:
            stdout = ""
        cores = parse_int(stdout.trim()) catch:
            cores = 0

        // hw.perflevel0 is the performance half of an Apple silicon chip, and is absent on
        // Intel Macs - where there is one kind of core and hw.ncpu already counted it.
        stdout, stderr, code = quiet $`sysctl -n hw.perflevel0.logicalcpu` catch:
            stdout = ""
        fast = parse_int(stdout.trim()) catch:
            fast = cores

        stdout, stderr, code = quiet $`sysctl -n vm.loadavg` catch:
            stdout = ""
        loads = three_loads(stdout)
        return [cores, fast, loads[0], loads[1], loads[2]]

    stdout, stderr, code = quiet $`nproc` catch:
        stdout = ""
    cores = parse_int(stdout.trim()) catch:
        cores = 0
    stdout, stderr, code = quiet $`cat /proc/loadavg` catch:
        stdout = ""
    loads = three_loads(stdout)
    // Nothing here reports a performance/efficiency split, so every core counts as a fast one.
    return [cores, cores, loads[0], loads[1], loads[2]]

// The three averages out of a load-average line, whatever else is around them.
//
// One parser for two shapes rather than one per platform: macOS answers with the numbers
// between braces and /proc/loadavg follows them with a running/total count and a pid. Both
// are whitespace-separated, so taking the first three fields that parse as a number covers
// each without knowing which it is reading. A line neither of them recognises yields zeros,
// because a diagnostic that cannot read the machine should say nothing rather than stop it.
fn three_loads(text):
    found = []
    for field in text.split(" "):
        if len(found) < 3:
            // A load average is never negative, so this stands in for "not a number".
            value = parse_float(field.trim()) catch:
                value = -1.0
            if value >= 0:
                found = found + [value]
    while len(found) < 3:
        found = found + [0.0]
    return found

// The one line that would have turned seventy-four invisible minutes into something anybody
// could see (a_29iw10a58). On every run including narrowed ones, because a number raised only
// when it is bad is a number people learn to scroll past, and because the run it explains is
// usually the one nobody thought to question.
fn report_machine(cores, fast, load1, load5, load15):
    if cores == 0:
        print(dim("machine: this OS would not say how many cores it has or what its load is"))
        return
    counted = cores == fast ? "{cores} cores" : "{cores} cores ({fast} performance)"
    line = "machine: {counted}, load {load1:.2} {load5:.2} {load15:.2}"
    if load1 < fast:
        print(dim(line))
        return
    // Not dim, because at this point the run is sharing every fast core with something else
    // and how long it takes says nothing about the code.
    print(yellow("{line} - the fast cores are already committed, so this run will be slow"))

// What this repo's own tooling has left running, named rather than counted.
//
// Reports and never fails. A check that could stop a build is one people stop running, and
// this one exists to be run at the moment somebody is already suspicious.
fn run_doctor():
    doctor_processes()
    doctor_muster_daemons()
    doctor_herdr()
    doctor_devenv()

// Every muster-daemon on this machine, whoever started it, with the socket it serves.
//
// What each one holds is `muster daemons`' to say, from inside a window: it dials each socket
// with the daemon's own protocol, which a build script cannot speak. This half is the one the
// daemons' records cannot give - the ones nothing wrote down, a test's included.
fn doctor_muster_daemons():
    print(bold("\nmuster daemons"))
    stdout, stderr, code = quiet $`pgrep -a -x muster-daemon` catch:
        stdout = ""
    pids = stdout.trim().split_lines().filter(fn(pid) pid.trim() != "")
    if len(pids) == 0:
        print(dim("  none running"))
        return
    print(dim("  pid    age          socket"))
    for pid in pids:
        print("  {doctor_muster_daemon(pid.trim())}")
    print(dim("  What each holds: muster daemons, from a pane. End one with: kill $(lsof -t <socket>.lock)"))

fn doctor_muster_daemon(pid):
    stdout, stderr, code = quiet $`ps -o etime= -p {pid}` catch:
        stdout = ""
    age = stdout.trim()
    if age == "":
        blank = ""
        return "{pid:<7}{blank:<13}gone - it exited while this was being written"
    stdout, stderr, code = quiet $`lsof -a -p {pid} -U` catch:
        stdout = ""
    socket = ""
    for line in stdout.split_lines():
        fields = line.split(" ").filter(fn(field) field != "")
        if len(fields) > 0 and fields[-1].ends_with(".sock"):
            socket = fields[-1]
    if socket == "":
        return "{pid:<7}{age:<13}no socket - starting, handing over, or on its way out"
    if not get_path(socket).exists:
        return "{pid:<7}{age:<13}{socket}  unreachable, its socket path is gone"
    scratch = socket.starts_with("/tmp/") or socket.starts_with("/private/tmp/")
    where = scratch ? "scratch" : "kept"
    return "{pid:<7}{age:<13}{socket}  {where}"

// Load says the machine is busy; this says what is eating it.
//
// The two are different questions and a_29iw10a58 needed both answered: eight orphaned busy
// loops at 89% of a core each were invisible in a gate that only ever got slower, and half an
// hour is not obviously wrong for a run that builds two toolchains.
fn doctor_processes():
    print(bold("\nbusiest processes"))
    // Sorted with `sort` rather than with ps, because the flag that sorts by CPU is spelled
    // differently on macOS and Linux and the first column is the same number on both.
    stdout, stderr, code = quiet $`ps -Ao pcpu,etime,comm | sort -rn | head -5` catch:
        print(dim("  ps would not answer, so nothing here says what is running"))
        return
    print(dim("  %cpu   elapsed      command"))
    for line in stdout.split_lines():
        fields = line.split(" ").filter(fn(field) field != "")
        if len(fields) >= 3:
            // Reassembled rather than printed as ps laid it out: sorting strips the alignment
            // ps had, and a command name is a path or three words depending on the process.
            command = join(fields[2:], " ")
            print("  {fields[0]:<7}{fields[1]:<13}{command.truncate(76)}")

// The herdr daemons a Muster from before muster-daemon left on this machine.
//
// Built out of the OS rather than out of herdr's API, because the API cannot answer it. You can
// ask a socket what it holds and you can ask the OS which sockets a process has open, and there
// is no method that gets from one to the other - the schema has server.stop, reload_config,
// live_handoff and agent_manifests, and nothing that answers "which process are you"
// (a_28YghIUw2). So this walks pids to sockets and dials each socket back.
//
// The hazard is real and it is the reason this prints a cwd rather than a count: of twenty-odd
// daemons on this machine one held somebody's working agent, and it was neither the oldest nor
// the youngest. Sorting by age picks the wrong process.
// `pgrep -a`, and the flag is the whole of a_2I8fSrotB. Without it pgrep leaves out its own
// ancestors, and this command is run from a Muster pane - whose ancestry is launchd, the app's
// daemon, the pane's shell, rad, pgrep. So the one daemon holding live agents was the one
// process the census structurally could not report, every time somebody ran it where it is
// useful. Measured 2026-09-03: 8 pids without the flag, 9 with, and the extra one held every
// pane in the window the command was typed into.
fn doctor_herdr():
    print(bold("\nherdr daemons"))
    stdout, stderr, code = quiet $`pgrep -a -x herdr` catch:
        stdout = ""
    pids = stdout.trim().split_lines().filter(fn(pid) pid.trim() != "")
    if len(pids) == 0:
        print(dim("  none running"))
        return

    rows = [doctor_daemon(pid.trim()) for pid in pids]
    // Counted apart, because they are different things to somebody deciding what to end. A
    // daemon holds sessions; a bridge is one pane's connection to one, and ending it takes that
    // pane's picture away and nothing else. A count that added them up read as twenty daemons
    // on a machine that had two.
    bridges = rows.filter(fn(row) row[1])
    print("  {len(rows) - len(bridges)} daemon(s), {len(bridges)} pane bridge(s)")
    print(dim("  pid    age          socket"))
    for row in rows:
        print("  {row[0]}")
    print(dim("  A Muster from before its own daemon started these, and no window of this one shows"))
    print(dim("  their panes. End a daemon, and every pane it holds, with: kill $(lsof -t <socket>)"))

// One daemon: how old, which socket, and what is in its panes.
//
// `lsof -a` rather than `lsof`. Without -a, lsof ORs its selection options, so `lsof -p <pid> -U`
// returns every unix socket on the machine and each pid appears to hold whichever one is read
// first. Over twenty daemons that produces twenty identical rows, which reads as a finished
// inventory rather than as a broken one - measured, on this machine, on a_28YghIUw2.
// Answers a row and whether the process is a pane's bridge rather than a daemon.
fn doctor_daemon(pid):
    stdout, stderr, code = quiet $`ps -o etime=,args= -p {pid}` catch:
        stdout = ""
    fields = stdout.trim().split(" ").filter(fn(field) field != "")
    // ps knows nothing about it, so it exited between the census and this row. Said outright,
    // because the alternative row is "no API socket", which reads as a stray somebody should
    // look at.
    if len(fields) == 0:
        blank = ""
        return ["{pid:<7}{blank:<13}gone - it exited while this was being written", false]
    age = fields[0]
    argv = len(fields) > 1 ? join(fields[1:], " ") : ""

    // Named for what it is rather than for what it lacks. Most herdr processes on a machine
    // running Muster are these - one per open pane - and each used to draw a row saying "no API
    // socket, a client rather than a daemon", which is true and leaves the reader to work out
    // that it is a pane's connection and not a stray. Which pane, because that is what makes it
    // safe to leave alone.
    if "terminal session" in argv:
        return ["{pid:<7}{age:<13}a bridge for pane {doctor_bridged_pane(argv)}", true]

    stdout, stderr, code = quiet $`lsof -a -p {pid} -U` catch:
        stdout = ""
    socket = ""
    for line in stdout.split_lines():
        fields = line.split(" ").filter(fn(field) field != "")
        if len(fields) > 0 and fields[-1].ends_with("/herdr.sock"):
            socket = fields[-1]

    if socket == "":
        // A herdr that is neither serving nor bridging. Worth a row rather than a silent
        // omission: it is still a process somebody may be about to kill.
        return ["{pid:<7}{age:<13}no API socket, and not a pane's bridge either", false]

    // A daemon still bound to a socket whose path has been deleted is one nothing can reach
    // any more, which is a different fact from one that declined to answer - and it is the
    // one that says ending this process costs nobody anything.
    if not get_path(socket).exists:
        return ["{pid:<7}{age:<13}{socket}  unreachable, its socket path is gone", false]

    scratch = socket.starts_with("/tmp/") or socket.starts_with("/private/tmp/")
    where = scratch ? "scratch" : "kept"
    return ["{pid:<7}{age:<13}{socket}  {where}", false]

// The pane a bridge is painting, out of the command line that started it.
//
// `herdr terminal session control w6:p30 --cols 93 --rows 34`, so the word after the mode. Read
// positionally because there is no flag naming it, and answered as a question mark rather than
// guessed at when the shape is not that: a wrong pane name is worse than none, since the whole
// use of this row is deciding whether the process belongs to something you are looking at.
fn doctor_bridged_pane(argv):
    words = argv.split(" ").filter(fn(word) word != "")
    take_next = false
    for word in words:
        if take_next:
            return word
        take_next = word == "control" or word == "observe"
    return "?"

// The container the remote tier leaves up, named here because nothing else names it.
fn doctor_devenv():
    print(bold("\ndevenv container"))
    stdout, stderr, code = quiet $`docker ps --filter 'name=^muster-devenv$'` catch:
        print(dim("  docker is not answering, so nothing this repo starts in it is up"))
        return
    rows = stdout.trim().split_lines()
    if len(rows) < 2:
        print(dim("  not running"))
        return
    for row in rows:
        print("  {row.trim()}")
    print(dim("  ./dev --ssh leaves this up deliberately - a devenv is a thing you keep. Stop it"))
    print(dim("  with: ./devenv/devenv down"))

fn fail_empty_suite(language, cure):
    print_err(red("No {language} tests were discovered."))
    print_err("An empty suite passes, so this is a failure rather than a green run.")
    print_err(cure)
    exit(1)

// What the default gate is expected to skip, and what runs it instead.
//
// A suite that stops running is invisible in a count, which makes it worse than a red one:
// `swift test` reports the same total whether a GUI suite is there and skipping or has been
// deleted, and cargo keeps its ignored tests in a per-binary line nothing reads. So the whole
// of what once said such a suite still existed was one hand-written print - a second
// such suite needed a second line, and the day somebody wrote neither, a suite would stop
// running behind a green gate.
//
// Counted rather than listed test by test, because a count is what moves in both directions
// that matter: a suite deleted takes its skips with it, and an `#[ignore]` on a test that
// should be running adds one. The check prints the names it actually found when the number
// disagrees, so what moved is on screen rather than in somebody's head.
//
// The two languages are asked differently because they answer differently. cargo will say what
// it is going to skip before it runs, so Rust is asked up front. swift will not - its list and
// its run both report 319 whether or not a suite skipped itself, which is the observation this
// card was raised on - so Swift is asked twice instead: discovery says the suite still exists,
// and the run's own skip records say it actually skipped.
// The doctest row is the check earning its place on the day it was written: it was drafted
// from a count of `#[ignore]` in the tree, and the runner answered with one more than that.
// A ```ignore example is skipped too, and no grep of the source would have said so.
SKIPPED_SUITES = [
    { "language": "Rust", "suite": "muster-ssh's devenv tests", "skipped": 7,
      "note": "need the devenv container; ./dev --ssh runs them" },
    { "language": "Rust", "suite": "muster-daemon-client's devenv test", "skipped": 1,
      "note": "needs the devenv container; ./dev --ssh runs it" },
    { "language": "Rust", "suite": "muster-daemon's ssh and sudo devenv tests", "skipped": 2,
      "note": "need the devenv container; ./dev --ssh runs them" },
    { "language": "Rust", "suite": "muster-seam's remote handover", "skipped": 1,
      "note": "needs the devenv container; ./dev --ssh runs it" },
    { "language": "Rust", "suite": "fresh_session's doc example", "skipped": 1,
      "note": "an illustration in a doc comment rather than a test, so nothing runs it" },
    { "language": "Rust", "suite": "muster-daemon's echo latency", "skipped": 1,
      "note": "a measurement, not a property; cargo test --release -p muster-daemon --test daemon -- flood::echo_latency --ignored --nocapture prints it" },
    { "language": "Rust", "suite": "muster-daemon's live Claude Code checks", "skipped": 5,
      "note": "reach the network and spend model turns; ./dev --claude-code runs them" },
    { "language": "Rust", "suite": "muster-contract's launch checks", "skipped": 10,
      "note": "need a logged-in session; ./dev --contract runs them" },
    { "language": "Swift", "suite": "SurfaceGUITests", "skipped": 4,
      "note": "need a logged-in session; ./dev --contract runs them" },
]

// How many tests this language's entries in the manifest account for.
fn expected_skips(language):
    total = 0
    for row in SKIPPED_SUITES:
        if row.language == language:
            total = total + row.skipped
    return total

// Holds the manifest to what the run actually left out.
//
// `found` is the names when the runner will give them and an empty list when it will only give
// a number, which is the difference between the two languages here rather than a preference.
fn check_skipped(language, skipped, found, cure):
    expected = expected_skips(language)
    if skipped == expected:
        for row in SKIPPED_SUITES:
            if row.language == language:
                print(dim("skipped: {row.suite} - {row.note}"))
        return
    print_err(red("The {language} suite left out {skipped} test(s); ./dev's manifest expects {expected}."))
    print_err("One of the two is wrong, and until it is settled the gate is reporting on a")
    print_err("suite whose size it cannot account for - which is the shape a suite that")
    print_err("silently stopped running has.")
    if len(found) > 0:
        print_err("What it actually left out:")
        for name in found:
            print_err("  {name}")
    print_err(cure)
    exit(1)

// Exit 2 means the run could not judge itself - no baseline, no corpus - and exit 1 means
// it judged and the answer was no. Collapsing the two would send someone hunting a
// regression that never happened.
fn fail_perf(stdout, stderr, code):
    print(stdout.trim())
    if code == 2:
        print_err(red("The perf run could not judge itself, so nothing was verified."))
        print_err(stderr.trim())
        exit(1)
    print_err(red("A per-unit budget regressed, or a benchmark stopped running."))
    print_err(stderr.trim())
    print_err("Either something on a hot path got slower, or the machine is busy - the")
    print_err("median column says which. If the cost is deliberate and acceptable:")
    print_err("  ./dev --perf --record")
    exit(1)

// The remote tier: a real ssh master to a real machine that starts out with nothing on it.
//
// Out of the gate because it needs docker and a container, which is the same line the
// contract tier sits on - not because it is slow or flaky (docs/testing.md, tiered by what
// a tier can reach). The container is the devenv, so what gets tested and what gets
// developed against are one artifact.
//
// The container carries no daemon, which is what a person setting one up actually has, and
// the tests install this build's the way the app does.
fn run_ssh_tier():
    // Recreated rather than reused, and that is the point rather than tidiness: the fixture
    // these tests need is a machine with no daemon on it, and a container left from an earlier
    // run has the one those tests installed.
    $`./devenv/devenv down`
    $`./devenv/devenv up` catch:
        print_err(red("The devenv container would not start, so the remote tier ran nothing."))
        print_err("Impact: 'local and remote in one window' is unverified by this run.")
        print_err("Check that docker is running, then: ./devenv/devenv up")
        exit(1)

    // Absolute, because cargo runs an integration test from its own package root and a
    // repo-relative key silently becomes 'no such file' and then 'permission denied'.
    root = $`pwd`.stdout.trim()
    key = "{root}/devenv/.ssh/id_ed25519"
    // The container is a local fixture on a port nobody else uses, and its key changes every
    // time it is rebuilt, so pinning its host key would mean editing a file per rebuild.
    options = "-p 2222 -i {key} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"

    // Spelled out at both call sites rather than built into a variable first: Rad quotes an
    // interpolated value as one shell word, so a variable holding the whole prefix arrives as
    // a command name nothing can run.
    //
    // muster-contract is left out because its ignored tests are the contract tier's: they
    // launch the app, and need a GUI session rather than a container.
    stdout = $`MUSTER_DEVENV_HOST=dev@localhost MUSTER_DEVENV_SSH_OPTIONS={options} cargo test --workspace --exclude muster-contract -- --ignored --list`
    names = stdout.split("\n").filter(fn(line) line.ends_with(": test"))
    if len(names) == 0:
        print_err(red("The remote tier discovered no tests."))
        print_err("An empty tier passes, so this is a failure rather than a green run.")
        print_err("Check that the #[ignore] tests in crates/muster-ssh/tests/ssh/,")
        print_err("crates/muster-daemon-client/tests/daemon_client/devenv.rs and")
        print_err("crates/muster-daemon/tests/daemon/devenv_terminfo.rs still exist.")
        exit(1)
    print(dim("{len(names)} remote test(s) discovered"))

    $`MUSTER_DEVENV_HOST=dev@localhost MUSTER_DEVENV_SSH_OPTIONS={options} cargo test --workspace --exclude muster-contract -- --ignored`

    // Said here because this is where it matters and nothing else says it. The container is
    // left up deliberately - a devenv is a thing you keep - but it goes on costing the machine
    // after the tier that started it has finished, and the tier most likely to run next is the
    // one that cannot survive it: a_28UsunMWa measured frame.decode at 1.67 ns/byte with this
    // container up against 1.44 with it stopped, both against a 0.83 baseline. Somebody running
    // the out-of-gate tiers in sequence gets a perf failure that nothing in the code caused.
    print(dim("\nThe devenv container is still up on port 2222, deliberately - a devenv is a"))
    print(dim("thing you keep. It costs this machine something while it runs, and ./dev --perf"))
    print(dim("reads slow against its baseline until it stops. Stop it with:"))
    print(dim("  ./devenv/devenv down"))

// The daemon's and detection's own suites, run on Linux rather than only compiled for it.
//
// cargo builds each test for the target and hands it to tools/linux-run/run, which runs it in a
// Debian container with this checkout mounted at its own path. Both architectures: the one
// docker runs natively first and in full, then the other under emulation, without the three
// tests whose subject emulation replaces - two timing budgets, which would time the emulator, and
// the live process probe, which reads the emulator's argv (qemu-x86_64 /usr/bin/sleep ...) where
// Linux would give the program's. The native run holds the daemon to all three.
EMULATED_TIMING = "a_spawned_daemon_answers_its_first_request_within_budget"
EMULATED_WRITE_BUDGET = "a_write_that_never_finishes_holds_up_no_request"
EMULATED_ARGV = "the_system_reports_a_real_process_group"
// The emulated run takes three test threads rather than one per CPU docker's VM has. The
// daemon's tests share one binary, so its default runs five at a time, and under emulation on
// a busy Mac a restore of many panes then outlasted the suite's patience: at the default it
// failed twice in three runs, both with the machine's load past 40, and took 113 s on a quiet
// one; at three it passed at load 156 and at load 15 alike, in 153 s both times.
EMULATED_THREADS = 3

fn run_linux_tier():
    stdout, stderr, code = quiet $`docker info --format '\{\{.Architecture\}\}'` catch:
        print_err(red("docker is not answering, so the Linux tier ran nothing."))
        print_err("Impact: the daemon and detection are unverified on Linux by this run.")
        print_err("Start Docker Desktop (open -a Docker), then run ./dev --linux again.")
        exit(1)
    native = stdout.trim() == "x86_64" ? "x86_64-unknown-linux-musl" : "aarch64-unknown-linux-musl"
    emulated = LINUX_DAEMONS.keys().filter(fn(target) target != native)
    for target in [native] + emulated:
        listed = $`cargo test -p muster-daemon -p muster-detect -p muster-msg --target {target} -- --list`
        names = listed.split("\n").filter(fn(line) line.ends_with(": test"))
        if len(names) == 0:
            fail_empty_suite("Linux ({target})", "Check that crates/muster-daemon/tests/ and crates/muster-detect/tests/ still exist.")
        if target == native:
            print(dim("{len(names)} test(s) on {target}, natively"))
            $`cargo test -p muster-daemon -p muster-detect -p muster-msg --target {target} --no-fail-fast`
        else:
            print(dim("{len(names)} test(s) on {target}, emulated, {EMULATED_THREADS} at a time, less {EMULATED_TIMING}, {EMULATED_WRITE_BUDGET} and {EMULATED_ARGV}"))
            $`cargo test -p muster-daemon -p muster-detect -p muster-msg --target {target} --no-fail-fast -- --test-threads {EMULATED_THREADS} --skip {EMULATED_TIMING} --skip {EMULATED_WRITE_BUDGET} --skip {EMULATED_ARGV}`

// The app finds its helpers beside its own executable - right for a shipped bundle, and
// wrong for two build systems with two output directories and a downloaded daemon. Rather
// than teach the app where cargo puts things, the build puts them where the app already
// looks. The awkwardness stays here instead of in the code that has cost the most time
// when it was wrong.
//
// The daemon is one of them: the app starts its own rather than asking somebody to, so a
// build that produced no daemon would produce an app that opens an empty window.
fn stage_helpers(profile):
    swift_bin = $`swift build -c {profile} --show-bin-path`.stdout.trim()
    stage(target = "target/{profile}/muster-bridge", into = "{swift_bin}/muster-bridge")
    // The CLI, staged under a different name than cargo built it under: the app's own executable
    // is already `muster`, and the two would collide in one directory. The app puts a link called
    // `muster` in ~/.muster/bin pointing here, which is what a pane finds on its PATH.
    stage(target = "target/{profile}/muster", into = "{swift_bin}/muster-cli")
    // The daemon, and the data it hands every shell, where the app looks for them: beside the
    // bridge, as they sit in a bundle.
    stage(target = "target/{profile}/muster-daemon", into = "{swift_bin}/muster-daemon")
    $`rsync -a --delete {DAEMON_DATA}/ {swift_bin}/muster-daemon-data/`
    // The daemons a remote install sends (MIP-3, section 12), laid out as DaemonLocation.swift
    // and muster-daemon-client's `install` expect them: one directory per Linux build.
    for target in LINUX_DAEMONS.keys():
        carried = "{swift_bin}/daemons/{carried_name(target)}"
        $`mkdir -p {carried}`
        stage(target = "target/{target}/{profile}/muster-daemon", into = "{carried}/muster-daemon")
        stage(target = "target/{target}/{profile}/muster", into = "{carried}/muster")

// What the app calls a Linux build it carries: `linux-x86_64` for x86_64-unknown-linux-musl.
fn carried_name(target):
    return "linux-{target.split("-")[0]}"

// Copies a binary into place without disturbing anyone running the old one.
//
// Via a temporary name and a rename, because a plain `cp` writes through the file the
// running process has mapped: macOS invalidates its pages, SIGKILLs it, and then SIGKILLs
// every later exec of the path until the signature is re-validated. That is not theoretical
// here - the app starts a daemon from this directory and the whole point of it is to outlive
// the app, so a rebuild would otherwise kill the agents somebody is running. A rename swaps
// the directory entry and leaves the old inode alone.
fn stage(target, into):
    $`cp {target} {into}.staging && mv -f {into}.staging {into}`

// Assembles the built binary into something the platform can launch.
//
// SwiftPM has no bundle product, so this is hand-rolled, and it is out of the gate because
// nothing in the gate needs one. What it buys is everything a bare binary in .build cannot
// be: a Dock icon, a double-click, `open -a`, and the launchd descriptor ceiling that only
// a GUI-launched process ever meets (DescriptorLimit.swift).
//
// Signing and notarization are a separate question and belong with going public. This is
// about launching it like an app on the machine that built it.
fn build_bundle():
    swift_bin = $`swift build -c release --show-bin-path`.stdout.trim()
    contents = "{BUNDLE}/Contents"

    // Assembled from nothing every time. A bundle that accumulated across builds could
    // carry a stale dylib beside a fresh binary, which fails at launch with a dyld error
    // naming a symbol rather than the build that produced it.
    $`rm -rf {BUNDLE}`
    $`mkdir -p {contents}/MacOS {contents}/Frameworks {contents}/Resources`

    // Helpers in MacOS/ rather than Resources/, because PaneCommand.bridge resolves them
    // beside the running executable and one rule has to cover the dev build and the bundle.
    $`cp {swift_bin}/muster {contents}/MacOS/muster`
    $`cp {swift_bin}/muster-bridge {contents}/MacOS/muster-bridge`
    $`cp {swift_bin}/muster-cli {contents}/MacOS/muster-cli`
    $`cp target/release/libmuster.dylib {contents}/Frameworks/libmuster.dylib`
    $`cp {GHOSTTY_DIR}/zig-out/lib/libghostty-vt.dylib {contents}/Frameworks/libghostty-vt.dylib`
    // Resources rather than Library, because a Linux ELF is not code to codesign: it is sealed
    // as a resource like the icon, and is only ever run on another machine.
    $`rsync -a --copy-links {swift_bin}/daemons/ {contents}/Resources/daemons/`

    // muster-daemon's agent detection is a port of herdr's, and Apache-2.0 asks that its terms
    // travel with the binary. The copy is checked in rather than downloaded so that assembling
    // a bundle stays offline and so the text cannot silently stop matching what ships.
    $`cp licenses/herdr/LICENSE {contents}/Resources/LICENSE-herdr.txt`
    $`cp NOTICE {contents}/Resources/NOTICE.txt`
    // The Rust crates and swift-protobuf are linked into the binaries above rather than
    // copied beside them, so nothing else in this directory tells you they are here. The
    // second file is the same problem one layer down: libghostty is MIT, and the archive it
    // links in carries ten other projects' object code with it, measured rather than assumed.
    $`cp {THIRD_PARTY} {contents}/Resources/THIRD-PARTY.md`
    $`cp {GHOSTTY_LICENSES} {contents}/Resources/GHOSTTY-EMBEDDED.md`

    // Rendered from packaging/icon.svg and committed, so a bundle needs no image toolchain.
    // tools/make-icns.sh is what regenerates it.
    $`cp {ICNS} {contents}/Resources/Muster.icns`

    write_info_plist(contents)
    write_daemon_bundle(contents, swift_bin)

    // The rpaths compiled in are loader-relative to target/release and to the ghostty
    // checkout (Package.swift, .cargo/config.toml), and neither exists inside a bundle. So
    // each binary that loads a dylib learns where the bundle keeps them instead, and all are
    // re-signed afterwards: editing a Mach-O invalidates its signature, and macOS refuses to
    // launch the result. The daemon reaches the app's Frameworks from inside its helper bundle
    // rather than carrying a second copy of libghostty-vt.
    daemon = "{contents}/Library/{DAEMON_BUNDLE}/Contents/MacOS/muster-daemon"
    rpaths = [
        ["{contents}/MacOS/muster", "@executable_path/../Frameworks"],
        ["{contents}/Frameworks/libmuster.dylib", "@loader_path"],
        [daemon, "@executable_path/../../../../Frameworks"],
    ]
    for pair in rpaths:
        drop_checkout_rpaths(pair[0])
        $`install_name_tool -add_rpath {pair[1]} {pair[0]}`

    // Before signing, which touches most of the same paths and would otherwise report a missing
    // daemon as a codesign error naming a file - true, and several steps away from what to do
    // about it.
    check_bundle_is_whole(contents)
    sign_bundle(swift_bin, contents)

    // Run once, because a file being in place says nothing about whether it loads: a daemon
    // that cannot find libghostty-vt is present, signed and dead at launch, and a window
    // shows that only as panes that never render. With the checkout's rpaths gone, this is
    // the bundle's own copy loading, even on the machine that built it.
    quiet $`{daemon} --version` catch:
        print_err(red("The bundled muster-daemon does not start."))
        print_err("Impact: every pane in this bundle's window stays blank.")
        print_err("Check: run {daemon} --version and read what dyld says it could not load;")
        print_err("the rpaths build_bundle adds are the usual cause.")
        exit(1)
    print("assembled {BUNDLE} - open it, or drag it to the Dock")

// Deletes the rpaths that point into this checkout, so a bundled binary loads only what the
// bundle carries. Left in, the binary would load from target/ or the ghostty checkout on the
// machine that built it, and a bundle missing a dylib would pass every check here and fail on
// anybody else's.
fn drop_checkout_rpaths(binary):
    listing, _, _ = quiet $`otool -l {binary}`
    for line in listing.split("\n"):
        text = line.trim()
        if not text.starts_with("path "):
            continue
        path = text[5:].split(" (offset")[0]
        if "target/" in path or "deps/ghostty" in path:
            $`install_name_tool -delete_rpath {path} {binary}`

// Everything a launched bundle has to be able to reach, checked at the moment it is assembled.
//
// **This would not have caught `1d7ace3`, and saying so is the point.** That commit moved the
// daemon into the helper bundle and dropped the copy that had been going into `Contents/MacOS/`,
// and the bundle it produced was correct - what was wrong was the bridge, which went on looking
// beside itself. A layout check cannot see that. `./dev --contract` launches an assembled bundle
// now, and that is the check that would have (kan a_2Hnh3g0Y5).
//
// What this guards is the failure mode `1d7ace3` demonstrated is possible: a copy quietly leaving
// `build_bundle`. Every path below was written a few lines above, so nothing here fails while the
// script is intact - it fails when somebody deletes a line, which is what happened. Signing
// catches the daemon's absence today as a side effect of signing that exact path; this says the
// requirement outright, so a signing change cannot take the guard with it.
fn check_bundle_is_whole(contents):
    daemon = "{contents}/Library/{DAEMON_BUNDLE}/Contents/MacOS/muster-daemon"
    required = [
        // The app, the CLI a pane finds on its PATH, and the bridge every pane's frames arrive
        // through. PaneCommand.bridge resolves the last two beside the running executable.
        "{contents}/MacOS/muster",
        "{contents}/MacOS/muster-bridge",
        "{contents}/MacOS/muster-cli",
        // The daemon and what it gives every shell, where DaemonLocation.swift looks for them.
        // A bundle without the daemon opens a window in which no pane renders.
        daemon,
        "{contents}/Library/{DAEMON_BUNDLE}/Contents/Resources/muster-daemon-data/README.md",
        // What a remote install sends a Linux machine. Without them a devenv with no daemon
        // on it shows no panes, and says the app carries none.
        "{contents}/Resources/daemons/linux-x86_64/muster-daemon",
        "{contents}/Resources/daemons/linux-aarch64/muster-daemon",
        // And the CLI the same install puts on that machine, without which an agent there has
        // no `muster msg` to message anyone with.
        "{contents}/Resources/daemons/linux-x86_64/muster",
        "{contents}/Resources/daemons/linux-aarch64/muster",
        "{contents}/Frameworks/libmuster.dylib",
        "{contents}/Frameworks/libghostty-vt.dylib",
        "{contents}/Info.plist",
        "{contents}/Library/{DAEMON_BUNDLE}/Contents/Info.plist",
    ]
    missing = required.filter(fn(path) not get_path(path).exists)
    if len(missing) > 0:
        print_err(red("The assembled bundle is missing {len(missing)} file(s) it needs to run."))
        for path in missing:
            print_err("  {path}")
        print_err("Impact: a launched Muster fails at whatever needs the missing file, and a")
        print_err("missing daemon in particular opens a window where every pane renders nothing")
        print_err("and says only that muster-daemon could not be started.")
        print_err("Usual cause: a step in build_bundle stopped copying something, or a path in")
        print_err("it moved without the rule in Sources/MusterMac that resolves it moving too.")
        exit(1)

// The daemon, as a bundle Launch Services can start.
//
// muster-daemon is a plain command-line binary and this makes an application out of it, which
// sounds like a costume and is the whole mechanism. macOS decides who to charge a pane's
// protected request to when that pane is spawned: a spawned child inherits its spawner's
// answer, and only a process Launch Services started is its own. Spawned, the daemon is charged
// to Muster until Muster exits and then to nothing that can be named; opened, it is charged to
// this bundle for as long as it lives, and every pane it ever makes with it.
//
// The id is the one it has always had, so the grants people gave it stay attached to what they
// are charged to.
//
// The Info.plist below carries the same usage descriptions the app's does. macOS reads a
// usage string from the *responsible* process's bundle, and once the daemon is opened rather
// than spawned that is this one - a missing string is not a worse prompt but a kill.
//
// Its data sits in Resources rather than beside the executable, because a code signature
// treats everything in MacOS/ as code; the app tells the daemon where it is.
//
// LSUIElement rather than LSBackgroundOnly. Both keep it out of the Dock and the app switcher;
// the difference is that a UIElement application may put something on screen, and a permission
// prompt is something on screen. A background-only daemon that could never present one would
// turn every un-granted permission into a silent denial, which is the failure this whole card
// is about.
//
// NSAppSleepDisabled, because an application with no window of its own is what App Nap exists
// to slow down, and it would coalesce the daemon's timers and lower its priority while somebody
// types into one of its panes.
fn write_daemon_bundle(contents, swift_bin):
    bundle = "{contents}/Library/{DAEMON_BUNDLE}"
    $`mkdir -p {bundle}/Contents/MacOS {bundle}/Contents/Resources`
    $`cp {swift_bin}/muster-daemon {bundle}/Contents/MacOS/muster-daemon`
    $`rsync -a {DAEMON_DATA}/ {bundle}/Contents/Resources/muster-daemon-data/`
    version = workspace_version()
    plist = """
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>CFBundleName</key><string>{DAEMON_BUNDLE_NAME}</string>
      <key>CFBundleDisplayName</key><string>{DAEMON_BUNDLE_NAME}</string>
      <key>CFBundleExecutable</key><string>muster-daemon</string>
      <key>CFBundleIdentifier</key><string>{DAEMON_BUNDLE_ID}</string>
      <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
      <key>CFBundlePackageType</key><string>APPL</string>
      <key>CFBundleShortVersionString</key><string>{version}</string>
      <key>CFBundleVersion</key><string>{version}</string>
      <key>LSMinimumSystemVersion</key><string>14.0</string>
      <key>LSUIElement</key><true/>
      <key>NSAppSleepDisabled</key><true/>
      <key>NSSupportsAutomaticTermination</key><false/>
      <key>NSSupportsSuddenTermination</key><false/>
    {usage_descriptions()}
    </dict>
    </plist>
    """
    write_file("{bundle}/Contents/Info.plist", plist)

// What Launch Services reads before anything of Muster's runs.
//
// The identifier is the app's identity to the OS, so it is what a notification permission
// grant attaches to (a_28Q5b3oPA). Changing it later means every user re-grants.
//
// Sudden termination is refused because the app owns a bridge process per pane. The daemon
// owns the PTYs and survives regardless, but a process killed without notice leaves its
// bridges to be reaped rather than shut down, and the run log ends mid-sentence.
fn write_info_plist(contents):
    version = workspace_version()
    plist = """
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>CFBundleName</key><string>Muster</string>
      <key>CFBundleDisplayName</key><string>Muster</string>
      <key>CFBundleExecutable</key><string>muster</string>
      <key>CFBundleIconFile</key><string>Muster</string>
      <key>CFBundleIdentifier</key><string>{BUNDLE_ID}</string>
      <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
      <key>CFBundlePackageType</key><string>APPL</string>
      <key>CFBundleShortVersionString</key><string>{version}</string>
      <key>CFBundleVersion</key><string>{version}</string>
      <key>LSMinimumSystemVersion</key><string>14.0</string>
      <key>NSHighResolutionCapable</key><true/>
      <key>NSSupportsAutomaticTermination</key><false/>
      <key>NSSupportsSuddenTermination</key><false/>
    {usage_descriptions()}
    </dict>
    </plist>
    """
    write_file("{contents}/Info.plist", plist)

// Why macOS is asking, in the one place a person ever sees it.
//
// macOS charges a protected request to the responsible process. For anything inside a pane
// that is Muster Sessions, the helper app running the daemon, in a bundle, and Muster itself
// for a daemon a SwiftPM build spawns - measured, and the whole table is in
// docs/observations/macos-26.4.1.md. So the prompt names one of the two while the request
// came from an agent, and the only place that can be explained is here. Left unset, the prompt says nothing at all about why, and a prompt
// somebody cannot judge is a prompt they refuse.
//
// One voice for all of them, and it names the pane rather than the app: Muster is what macOS
// charges but never what is asking, and a prompt reading as though the terminal itself wanted
// your Contacts is worse than a blank one.
//
// The list is long because a missing string is not a worse prompt - it is a kill. macOS
// terminates a process that requests a protected service when the responsible app declares
// none, so without the AppleEvents line an agent that runs `osascript` dies rather than asking.
// Muster runs whatever agents somebody already runs and cannot know which of these they reach
// for, which is the same reason Ghostty carries the same set.
fn usage_descriptions():
    asks = {
        // The four the report named, plus the volumes that fail the same way.
        "NSDesktopFolderUsageDescription": "read and write files on your Desktop.",
        "NSDocumentsFolderUsageDescription": "read and write files in your Documents folder.",
        "NSDownloadsFolderUsageDescription": "read and write files in your Downloads folder.",
        "NSNetworkVolumesUsageDescription": "read and write files on network volumes.",
        "NSRemovableVolumesUsageDescription": "read and write files on removable volumes.",
        // Everything else macOS lets an app word. An agent reaches for scripting and for
        // elevated privileges often, and for the rest rarely - but rarely is not never, and
        // the cost of omitting one is the pane's program dying with no prompt and no reason.
        "NSAppleEventsUsageDescription": "control another application with AppleScript.",
        "NSSystemAdministrationUsageDescription": "make a change that needs elevated privileges.",
        "NSLocalNetworkUsageDescription": "reach devices on your local network.",
        "NSCameraUsageDescription": "use the camera.",
        "NSMicrophoneUsageDescription": "use the microphone.",
        "NSAudioCaptureUsageDescription": "record this machine's audio.",
        "NSSpeechRecognitionUsageDescription": "use speech recognition.",
        "NSContactsUsageDescription": "read your Contacts.",
        "NSCalendarsUsageDescription": "read or change your Calendar.",
        "NSRemindersUsageDescription": "read or change your Reminders.",
        "NSPhotoLibraryUsageDescription": "read your Photo Library.",
        "NSBluetoothAlwaysUsageDescription": "use Bluetooth.",
        "NSLocationUsageDescription": "read your location.",
        "NSMotionUsageDescription": "read motion data.",
    }
    // Two spaces, because the block this lands in is dedented by the four in front of its
    // closing quotes and every sibling key sits at two.
    lines = ["  <key>{key}</key><string>A program running in a Muster pane wants to {what}</string>" for key, what in asks]
    return join(lines, "\n")

// One version, read from where the workspace already declares it.
//
// sed rather than awk because a `{}` in a command is Rad interpolation, and an awk program
// is mostly braces.
fn workspace_version():
    version = $`sed -n '/^\[workspace\.package\]/,$ s/^version *= *"\(.*\)"/\1/p' Cargo.toml | head -1`.stdout.trim()
    if version == "":
        print_err(red("Cargo.toml's [workspace.package] has no version, so the bundle has none."))
        print_err("Impact: Launch Services shows the app as unversioned and an upgrade cannot")
        print_err("be told from a downgrade. Restore the version key.")
        exit(1)
    return version

// Inner code first, and with whose name on it depending on where this build is going.
//
// MUSTER_SIGN_IDENTITY unset is the local build and the default, and it is unchanged: ad-hoc,
// which is not a security measure - it asserts nothing about who built this. It is what macOS
// requires before it will run a Mach-O at all, and everything here has just been edited or
// copied out from under its old signature.
//
// Set, it names a Developer ID and this is a build somebody else will run. Beyond Gatekeeper
// that buys a thing worth having: an ad-hoc signature is keyed by cdhash, so every rebuild is
// a new identity to TCC and a permission somebody granted silently stops applying - measured,
// docs/observations/macos-26.4.1.md. A Developer ID is keyed by team and bundle id, so a grant
// survives an upgrade.
//
// The override is an environment variable rather than a flag: a signing identity is a value
// and every flag here is a bool, and the run says which it used.
fn sign_bundle(swift_bin, contents):
    identity = get_env("MUSTER_SIGN_IDENTITY")
    if identity == "":
        sign_ad_hoc(swift_bin)
        return

    print(dim("signing with {identity}"))
    // --options runtime everywhere, because notarization refuses a bundle in which any nested
    // executable lacks the hardened runtime - and --timestamp because a signature without one
    // stops verifying the day the certificate expires rather than outliving it.
    inner = [
        "{contents}/Frameworks/libghostty-vt.dylib",
        "{contents}/Frameworks/libmuster.dylib",
        "{contents}/MacOS/muster-bridge",
        "{contents}/MacOS/muster-cli",
    ]
    for path in inner:
        $`codesign -f -s {identity} --options runtime --timestamp {path}`

    // Inside out, because a signature covers everything beneath it: signing the daemon's
    // bundle after the app's would invalidate the app's, and codesign will not tell you - the
    // failure arrives as Gatekeeper refusing the download on somebody else's machine.
    //
    // The same entitlements as the app, and for the reason the file itself gives: a pane that
    // runs `osascript` needs the responsible process to hold the Apple events entitlement, and
    // in a bundle the responsible process is this daemon rather than Muster.
    daemon = "{contents}/Library/{DAEMON_BUNDLE}"
    $`codesign -f -s {identity} --options runtime --timestamp {daemon}/Contents/MacOS/muster-daemon`
    $`codesign -f -s {identity} --options runtime --timestamp --entitlements {ENTITLEMENTS} {daemon}`

    $`codesign -f -s {identity} --options runtime --timestamp --entitlements {ENTITLEMENTS} {BUNDLE}`

    // Asked of the signature rather than assumed of the commands, because every failure mode
    // here is one that produces a bundle that launches on this machine and nowhere else.
    $`codesign --verify --deep --strict --verbose=2 {BUNDLE}`

fn sign_ad_hoc(swift_bin):
    contents = "{BUNDLE}/Contents"
    $`codesign -f -s - {contents}/Frameworks/libghostty-vt.dylib`
    $`codesign -f -s - {contents}/Frameworks/libmuster.dylib`
    $`codesign -f -s - {contents}/MacOS/muster-bridge`
    $`codesign -f -s - {contents}/MacOS/muster-cli`
    // Inside out, for the reason the release path gives: a signature covers everything beneath
    // it, so the daemon's bundle has to be settled before the app's is taken.
    daemon = "{contents}/Library/{DAEMON_BUNDLE}"
    $`codesign -f -s - {daemon}/Contents/MacOS/muster-daemon`
    $`codesign -f -s - {daemon}`

    // The entitlement SwiftPM signs a debug build with: it is what lets a debugger attach,
    // and re-signing without it would make the bundle the one build nobody can debug. It is
    // also why the release path above cannot simply reuse this one - get-task-allow and the
    // hardened runtime are the two halves of a contradiction, and notarization refuses it.
    entitlements = "{swift_bin}/muster-entitlement.plist"
    if get_path(entitlements).exists:
        $`codesign -f -s - --entitlements {entitlements} {BUNDLE}`
    else:
        $`codesign -f -s - {BUNDLE}`

// Sends the signed bundle to Apple, waits for the answer, and staples it.
//
// Stapling is the half people forget and the half that matters on the machine that
// downloads it: notarization alone means Gatekeeper has to ask Apple at first launch, so a
// laptop with no network shows the dialog that says the app is damaged. A stapled ticket
// travels inside the bundle and needs nobody.
//
// Zipped twice on purpose. The first archive is only transport - the ticket is stapled into
// the .app and not into the archive that carried it there - so the one that gets published
// has to be built afterwards, from the stapled bundle.
//
// Several of the details below are taken from ~/src/bep's release script rather than worked
// out here, and are marked where they are not obvious.
fn notarize_bundle():
    // The cask this feeds declares `depends_on arch: :arm64`, so producing the artifact
    // anywhere else would ship an x86_64 build under an arm64 name to people whose machines
    // cannot run it - and nothing downstream would notice.
    machine = $`uname -m`.stdout.trim()
    if machine != "arm64":
        print_err(red("A release is built on Apple Silicon, and this machine is {machine}."))
        print_err("Impact: the artifact would be x86_64 while the cask promises arm64, so brew")
        print_err("would install an app that cannot launch. Build the release on an arm64")
        print_err("machine - .github/workflows/release.yml runs on macos-26, which is one.")
        exit(1)

    check_release_signature()

    version = workspace_version()
    staging = ".build/release"
    app = "{staging}/{RELEASE_APP}"
    archive = ".build/Muster-{version}-arm64.zip"
    transport = "{staging}/notarize.zip"

    $`rm -rf {staging} {archive} && mkdir -p {staging}`
    // ditto rather than cp throughout: it is the one copier that carries extended attributes
    // and resource forks across, and a signature travels in those. A cp'd bundle verifies on
    // this machine and fails on the one that unzipped it.
    $`ditto {BUNDLE} {app}`
    $`ditto -c -k --keepParent {app} {transport}`

    // Two credential shapes, spelled out at each call site rather than built into a
    // variable: Rad quotes an interpolated value as one shell word, so a variable holding
    // `--key x --key-id y` arrives as a single unreadable flag.
    profile, key, key_id, issuer = notary_credentials()
    print(dim("submitting to Apple - this usually takes a few minutes"))
    if profile != "":
        stdout = $`xcrun notarytool submit {transport} --keychain-profile {profile} --wait --timeout 45m --output-format json`
    else:
        stdout = $`xcrun notarytool submit {transport} --key {key} --key-id {key_id} --issuer {issuer} --wait --timeout 45m --output-format json`
    judge_notarization(stdout, profile, key, key_id, issuer)

    $`xcrun stapler staple {app}` catch:
        // bep: error 65 is the ticket not having reached Apple's CDN yet, which is a wait
        // rather than a refusal.
        print(dim("the ticket has not propagated yet - waiting and trying again"))
        sleep(15)
        $`xcrun stapler staple {app}`

    $`xcrun stapler validate {app}`
    // What a person's machine will actually ask, asked here instead. Anything short of
    // "accepted" means the artifact is not ready to publish, whatever the steps above said.
    $`spctl -a -vv -t exec {app}`

    $`rm -f {transport} && ditto -c -k --keepParent {app} {archive}`
    checksum = $`shasum -a 256 {archive}`.stdout.split(" ")[0]
    print("notarized {archive}")
    print("sha256 {checksum}  - this is what the Homebrew cask needs")

// notarytool's exit code is not the verdict.
//
// bep learned this the expensive way: it has historically exited 0 on a rejection, so the
// status in the payload is the answer and the exit code is decoration. The two failures are
// also different questions - a submission with no verdict is still queued on Apple's side,
// and telling somebody their build was rejected when it is merely slow sends them looking
// for a defect that is not there. A first submission from a new account can take 20 minutes.
fn judge_notarization(stdout, profile, key, key_id, issuer):
    result = parse_json(stdout)
    submission = result.id ?? "unknown"
    status = result.status ?? ""

    if status == "":
        print_err(red("Apple has not returned a verdict yet, so nothing was stapled."))
        print_err("Impact: the bundle is signed but not shippable - and this is a wait, not a")
        print_err("rejection. The submission is still queued. Check on it with:")
        print_err("  xcrun notarytool info {submission} <the credentials you just used>")
        print_err("Once it says Accepted, run ./dev --bundle --notarize again.")
        exit(1)

    if status != "Accepted":
        print_err(red("Apple returned {status} for submission {submission}."))
        print_err("Impact: Gatekeeper will refuse this build on every machine but this one.")
        print_err("The log below says which binary and why. The usual causes are a nested")
        print_err("binary signed without --options runtime, a signature with no secure")
        print_err("timestamp, or an ad-hoc signature that got through.")
        if profile != "":
            $`xcrun notarytool log {submission} --keychain-profile {profile}`
        else:
            $`xcrun notarytool log {submission} --key {key} --key-id {key_id} --issuer {issuer}`
        exit(1)

// Asked of the bundle before Apple is, because every one of these comes back as a rejection
// twenty minutes later otherwise. get-task-allow is the sharp one: it means MUSTER_SIGN_IDENTITY
// was unset and this is the local ad-hoc bundle, which looks identical from the outside.
fn check_release_signature():
    entitlements = $`codesign -d --entitlements - --xml {BUNDLE} 2>/dev/null`.stdout
    if entitlements.count("get-task-allow") > 0:
        print_err(red("This bundle carries get-task-allow, so it was signed for debugging."))
        print_err("Impact: notarization refuses it, and it would take twenty minutes to say so.")
        print_err("Set MUSTER_SIGN_IDENTITY to a Developer ID and assemble it again:")
        print_err("  MUSTER_SIGN_IDENTITY=\"Developer ID Application: ...\" ./dev --bundle --notarize")
        exit(1)

    signature = $`codesign -dvvv {BUNDLE} 2>&1`.stdout
    // bep: match the flag's name rather than its hex, because the numeric value legitimately
    // changes as other signing flags are set beside it.
    for needle in ["Authority=Developer ID Application", "(runtime)", "Timestamp="]:
        if signature.count(needle) == 0:
            print_err(red("The bundle's signature is missing: {needle}"))
            print_err("Impact: Apple rejects it, so nothing ships. sign_bundle in this script is")
            print_err("what applies all three - check that MUSTER_SIGN_IDENTITY named a Developer")
            print_err("ID Application identity rather than an Apple Development one.")
            exit(1)

// Credentials, in whichever of the two shapes this machine has.
//
// A keychain profile locally, because that is what `xcrun notarytool store-credentials`
// leaves behind and nobody should keep an App Store Connect private key lying on disk to
// notarize their own build. CI has no keychain worth storing one in - the login keychain on
// a runner is locked and nobody is there to unlock it - so the workflow hands over the key
// file itself and this returns that instead.
//
// Returns the profile name and three empty strings, or an empty profile and the three parts
// of a key.
fn notary_credentials():
    key = get_env("MUSTER_NOTARY_KEY")
    if key != "":
        key_id = require_env("MUSTER_NOTARY_KEY_ID", "the App Store Connect key's ID")
        issuer = require_env("MUSTER_NOTARY_ISSUER", "your App Store Connect issuer UUID")
        return ["", key, key_id, issuer]

    profile = get_env("MUSTER_NOTARY_PROFILE")
    if profile == "":
        profile = "muster-notary"

    // Asked before the build is zipped, so a missing credential costs a second rather than
    // the minutes it takes to get here. Captured rather than announced: it answers with the
    // account's whole submission history, which is not what somebody asked to see.
    stdout, stderr, code = quiet $`xcrun notarytool history --keychain-profile {profile}` catch:
        print_err(red("No notarytool credentials are stored under the profile {profile}."))
        print_err("Impact: the bundle is signed but cannot be notarized, so Gatekeeper will")
        print_err("refuse it on every machine but this one. Store an App Store Connect API key")
        print_err("once with:")
        print_err("  xcrun notarytool store-credentials {profile} --key <p8> --key-id <id> --issuer <uuid>")
        print_err("Or name a profile you already have: MUSTER_NOTARY_PROFILE=<name>")
        exit(1)
    return [profile, "", "", ""]

// A missing credential is a sentence rather than whatever the tool three lines down would
// have said about a flag it was handed empty.
fn require_env(name, what):
    value = get_env(name)
    if value == "":
        print_err(red("{name} is not set, so this build cannot be notarized."))
        print_err("Impact: the bundle is signed but Gatekeeper will still refuse it elsewhere.")
        print_err("Set it to {what}. In CI these come from repository secrets; see")
        print_err(".github/workflows/release.yml for the whole set.")
        exit(1)
    return value

// The seam's types are generated on both sides and committed on neither, so a checkout
// cannot hold a shell and a core that disagree - it holds neither until something builds
// them. Rust needs nothing here: protox is a Rust library, so cargo regenerates from the
// same schema and does its own freshness tracking. Swift has no equivalent parser, so this
// builds swift-protobuf's vendored protoc from source - about half a minute, once - and
// gates the run on the schema's hash the way deps/.built gates libghostty.
fn proto_hash():
    return $`shasum -a 256 {PROTO}`.stdout.split(" ")[0]

fn proto_is_current():
    if not get_path(PROTO_OUT).exists:
        return false
    stamp = read_file(PROTO_STAMP) catch:
        return false
    return stamp.content.trim() == proto_hash()

fn generate_proto():
    print(dim("generating the seam's Swift types - builds protoc from source the first time"))
    bin = $`swift build --show-bin-path`.stdout.trim()
    $`swift build --product protoc`
    $`swift build --product protoc-gen-swift`
    $`mkdir -p {PROTO_OUT}`
    // The plugin is named by path rather than found on PATH, so this cannot pick up some
    // other protoc-gen-swift that happens to be installed.
    $`{bin}/protoc --plugin=protoc-gen-swift={bin}/protoc-gen-swift --swift_out={PROTO_OUT} --proto_path=proto {PROTO}`
    write_file(PROTO_STAMP, proto_hash())

fn read_pin():
    result = read_file("deps/ghostty.pin") catch:
        print_err(red("deps/ghostty.pin is missing or unreadable."))
        print_err("It names the libghostty commit this tree builds against, so without it")
        print_err("nothing can be built. Restore it from git.")
        exit(1)
    return result.content.trim()

// The three files tools/gen-keycodes writes, each of which records the pin it was
// generated from in its first two lines.
KEYCODE_TABLES = [
    "crates/muster-core/src/input/key.rs",
    "crates/muster-vt/src/key_mapping.rs",
    "Sources/MusterMac/KeyNames.generated.swift",
]

// A bumped pin with stale keycode tables compiles and tests green, which is why this is a
// check rather than something a reviewer would notice.
//
// Renamed keys already fail: muster-vt bindgens the C enum fresh every build, so a member
// that moved takes the build with it. What gets through is an ADDED key - a new macOS
// keycode or DOM code that simply has no row here - and a key that does nothing is the
// hardest kind to notice, because nobody presses every key.
//
// Refused rather than regenerated, unlike the proto stamp next to it. Regenerating rewrites
// three committed files, and the generator's own README asks for a person to read what
// moved: a pin bump can change the naming rule, and the two JIS keys it deliberately skips
// need re-checking each time in case upstream has since named them.
//
// The pin is read out of the generated files themselves rather than from a stamp beside
// them. There is nothing to keep in step that way, and the answer is legible to anyone who
// opens one of the three.
fn keycodes_are_current(pin):
    for table in KEYCODE_TABLES:
        generated = read_file(table) catch:
            print_err(red("{table} is missing."))
            print_err("It is generated from libghostty and committed. Restore it from git,")
            print_err("or regenerate the three with tools/gen-keycodes/gen-keycodes.")
            exit(1)
        if pin not in generated.content:
            return false
    return true

// The entitlements a release is signed with have to be well-formed XML, and nothing
// else in the gate ever opens the file.
//
// codesign reads it through AMFI, and AMFI only reads it when a real identity signs a
// bundle - every local build is ad-hoc and passes no entitlements at all. So a malformed
// one is invisible until the release workflow, which is where it cost the 0.3.0 build:
// `Failed to parse entitlements: AMFIUnserializeXML: syntax error near line 19`.
//
// `plutil -lint` is not this check and says OK to the file that broke that build. What
// XML forbids and AMFI enforces is a double hyphen inside a comment, which is easy to
// write by accident because it is how every flag in this repo is spelled.
fn check_entitlements():
    // Exits with the parser's own one-line verdict rather than a traceback, which buries
    // the line number this is entirely about.
    reader = "import sys, xml.dom.minidom\ntry:\n xml.dom.minidom.parse(sys.argv[1])\nexcept Exception as error:\n sys.exit(str(error))"
    stdout, stderr, code = $`python3 -c {reader} {ENTITLEMENTS}` catch:
        print_err(red("{ENTITLEMENTS} is not well-formed XML."))
        print_err("Impact: codesign refuses it, so a release fails at the signing step and")
        print_err("publishes nothing. No local build reads the file, so the gate is green.")
        print_err("Fix: the likely cause is a double hyphen inside the comment - spelling a")
        print_err("flag out in prose is enough to do it. The parser says where:")
        print_err(stderr.trim())
        exit(1)

fn check_keycodes():
    pin = read_pin()
    if keycodes_are_current(pin):
        return
    print_err(red("the generated keycode tables are not from deps/ghostty.pin."))
    print_err("They map macOS virtual keycodes and DOM codes onto libghostty's key")
    print_err("identities, and this tree pins {pin[:12]}. A key added upstream since they")
    print_err("were generated has no row in them, so it reaches no pane and nothing fails:")
    print_err("the suite stays green and that one key silently does nothing.")
    print_err("Regenerate them, and read what moved before committing:")
    print_err("  tools/gen-keycodes/gen-keycodes")
    exit(1)

// The patches, in the order they apply.
fn ghostty_patches():
    if not get_path(GHOSTTY_PATCHES).exists:
        return []
    names = find_paths(GHOSTTY_PATCHES, depth=1).filter(fn(name) name.ends_with(".patch"))
    return sort(names).map(fn(name) "{GHOSTTY_PATCHES}/{name}")

fn patch_note():
    count = len(ghostty_patches())
    return count == 0 ? "" : " with {count} patch{count == 1 ? '' : 'es'}"

// What deps/.built records: the pin, then each patch with a hash of its content, so editing,
// adding or removing a patch rebuilds exactly as a re-pin does.
fn deps_stamp(pin):
    lines = [pin]
    for patch in ghostty_patches():
        hash = quiet $`git hash-object {patch}`.stdout.trim()
        lines += ["{patch} {hash}"]
    return lines.join("\n")

// Everything under deps/ is reproducible from the pin and the patches, so the check is only
// ever "is what sits there what we asked for". libghostty takes minutes to build and changes
// only when one of those does.
//
// The stamp alone is not enough: a deleted or half-copied artifact leaves the stamp
// saying yes, and the failure then surfaces minutes later as a linker error naming a
// path nobody recognizes.
fn deps_are_current(pin):
    stamp = read_file(BUILT_STAMP) catch:
        return false
    if stamp.content.trim() != deps_stamp(pin):
        return false
    for artifact in DEP_ARTIFACTS:
        if not get_path(artifact).exists:
            print(dim("{artifact} is missing; rebuilding libghostty"))
            return false
    return true

fn build_deps():
    pin = read_pin()
    if deps_are_current(pin):
        print(dim("libghostty already built at {pin[:12]}{patch_note()}"))
        return

    // Asked for only once there is something to build with it. Every other tier takes deps on
    // the way past now, so checking first would make zig a requirement for running the suite
    // on a tree that has libghostty sitting right there.
    // Caught, because a missing zig and a wrong zig are the same question to whoever is
    // about to be stopped by it, and only one of them used to get an answer. Uncaught, an
    // absent binary raised Rad's own "command exited with code 127" against the raw command
    // line - which is the first-run friction the README already calls out for a missing rad.
    stdout, stderr, code = $`zig version` catch:
        print_err(red("zig {ZIG_VERSION} is required to build libghostty, and none is installed."))
        print_err("Try: brew install zig@0.16")
        exit(1)
    installed = stdout.trim()
    if installed != ZIG_VERSION:
        print_err(red("zig {ZIG_VERSION} is required; found {installed}."))
        print_err("libghostty pins its own minimum, and a mismatch surfaces as a wall of")
        print_err("compiler errors inside ghostty rather than as a version complaint.")
        // The versioned formula rather than the bare one: `zig` tracks upstream stable and
        // will drift off this pin, so the fix that reads right today stops working silently.
        print_err("Try: brew install zig@0.16")
        exit(1)

    print(dim("building libghostty at {pin[:12]}{patch_note()} - several minutes on a cold cache"))
    $`mkdir -p {GHOSTTY_DIR}`
    $`git init -q {GHOSTTY_DIR}`
    // A fresh clone and a re-pin take the same path: fetch exactly the one commit.
    $`git -C {GHOSTTY_DIR} remote add origin {GHOSTTY_REPO} 2>/dev/null || true`
    $`git -C {GHOSTTY_DIR} fetch -q --depth 1 origin {pin}`
    // Back to the pin's own files before the patches apply, so an older version of a patch
    // never stacks under this one: hard, for the files a patch changed, and clean, for the
    // files a patch created, which would otherwise make it refuse to apply a second time.
    // Without -x, so what ghostty's own .gitignore covers - zig-out, .zig-cache and the
    // xcframework, everything a build leaves - survives.
    $`git -C {GHOSTTY_DIR} checkout -q --force FETCH_HEAD`
    $`git -C {GHOSTTY_DIR} reset -q --hard FETCH_HEAD`
    $`git -C {GHOSTTY_DIR} clean -q -f -d`
    for patch in ghostty_patches():
        full = get_path(patch).full_path
        $`git -C {GHOSTTY_DIR} apply --whitespace=nowarn {full}` catch:
            print_err(red("{patch} does not apply to libghostty at {pin[:12]}."))
            print_err("Impact: nothing is built, because Muster's replay and daemon call the API")
            print_err("the patch adds, and a libghostty without it fails at link time instead.")
            print_err("After a re-pin this means the patch needs rebasing: apply it in")
            print_err("{GHOSTTY_DIR} by hand, resolve, and write the result back with `git diff`")
            print_err("before running ./dev again, which resets that checkout and discards it.")
            exit(1)

    // Two builds, because -Demit-lib-vt turns the xcframework off: the surface API that
    // the shell renders through, then the VT that the core encodes keys with and the
    // tests read grids from. The VT stays ReleaseFast for the daemon too: ReleaseSafe parsed
    // every byte about 35% slower (docs/mip/0003-own-daemon.md, section 13).
    $`cd {GHOSTTY_DIR} && zig build -Doptimize=ReleaseFast -Demit-xcframework=true -Dxcframework-target=native -Demit-terminfo=true`
    $`cd {GHOSTTY_DIR} && zig build -Doptimize=ReleaseFast -Demit-lib-vt=true`
    for zig_target in LINUX_DAEMONS.values():
        $`cd {GHOSTTY_DIR} && zig build -Doptimize=ReleaseFast -Demit-lib-vt=true -Dtarget={zig_target} --prefix zig-out/{zig_target}`
    write_file(BUILT_STAMP, deps_stamp(pin))

// Copies what the daemon hands its shells out of the pinned checkout, unchanged. Every time
// rather than behind the stamp: it is a handful of copies, and two of its files are this repo's
// own, which the stamp does not cover. The terminfo entries are the ones the xcframework build
// compiled with the Mac's tic, placed under both layouts ncurses reads - hashed directories
// (78/) on macOS, first letters (x/) on Linux. The compiled format is the same on both.
//
// Built beside the directory and swapped in only when it differs, because a daemon started by
// another ./dev in this checkout - any test run - refuses to start on a directory caught
// half-copied. A daemon starting in the instant between the two renames still finds none, which
// can only happen when the content changed.
//
// Two runs can swap at once. The last rename is one that refuses a target that is not empty,
// where mv would move the directory inside it: the run that loses has staged the same checkout's
// files, so it drops its copy. A copy a failed run left behind is swept once it is ten minutes
// old, never sooner, since a younger one may be another run's still being staged.
fn assemble_daemon_data():
    integration = "{GHOSTTY_DIR}/src/shell-integration"
    compiled = "{GHOSTTY_DIR}/zig-out/share/terminfo"
    sweep = "import glob, os, shutil, sys, time; [shutil.rmtree(p, ignore_errors=True) for p in glob.glob(sys.argv[1] + '.*') if time.time() - os.path.getmtime(p) > 600]"
    quiet $`python3 -c {sweep} {DAEMON_DATA}`
    staged = quiet $`mktemp -d {DAEMON_DATA}.XXXXXX`.stdout.trim()
    for dir in ["78", "x"]:
        quiet $`mkdir -p {staged}/terminfo/{dir}`
        quiet $`cp {compiled}/78/xterm-ghostty {staged}/terminfo/{dir}/xterm-ghostty`
    for dir in ["67", "g"]:
        quiet $`mkdir -p {staged}/terminfo/{dir}`
        quiet $`cp {compiled}/67/ghostty {staged}/terminfo/{dir}/ghostty`
    quiet $`cp {compiled}/ghostty.terminfo {staged}/terminfo/ghostty.terminfo`
    // Muster's own, beside Ghostty's files rather than in them (the README says which is which).
    quiet $`mkdir -p {staged}/bin`
    quiet $`cp packaging/muster-daemon-data/bin/ghostty {staged}/bin/ghostty`
    quiet $`chmod 755 {staged}/bin/ghostty`
    quiet $`mkdir -p {staged}/shell-integration/fish`
    quiet $`cp -R {integration}/bash {integration}/zsh {staged}/shell-integration/`
    quiet $`cp -R {integration}/fish/vendor_conf.d {staged}/shell-integration/fish/`
    quiet $`cp {GHOSTTY_DIR}/LICENSE {staged}/LICENSE-ghostty`
    quiet $`cp licenses/GPL-3.0.txt {staged}/GPL-3.0.txt`
    quiet $`cp packaging/muster-daemon-data/README.md {staged}/README.md`
    // mktemp makes the directory 0700, and the daemon's panes read it as whoever they run as.
    quiet $`chmod 755 {staged}`

    unchanged = true
    quiet $`diff -rq {staged} {DAEMON_DATA}` catch:
        unchanged = false
    if unchanged:
        quiet $`rm -rf {staged}`
        return
    // Either may fail to a run swapping at the same moment, which leaves an equal copy in place.
    // Any other failure leaves no directory at all, and every daemon this checkout starts then
    // refuses to, so that is checked for rather than assumed away.
    why = ""
    if get_path(DAEMON_DATA).exists:
        stdout, stderr, code = quiet $`mv {DAEMON_DATA} {staged}.old` catch:
            why = stderr.trim()
    rename = "import os, sys; os.rename(sys.argv[1], sys.argv[2])"
    stdout, stderr, code = quiet $`python3 -c {rename} {staged} {DAEMON_DATA}` catch:
        why = stderr.trim()
        quiet $`rm -rf {staged}`
    if not get_path(DAEMON_DATA).exists:
        print_err(red("Could not put {DAEMON_DATA} in place, and no daemon starts without it."))
        print_err("The copy it replaced, if there was one, is at {staged}.old.")
        print_err(why)
        exit(1)
    quiet $`rm -rf {staged}.old`

// The contract tier is opt-in and never part of the gate: it launches the real app, which
// needs a logged-in GUI session, and the default suite must stay offline and deterministic
// (docs/testing.md). Asking for it alone should not also take the whole gate.
//
// It takes a bundle as well as a build, because one of its checks launches the app as it
// ships rather than as SwiftPM leaves it. Those are different layouts - muster-daemon moves
// into a helper bundle - and the difference cost a release (kan a_2Hnh3g0Y5). Skipping the
// check when no bundle happened to be lying about is how a check quietly stops running.
if contract:
    build = true
    bundle = true

// Same reasoning as the contract tier, a different missing thing: this one needs docker and
// a container, which a contributor's machine cannot be assumed to have running.
if ssh:
    build = true

// Needs the daemon's data directory, which the libghostty build assembles, and nothing else of
// the app.
if claude_code:
    deps = true

if record and not perf:
    print_err(red("--record only means something with --perf."))
    print_err("It records what a perf run measured, so on its own there is nothing to")
    print_err("record and the baseline would be left untouched without saying so.")
    print_err("Try: ./dev --perf --record")
    exit(1)

// Deliberately not implied by --record. Recording on a busy machine is the worst case
// rather than the exception: a judged run that read slow is one red run, and a baseline
// recorded slow is every run after it reading green when it should not.
if anyway and not perf:
    print_err(red("--anyway only means something with --perf."))
    print_err("It waives the load check that stops --perf judging a busy machine, and no")
    print_err("other tier has one to waive.")
    print_err("Try: ./dev --perf --anyway")
    exit(1)

if proto:
    build = true

// There is nothing to wrap a bundle around until the binary exists.
if bundle:
    build = true

// And nothing to notarize until a bundle exists. Assembling one is also where the Developer
// ID signature gets applied, so the two are one act rather than two that happen to run in
// order - notarizing yesterday's ad-hoc bundle is a failure with a confusing message.
if notarize:
    bundle = true

if not (deps or build or test or lint or format or clean or bundle or notarize or contract or ssh or claude_code or linux or perf or latency or doctor):
    deps = true
    build = true
    test = true
    lint = true

// A narrowed flag still takes everything it cannot run without, and the two rules below are the
// whole of that chain. Without them the flags are only safe on a tree the full gate has already
// been through, which is the tree the person writing them happens to have - so a fresh checkout
// meets a wall of compiler errors, and the flag that would have prevented it is the one they
// skipped to save the minute.
//
// The suite takes a build, and that is a correctness rule rather than a convenience. The seam's
// Swift types are generated during `build` and committed nowhere, so a suite that skipped it
// compiled the shell against whatever was generated last - green while the schema said
// something else, which is exactly the disagreement `proto/muster.proto` being the one source
// is meant to make impossible. A fresh checkout at least fails loudly; a checkout with a stale
// generated file passes.
if test:
    build = true

// Compiling anything needs libghostty, which is reproduced from a pin rather than checked in.
// Lint is on this list because clippy is a compile - the style half of it needs nothing, but
// the half that runs after the build does. Cheap to demand: a tree that already has libghostty
// answers with one line, and the freshness check below costs a stamp read and seven path tests.
if build or lint or perf or linux or latency:
    deps = true

// Sampled once and reported before anything else runs, so that every run - the full gate and
// a narrowed flag alike - opens with what the machine was doing while it happened.
cores, fast_cores, load1, load5, load15 = machine()
report_machine(cores, fast_cores, load1, load5, load15)

if doctor:
    announce("doctor")
    run_doctor()

if clean:
    announce("clean")
    $`cargo clean`
    $`swift package clean`

if format:
    announce("format")
    $`cargo fmt --all`
    $`swift format --recursive --in-place Sources Tests Package.swift`

// The cheapest signal this script has, and therefore the first. None of these needs a
// compiler, a dependency or an artifact, so they answer in seconds on a checkout with
// nothing built - and a misplaced brace found after the suite has run costs a minute to
// learn something a second would have said. After --format rather than before, so that
// asking for both means "fix it, then check the fix" rather than a refusal to start.
if lint:
    announce("style")
    $`cargo fmt --all --check`
    $`swift format lint --recursive --strict Sources Tests Package.swift`
    // The Python under tools/ is dev tooling rather than a component, so it gets a syntax
    // check and no more.
    $`python3 -m compileall -q tools`
    check_entitlements()

if deps:
    announce("deps")
    build_deps()
    assemble_daemon_data()

if build:
    announce("build")
    // Before anything is compiled, because what this catches compiles perfectly well.
    check_keycodes()
    if proto or not proto_is_current():
        generate_proto()
    // The core first: it is the layer the shell will call into, and its errors are the
    // ones a contributor can act on without a window.
    $`cargo build --workspace --all-targets`
    // The daemon for each Linux machine a remote pane can be on (MIP-3, section 12), built by
    // the gate so a change that breaks it fails here rather than on the next remote install -
    // and the CLI the same install places beside it, which is how an agent there messages
    // another (MIP-4, section 13).
    for target in LINUX_DAEMONS.keys():
        $`cargo build -p muster-daemon -p muster-cli --target {target}`
    $`swift build`
    stage_helpers("debug")

if bundle:
    announce("bundle")
    // Optimized, where the gate's build above is not. Until 0.9.0 every bundle carried the
    // debug build of all three layers - a first bundle's default that nobody chose - so the
    // app people ran was the one binary nothing had measured: the perf and latency tiers
    // build release. libghostty is ReleaseFast either way (build_deps).
    $`cargo build --release -p muster-seam -p muster-bridge -p muster-cli -p muster-daemon`
    // Stripped, since the app carries both to machines that will only ever run them: 5.0 MB
    // and 6.0 MB rather than several times that with the release profile's debug info.
    for target in LINUX_DAEMONS.keys():
        $`CARGO_PROFILE_RELEASE_STRIP=symbols cargo build --release -p muster-daemon -p muster-cli --target {target}`
    $`swift build -c release`
    stage_helpers("release")
    build_bundle()

if notarize:
    announce("notarize")
    notarize_bundle()

// Clippy is a compile, so it cannot move up with the rest of the style checks - but it
// goes before the suite rather than after it. Which lints are on is declared in Cargo.toml,
// so that cargo, rust-analyzer and this all judge the code the same way; the gate's job is
// only to escalate them, because a warning a contributor can ignore forever is not a rule.
if lint:
    announce("lint")
    $`cargo clippy --workspace --all-targets -- -D warnings`
    // The Linux halves of the daemon and of detection are code a Mac never compiles otherwise.
    // One target is enough: the two differ only in libc's per-architecture constants.
    $`cargo clippy -p muster-daemon -p muster-detect -p muster-msg --all-targets --target aarch64-unknown-linux-musl -- -D warnings`
    // The CLI's own code only: its tests drive a window, whose seam is macOS's.
    $`cargo clippy -p muster-cli --target aarch64-unknown-linux-musl -- -D warnings`

if test:
    announce("test")

    // Before the suite, because the corpus is what most of the suite asserts against. A
    // file nobody loads is checked in, never run, and indistinguishable from coverage -
    // and no driver can catch that, since the check is about the file it never opened.
    stdout, stderr, code = $`python3 tools/corpus-lint.py` catch:
        print_err(stdout.trim())
        print_err(stderr.trim())
        exit(1)
    print(dim(stdout.trim()))

    // The same claim about the code itself: a file without its `mod` line compiles to
    // nothing, and the suite below stays green without it - most easily a test file.
    stdout, stderr, code = $`python3 tools/test-mods.py` catch:
        print_err(red("A Rust file is never compiled."))
        print_err(stderr.trim())
        exit(1)
    print(dim(stdout.trim()))

    // Beside the corpus check because it is the same kind of claim: a file checked in to
    // describe something, which nothing else notices has stopped describing it. The thing
    // here is what the bundle redistributes, and a dependency arrives inside a change about
    // something else entirely - so nobody reviewing that change is thinking about licenses.
    // It reads the registry cargo already filled during the build above, so it is offline.
    stdout, stderr, code = $`python3 tools/licenses.py --check` catch:
        print_err(red("The bundle's attribution no longer matches what is in it."))
        print_err(stderr.trim())
        exit(1)
    print(dim(stdout.trim()))

    // A suite that quietly stops running is worse than a red one: it reports green
    // forever. cmux shipped CI passing with "Executed 0 tests" for a while, and
    // docs/testing.md takes that as a standing hazard, so ask what the runner can see
    // before trusting what it reports.
    //
    // Note that a healthy run prints "Executed 0 tests" too - that is the empty XCTest
    // suite sitting alongside swift-testing - so the run's own output cannot be the
    // signal here.
    // Both suites get the same treatment, because adding a second language doubles the
    // places a suite can quietly stop running.
    stdout, stderr, code = $`cargo test --workspace -- --list` catch:
        print_err(red("Rust test discovery failed, so that suite never ran."))
        print_err("Until it does, nothing below has been verified. Compiler output:")
        print_err(stderr.trim())
        exit(1)

    // One line per test, each ending in ": test"; the per-binary totals land between them.
    rust_tests = stdout.split_lines().filter(fn(line) line.ends_with(": test"))
    if len(rust_tests) == 0:
        fail_empty_suite("Rust", "Usual causes: a crate dropped out of the workspace members, or a crate's tests/<name>/main.rs lost its modules. Try: cargo test --workspace -- --list")

    print(dim("{len(rust_tests)} Rust test(s) discovered"))

    // What the run below will leave out, asked before it runs rather than counted after.
    // `--list --ignored` names exactly the tests `cargo test` will skip, so this needs no
    // parsing of a streaming run and the run keeps printing as it goes.
    stdout, stderr, code = $`cargo test --workspace -- --list --ignored` catch:
        print_err(red("Rust could not say which tests it will skip."))
        print_err(stderr.trim())
        exit(1)
    rust_ignored = stdout.split_lines().filter(fn(line) line.ends_with(": test"))
    check_skipped("Rust", len(rust_ignored), rust_ignored,
        "Add or remove the row in SKIPPED_SUITES above, or take the #[ignore] off. Try: cargo test --workspace -- --list --ignored")

    // Every daemon-backed test runs the muster-daemon the build above made, which the harness
    // finds beside the test binaries: the daemon under test is always this commit's.
    $`cargo test --workspace`

    stdout, stderr, code = $`swift test list` catch:
        if matches(stderr, "no tests found", partial=true):
            fail_empty_suite("Swift", "Try: swift test list")
        print_err(red("Swift test discovery failed, so that suite never ran."))
        print_err("Until it does, nothing below has been verified. Compiler output:")
        print_err(stderr.trim())
        exit(1)

    // Names land on stdout and build chatter on stderr, so every non-empty line is a
    // test.
    tests = stdout.trim().split_lines().filter(fn(line) line.trim() != "")
    if len(tests) == 0:
        fail_empty_suite("Swift", "Usual causes: a test target dropped out of Package.swift, or tests moved out of Tests/. Try: swift test list")

    print(dim("{len(tests)} Swift test(s) discovered"))

    // Named in the manifest and gone from the tree is the failure this whole check exists for,
    // and it is the cheap half: discovery above already lists every test whether or not a
    // trait will disable it, so a suite that was deleted or renamed is a lookup away.
    for row in SKIPPED_SUITES:
        if row.language == "Swift":
            present = tests.filter(fn(line) matches(line, row.suite, partial=true))
            if len(present) == 0:
                print_err(red("./dev expects {row.suite} to skip itself, and swift test list has never heard of it."))
                print_err("Either it was deleted or renamed, in which case the row in")
                print_err("SKIPPED_SUITES needs the same edit, or a whole target has dropped")
                print_err("out of Package.swift and rather more than this suite is missing.")
                exit(1)

    // Then what the run actually left out, read off its own skip records. Counting was tried
    // first and cannot work: `swift test list` says 319 and a run that skips a suite also says
    // 319, which is the observation the card was raised on. `--xunit-output` writes nothing at
    // all for a swift-testing run, so the transcript is the only place the fact exists.
    //
    // Captured rather than streamed, so the exit code stays swift test's own - a `| tee` would
    // hand the gate tee's success and a red suite would pass. The output is printed either way
    // and the tests themselves take under a second; what is silent is the test-target build,
    // which `swift test list` above already spends without printing.
    stdout, stderr, code = $`swift test` catch:
        print(stdout)
        print_err(stderr.trim())
        exit(1)
    print(stdout)
    swift_skipped = stdout.split_lines().filter(fn(line) matches(line, "Test \".*\" skipped:", partial=true))
    check_skipped("Swift", len(swift_skipped), swift_skipped,
        "Add or remove the row in SKIPPED_SUITES above, or take the .enabled(if:) off the suite.")

if contract:
    announce("contract")
    // The only checks that run the app itself. Everything else stops short of the shell or
    // of a window; these launch the real binary against a real muster-daemon and read the
    // run log to see what actually connected. The gate compiles them and skips them, so this
    // asks for its ignored tests, one at a time: each times a launch, and ten launching at
    // once would time the machine instead. The paths are handed over rather than worked out
    // by the tests, so the app they judge is the one this run just built.
    swift_bin = $`swift build --show-bin-path`.stdout.trim()
    root = $`pwd`.stdout.trim()
    // A directory per checkout, so two worktrees running this at once do not delete each
    // other's homes, and the same one on every run here, so a run finds the daemons an
    // interrupted one left and ends them. Short, for the socket paths the app binds under it.
    checkout = $`printf %s {root} | shasum -a 256`.stdout[:8]
    scratch = "/tmp/muster-contract-{checkout}"
    print("Each check's home and run log: {scratch}/<check>/")
    $`MUSTER_CONTRACT_ROOT={scratch} MUSTER_CONTRACT_APP={swift_bin}/muster MUSTER_CONTRACT_BUNDLE={root}/{BUNDLE}/Contents/MacOS/muster cargo test -p muster-contract --test launch -- --ignored --test-threads=1` catch:
        print_err(red("The app did not launch cleanly against a real daemon."))
        print_err("Each check's run log is under {scratch}/<check>/run.jsonl.")
        exit(1)

    // And the Swift tests that need a real libghostty surface, which is a Metal layer on a
    // view and so wants the same logged-in session the launch above does. They are ordinary
    // tests otherwise, and they skip themselves without this variable rather than failing -
    // the default gate lists them as skipped, which is how a reader knows they exist.
    $`MUSTER_GUI_TESTS=1 swift test --filter SurfaceGUITests`

if ssh:
    announce("ssh")
    run_ssh_tier()

if claude_code:
    announce("claude-code")
    // The one tier that reaches the network and a real model, with whatever Claude Code is
    // installed here: it says whether an update broke the hooks or the screen rules, or changed
    // what Claude Code does with a message the daemon sends its inbox. With this
    // variable the test fails, saying which is missing, without claude or a login or
    // ANTHROPIC_API_KEY; without it the test skips itself, so the remote tier's run of every
    // ignored test leaves it alone.
    $`MUSTER_CLAUDE_CODE_TESTS=1 cargo test -p muster-daemon --test daemon -- claude_code_live claude_code_inbox claude_code_doorbell --ignored --nocapture`

// The remote tier needs docker anyway, and a remote pane is a Linux daemon's pane.
if linux or ssh:
    announce("linux")
    run_linux_tier()

if perf:
    announce("perf")
    // Everywhere else a loaded machine only makes a run slow. Here it makes the run lie: these
    // numbers are judged against a checked-in baseline, so a benchmark that spent its time
    // waiting for a core reports a regression that nothing in the code caused. Refusing is
    // defensible here and nowhere else.
    //
    // The line is the performance cores rather than all of them, because past that many runnable
    // threads the scheduler starts handing work to the efficiency cores, which run this at
    // roughly half the speed - and half is most of the way to the 2.00x tolerance on its own.
    if not anyway and cores > 0 and load1 >= fast_cores:
        print_err(red("The machine is too busy for --perf to judge anything."))
        print_err("Load is {load1:.2} against {fast_cores} performance core(s), so a benchmark")
        print_err("thread is sharing a core with other work and every number reads slow.")
        print_err("Impact: nothing was measured, so no per-unit budget was verified. Judging")
        print_err("this against the baseline would report a regression that is not one.")
        print_err("./dev --doctor says what is on the machine. Or measure anyway and read the")
        print_err("numbers yourself rather than letting them gate:")
        print_err("  ./dev --perf --anyway")
        exit(1)

    // Release, always. A debug build runs several times slower than what ships, so a budget
    // measured there describes a binary nobody uses - and it would report headroom the
    // shipped binary does not have.
    $`cargo build --release --bin muster-perf`
    // Handed over rather than sampled again on the other side, for the same reason the log path
    // and the screens are: what a load average means is a per-OS question, and this script is
    // where this repo answers those. What the harness does with it is record it, so that a
    // baseline says what the machine was doing when it was written - which is the one thing
    // perf/baseline.json has never recorded and the variable that turns out to matter.
    load = "{load1:.2},{load5:.2},{load15:.2}"
    counts = "{cores},{fast_cores}"
    if record:
        stdout, stderr, code = $`target/release/muster-perf --record --load {load} --cores {counts}` catch:
            fail_perf(stdout, stderr, code)
    else:
        stdout, stderr, code = $`target/release/muster-perf --load {load} --cores {counts}` catch:
            fail_perf(stdout, stderr, code)
    print(stdout.trim())

if latency:
    announce("latency")
    // Reported rather than gated: the numbers move with whatever else the machine is doing, so a
    // threshold here would fail builds over the load rather than the code. ./dev --perf gates
    // what is ours.
    //
    // A keystroke through muster-daemon, with the bare PTY measured in the same run so the
    // verdicts compare like with like (MIP-3 section 13). Release builds, because the bridge's
    // hop is one of the things measured and a debug build would overstate it.
    $`cargo build --release --bin muster-bridge --bin muster-daemon --bin muster-latency`
    stdout, stderr, code = $`target/release/muster-latency --daemon target/release/muster-daemon --bridge target/release/muster-bridge` catch:
        print_err(red("Input-to-glyph could not be measured through muster-daemon, so nothing was learned."))
        print_err(stdout.trim())
        print_err(stderr.trim())
        exit(1)
    print(stdout.trim())

print(green("\n✓ ok"))
