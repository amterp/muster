#!/usr/bin/env rad
---
Muster's one door: build, test, and lint.

Run with no flags to take the full gate. CI runs exactly that and nothing else, so the
command a contributor types and the command that gates a merge cannot drift apart.

Flags are clustered short bools, so the common combinations stay one token:
'./dev -t' tests, './dev -tl' tests and lints, './dev -fbt' reformats then builds and
tests.
---
args:
    deps d bool    # Fetch and build the pinned libghostty.
    build b bool   # Compile everything.
    test t bool    # Run the suite.
    lint l bool    # Report style violations, changing nothing.
    format f bool  # Rewrite sources into canonical style.
    clean c bool   # Delete build artifacts.
    proto bool     # Regenerate the seam's Swift types, whether or not the schema changed.
    bundle bool    # Assemble muster.app around the built binary. Not in the gate.
    contract bool  # Run the app against a real herdr. Needs a GUI session; not in the gate.
    ssh bool       # Run the remote tier against the devenv container. Needs docker; not in the gate.
    perf bool      # Measure the per-unit budgets against perf/baseline.json. Not in the gate.
    record bool    # With --perf, record this run as the new baseline instead of judging it.
    latency bool   # Time input-to-glyph against a real herdr. Needs a daemon; not in the gate.

ZIG_VERSION = "0.16.0"
GHOSTTY_REPO = "https://github.com/ghostty-org/ghostty"
GHOSTTY_DIR = "deps/ghostty"
XCFRAMEWORK = "deps/ghostty/macos/GhosttyKit.xcframework"
BUILT_STAMP = "deps/.built"
// Both builds of the pin: the surface API the shell renders through, and the VT the
// core encodes keys with and the tests read grids from.
DEP_ARTIFACTS = [
    XCFRAMEWORK,
    "deps/ghostty/zig-out/lib/libghostty-vt.dylib",
    "deps/ghostty/zig-out/include/ghostty/vt.h",
]
// The session backend is a runtime dependency of the suite, not just of the app. Tests
// that speak to a daemon speak to a real one: a hand-written stand-in would be Muster's
// own guess at herdr's behavior, and a wrong guess passes (docs/testing.md).
HERDR_PIN = "deps/herdr.pin"
HERDR_DIR = "deps/herdr"
HERDR_RELEASES = "https://github.com/herdrdev/herdr/releases/download"
// Short and outside the toolchain's output directories, because it is the one artifact a
// person types the path of - and `swift package clean` still takes it with the rest.
BUNDLE = ".build/muster.app"
// The app's identity to the OS, and what a notification permission grant will attach to.
BUNDLE_ID = "com.amterp.muster"
PROTO = "proto/muster.proto"
PROTO_OUT = "Sources/MusterMac/Generated"
// Gitignored, beside the code it describes: the hash of the schema that produced it. The
// Rust side needs no equivalent - cargo tracks the same file itself.
PROTO_STAMP = "Sources/MusterMac/Generated/.proto.sha256"

// Every command captured here names its targets `stdout`, `stderr` and `code`, and never
// anything else - not even `_`.
//
// Rad fills a capture by name when every target is spelled one of those three, and by
// position otherwise. Rad v0.12 reorders the positional form from (code, stdout, stderr)
// to (stdout, stderr, code), so a positional capture means one thing under the pinned Rad
// and another under a newer one - while the named form means the same under both. This
// script is read by two Rads that disagree: deps/rad.pin is what CI installs, and a
// contributor's own rad is whatever they have.
//
// It is worth being strict about because the failure is quiet. `uname -s` captured
// positionally binds the exit code on one side and "Darwin" on the other, and the gate
// died at the `.trim()` two lines later, naming a type rather than a command.

fn announce(name):
    print(bold("\n▸ {name}"))

fn fail_empty_suite(language, cure):
    print_err(red("No {language} tests were discovered."))
    print_err("An empty suite passes, so this is a failure rather than a green run.")
    print_err(cure)
    exit(1)

// Exit 2 means the run could not judge itself - no baseline, no corpus - and exit 1 means
// it judged and the answer was no. Collapsing the two would send someone hunting a
// regression that never happened.
fn fail_perf(stdout, stderr, code):
    print(stdout.trim())
    if code == 2:
        print_err(red("The perf run could not judge itself, so nothing was verified."))
        print_err(stderr.trim())
        exit(1)
    print_err(red("A per-unit budget regressed, or a benchmark stopped running."))
    print_err(stderr.trim())
    print_err("Either something on a hot path got slower, or the machine is busy - the")
    print_err("median column says which. If the cost is deliberate and acceptable:")
    print_err("  ./dev --perf --record")
    exit(1)

// The remote tier: a real ssh master to a real machine running a real daemon.
//
// Out of the gate because it needs docker and a container, which is the same line the
// contract tier sits on - not because it is slow or flaky (docs/testing.md, tiered by what
// a tier can reach). The container is the devenv, so what gets tested and what gets
// developed against are one artifact.
fn run_ssh_tier():
    $`./devenv/devenv up` catch:
        print_err(red("The devenv container would not start, so the remote tier ran nothing."))
        print_err("Impact: 'local and remote in one window' is unverified by this run.")
        print_err("Check that docker is running, then: ./devenv/devenv up")
        exit(1)

    // Absolute, because cargo runs an integration test from its own package root and a
    // repo-relative key silently becomes 'no such file' and then 'permission denied'.
    stdout = $`pwd`
    root = stdout.trim()
    key = "{root}/devenv/.ssh/id_ed25519"
    // The container is a local fixture on a port nobody else uses, and its key changes every
    // time it is rebuilt, so pinning its host key would mean editing a file per rebuild.
    options = "-p 2222 -i {key} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"

    stdout = $`MUSTER_DEVENV_HOST=dev@localhost MUSTER_DEVENV_SSH_OPTIONS={options} cargo test --workspace -- --ignored --list`
    names = stdout.split("\n").filter(fn(line) line.ends_with(": test"))
    if len(names) == 0:
        print_err(red("The remote tier discovered no tests."))
        print_err("An empty tier passes, so this is a failure rather than a green run.")
        print_err("Check that the #[ignore] tests in crates/muster-ssh/tests/ still exist.")
        exit(1)
    print(dim("{len(names)} remote test(s) discovered"))

    $`MUSTER_DEVENV_HOST=dev@localhost MUSTER_DEVENV_SSH_OPTIONS={options} cargo test --workspace -- --ignored`

    // The other half of the tier, and the one that catches an upgrade rather than a bug:
    // run the recorded scenarios against the container's Linux daemon and diff what it did
    // against what the macOS one did. Recorded into a scratch directory rather than over
    // corpus/herdr-<version>-linux, because a check that rewrites its own oracle can only
    // ever pass. Re-recording the checked-in one is a deliberate step, taken when herdr is
    // re-pinned (tools/herdr-probe/probe --remote).
    pin = read_file(HERDR_PIN) catch:
        print_err(red("{HERDR_PIN} is missing, so there is no corpus to compare against."))
        exit(1)
    pinned = parse_json(pin.content) catch:
        print_err(red("{HERDR_PIN} is not valid JSON, so there is no corpus to compare against."))
        exit(1)
    version = pinned.version

    scratch = "/tmp/muster-linux-corpus"
    $`rm -rf {scratch}`
    $`python3 tools/herdr-probe/probe --remote --corpus {scratch}`
    stdout, stderr, code = $`python3 tools/herdr-probe/diff-corpus corpus/herdr-{version} {scratch}` catch:
        print_err(red("The Linux daemon and the macOS one no longer agree."))
        print_err(stdout.trim())
        print_err(stderr.trim())
        exit(1)
    print(stdout.trim())
    if "\n0 difference(s)" not in stdout:
        print_err(red("The Linux daemon and the macOS one no longer agree."))
        print_err("Impact: 'local and remote render identically' stops being true, and the")
        print_err("adapter has to learn about whatever moved.")
        print_err("The diff above says what; docs/observations/herdr-{version}.md")
        print_err("section 8 is where the answer belongs once it is understood.")
        exit(1)

// The app finds its helpers beside its own executable - right for a shipped bundle, and
// wrong for two build systems with two output directories and a downloaded daemon. Rather
// than teach the app where cargo puts things, the build puts them where the app already
// looks. The awkwardness stays here instead of in the code that has cost the most time
// when it was wrong.
//
// herdr is one of them now: the app starts its own daemon rather than asking somebody to,
// and it starts the pinned one rather than whatever is on PATH, for the reason the suite
// does not read PATH either. So a build that produced no daemon would produce an app that
// opens an empty window - and this is the one step that touches the network.
fn stage_helpers():
    stdout = $`swift build --show-bin-path`
    swift_bin = stdout.trim()
    stage(target = "target/debug/muster-bridge", into = "{swift_bin}/muster-bridge")
    herdr = herdr_binary()
    stage(target = herdr, into = "{swift_bin}/herdr")

// Copies a binary into place without disturbing anyone running the old one.
//
// Via a temporary name and a rename, because a plain `cp` writes through the file the
// running process has mapped: macOS invalidates its pages, SIGKILLs it, and then SIGKILLs
// every later exec of the path until the signature is re-validated. That is not theoretical
// here - the app starts a daemon from this directory and the whole point of it is to outlive
// the app, so a rebuild would otherwise kill the agents somebody is running. A rename swaps
// the directory entry and leaves the old inode alone.
fn stage(target, into):
    $`cp {target} {into}.staging && mv -f {into}.staging {into}`

// Assembles the built binary into something the platform can launch.
//
// SwiftPM has no bundle product, so this is hand-rolled, and it is out of the gate because
// nothing in the gate needs one. What it buys is everything a bare binary in .build cannot
// be: a Dock icon, a double-click, `open -a`, and the launchd descriptor ceiling that only
// a GUI-launched process ever meets (DescriptorLimit.swift).
//
// Signing and notarization are a separate question and belong with going public. This is
// about launching it like an app on the machine that built it.
fn build_bundle():
    stdout = $`swift build --show-bin-path`
    swift_bin = stdout.trim()
    contents = "{BUNDLE}/Contents"

    // Assembled from nothing every time. A bundle that accumulated across builds could
    // carry a stale dylib beside a fresh binary, which fails at launch with a dyld error
    // naming a symbol rather than the build that produced it.
    $`rm -rf {BUNDLE}`
    $`mkdir -p {contents}/MacOS {contents}/Frameworks {contents}/Resources`

    // Helpers in MacOS/ rather than Resources/, because PaneCommand.bridge resolves them
    // beside the running executable and one rule has to cover the dev build and the bundle.
    $`cp {swift_bin}/muster {contents}/MacOS/muster`
    $`cp {swift_bin}/muster-bridge {contents}/MacOS/muster-bridge`
    $`cp {swift_bin}/herdr {contents}/MacOS/herdr`
    $`cp target/debug/libmuster.dylib {contents}/Frameworks/libmuster.dylib`
    $`cp {GHOSTTY_DIR}/zig-out/lib/libghostty-vt.dylib {contents}/Frameworks/libghostty-vt.dylib`

    // Bundling herdr is redistribution, and Apache-2.0 asks that its terms travel with the
    // binary. The copy is checked in rather than downloaded so that assembling a bundle
    // stays offline and so the text cannot silently stop matching what ships.
    $`cp licenses/herdr/LICENSE {contents}/Resources/LICENSE-herdr.txt`
    $`cp NOTICE {contents}/Resources/NOTICE.txt`

    write_info_plist(contents)

    // The rpaths compiled in are loader-relative to target/debug and to the ghostty
    // checkout (Package.swift, .cargo/config.toml), and neither exists inside a bundle. So
    // both binaries learn where their libraries now sit, and both are re-signed afterwards:
    // editing a Mach-O invalidates its signature, and macOS refuses to launch the result.
    $`install_name_tool -add_rpath @executable_path/../Frameworks {contents}/MacOS/muster`
    $`install_name_tool -add_rpath @loader_path {contents}/Frameworks/libmuster.dylib`

    sign_bundle(swift_bin, contents)
    print("assembled {BUNDLE} - open it, or drag it to the Dock")

// What Launch Services reads before anything of Muster's runs.
//
// The identifier is the app's identity to the OS, so it is what a notification permission
// grant attaches to (a_28Q5b3oPA). Changing it later means every user re-grants.
//
// Sudden termination is refused because the app owns a bridge process per pane. The daemon
// owns the PTYs and survives regardless, but a process killed without notice leaves its
// bridges to be reaped rather than shut down, and the run log ends mid-sentence.
fn write_info_plist(contents):
    version = workspace_version()
    plist = """
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>CFBundleName</key><string>Muster</string>
      <key>CFBundleDisplayName</key><string>Muster</string>
      <key>CFBundleExecutable</key><string>muster</string>
      <key>CFBundleIdentifier</key><string>{BUNDLE_ID}</string>
      <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
      <key>CFBundlePackageType</key><string>APPL</string>
      <key>CFBundleShortVersionString</key><string>{version}</string>
      <key>CFBundleVersion</key><string>{version}</string>
      <key>LSMinimumSystemVersion</key><string>14.0</string>
      <key>NSHighResolutionCapable</key><true/>
      <key>NSSupportsAutomaticTermination</key><false/>
      <key>NSSupportsSuddenTermination</key><false/>
    </dict>
    </plist>
    """
    write_file("{contents}/Info.plist", plist)

// One version, read from where the workspace already declares it.
//
// sed rather than awk because a `{}` in a command is Rad interpolation, and an awk program
// is mostly braces.
fn workspace_version():
    stdout = $`sed -n '/^\[workspace\.package\]/,$ s/^version *= *"\(.*\)"/\1/p' Cargo.toml | head -1`
    version = stdout.trim()
    if version == "":
        print_err(red("Cargo.toml's [workspace.package] has no version, so the bundle has none."))
        print_err("Impact: Launch Services shows the app as unversioned and an upgrade cannot")
        print_err("be told from a downgrade. Restore the version key.")
        exit(1)
    return version

// Ad-hoc, inner code first.
//
// Not a security measure - an ad-hoc signature asserts nothing about who built this. It is
// what macOS requires before it will run a Mach-O at all, and everything here has just been
// edited or copied out from under its old signature.
fn sign_bundle(swift_bin, contents):
    $`codesign -f -s - {contents}/Frameworks/libghostty-vt.dylib`
    $`codesign -f -s - {contents}/Frameworks/libmuster.dylib`
    $`codesign -f -s - {contents}/MacOS/muster-bridge`
    $`codesign -f -s - {contents}/MacOS/herdr`

    // The entitlement SwiftPM signs a debug build with: it is what lets a debugger attach,
    // and re-signing without it would make the bundle the one build nobody can debug.
    entitlements = "{swift_bin}/muster-entitlement.plist"
    if get_path(entitlements).exists:
        $`codesign -f -s - --entitlements {entitlements} {BUNDLE}`
    else:
        $`codesign -f -s - {BUNDLE}`

// The seam's types are generated on both sides and committed on neither, so a checkout
// cannot hold a shell and a core that disagree - it holds neither until something builds
// them. Rust needs nothing here: protox is a Rust library, so cargo regenerates from the
// same schema and does its own freshness tracking. Swift has no equivalent parser, so this
// builds swift-protobuf's vendored protoc from source - about half a minute, once - and
// gates the run on the schema's hash the way deps/.built gates libghostty.
fn proto_hash():
    stdout = $`shasum -a 256 {PROTO}`
    return stdout.split(" ")[0]

fn proto_is_current():
    if not get_path(PROTO_OUT).exists:
        return false
    stamp = read_file(PROTO_STAMP) catch:
        return false
    return stamp.content.trim() == proto_hash()

fn generate_proto():
    print(dim("generating the seam's Swift types - builds protoc from source the first time"))
    stdout = $`swift build --show-bin-path`
    bin = stdout.trim()
    $`swift build --product protoc`
    $`swift build --product protoc-gen-swift`
    $`mkdir -p {PROTO_OUT}`
    // The plugin is named by path rather than found on PATH, so this cannot pick up some
    // other protoc-gen-swift that happens to be installed.
    $`{bin}/protoc --plugin=protoc-gen-swift={bin}/protoc-gen-swift --swift_out={PROTO_OUT} --proto_path=proto {PROTO}`
    write_file(PROTO_STAMP, proto_hash())

// herdr is consumed as a binary rather than as source - it publishes no library target -
// so the suite reproduces one from a pin instead of asking what happens to be installed.
//
// Deliberately not the developer's PATH. herdr ships weekly and a person working on
// something else wants the latest one; a suite that hijacks that choice makes the two
// jobs fight. So the pinned binary lives under deps/ like libghostty does, and the herdr
// on your PATH is never consulted.
//
// Returns the path every daemon-backed test should run against.
fn herdr_binary():
    pin = read_file(HERDR_PIN) catch:
        print_err(red("{HERDR_PIN} is missing or unreadable."))
        print_err("It names the herdr release the suite is judged against, so without it no")
        print_err("daemon-backed test can run. Restore it from git.")
        exit(1)
    pinned = parse_json(pin.content) catch:
        print_err(red("{HERDR_PIN} is not valid JSON, so the pinned herdr cannot be resolved."))
        print_err("Restore it from git; it carries a version and a checksum per platform.")
        exit(1)

    version = pinned.version
    asset = herdr_asset_name()
    cached = "{HERDR_DIR}/{version}/herdr"

    // An override for someone bisecting herdr itself or testing an unreleased build. Its
    // bytes are not the pinned ones, so the version is still checked and the substitution
    // is announced - a run that quietly used a different daemon would make its own result
    // unreadable.
    override = get_env("MUSTER_HERDR")
    if override != "":
        check_herdr_version(override, version, "MUSTER_HERDR")
        print(dim("using MUSTER_HERDR={override} instead of the pinned build"))
        return get_path(override).full_path

    want = pinned.checksums[asset] catch:
        print_err(red("{HERDR_PIN} has no checksum for {asset}."))
        print_err("Impact: this platform has no pinned herdr, so no daemon-backed test can")
        print_err("run and the suite cannot verify the backend adapter or the mirror.")
        print_err("Fix: download the asset, add its sha256 to the pin, and re-run.")
        exit(1)

    if not get_path(cached).exists:
        fetch_herdr(version, asset, cached)
    verify_herdr_checksum(want, cached)
    check_herdr_version(cached, version, cached)
    check_herdr_schema(cached, version)
    // Absolute, because the tests that read this run from wherever cargo puts them: an
    // integration test's working directory is its own package root, so a repo-relative
    // path resolves under crates/<name>/ and every daemon-backed test dies at startup.
    return get_path(cached).full_path

// The release assets are named for platform, and there is one binary per pair.
fn herdr_asset_name():
    // Assigned before trimming, deliberately: a method chained straight onto a command
    // does not apply, and the failure is silent - `uname -s` compares as "Darwin\n" and
    // every platform looks like Linux.
    //
    // And assigned to `stdout` rather than a name of its own - this is the line the gate
    // died on, and the note on captures at the top of this file says why.
    stdout = $`uname -s`
    os = stdout.trim()
    stdout = $`uname -m`
    machine = stdout.trim()
    system = os == "Darwin" ? "macos" : "linux"
    arch = machine == "arm64" or machine == "aarch64" ? "aarch64" : "x86_64"
    return "herdr-{system}-{arch}"

fn fetch_herdr(version, asset, cached):
    url = "{HERDR_RELEASES}/v{version}/{asset}"
    print(dim("fetching herdr {version} for this platform - about 18 MB, once"))
    $`mkdir -p {HERDR_DIR}/{version}`
    // -f so an HTML error page never lands on disk looking like a binary.
    stdout, stderr, code = $`curl -fsSL -o {cached}.part {url}` catch:
        print_err(red("could not download herdr {version} from {url}"))
        print_err("Impact: no daemon-backed test can run, so the suite cannot verify the")
        print_err("backend adapter, the mirror, or the input path.")
        print_err("This is the one step that needs the network; everything after it is")
        print_err("offline. Check connectivity, or place the binary at {cached} yourself.")
        print_err(stderr.trim())
        exit(1)
    $`chmod +x {cached}.part && mv {cached}.part {cached}`

// Checked on every run rather than only after a download, because a cached binary can be
// replaced or truncated between runs and the failure would otherwise surface as a daemon
// that will not start.
fn verify_herdr_checksum(want, cached):
    stdout = $`shasum -a 256 {cached}`
    found = stdout.trim().split(" ")[0]
    if found != want:
        print_err(red("{cached} is not the herdr this repo pins."))
        print_err("  expected {want}")
        print_err("  found    {found}")
        print_err("Impact: the corpus was recorded against the pinned bytes, so tests would")
        print_err("be judging a different daemon than the one their oracles came from.")
        print_err("Fix: delete {cached} and re-run to fetch it again.")
        exit(1)

fn check_herdr_version(binary, want, label):
    stdout, stderr, code = $`{binary} --version` catch:
        print_err(red("{label} would not run, so no daemon-backed test can."))
        print_err("Impact: the suite cannot verify the backend adapter, the mirror, or the")
        print_err("input path - the layers most likely to break.")
        print_err(stderr.trim())
        exit(1)
    found = stdout.trim().split(" ")[-1]
    if found != want:
        print_err(red("herdr {want} is required; {label} is {found}."))
        print_err("Impact: herdr's API is explicitly unstable, so a different daemon answers")
        print_err("differently and the suite would be judging the wrong contract.")
        print_err("Fix: unset MUSTER_HERDR to use the pinned build, or re-pin deliberately -")
        print_err("change {HERDR_PIN}, re-record with tools/herdr-probe/probe, read what moved.")
        exit(1)

// herdr generates this from its own request types and fails its own build when the two
// disagree, so it is the daemon's account of its wire rather than ours. Comparing it costs
// a subprocess and catches a whole class of drift before any test runs.
fn check_herdr_schema(binary, version):
    recorded_path = "corpus/herdr-{version}/api-schema.json"
    recorded = read_file(recorded_path) catch:
        print_err(red("{recorded_path} is missing, so nothing pins herdr's wire format."))
        print_err("Impact: a daemon that changed its API would be discovered by a confusing")
        print_err("test failure rather than by a diff naming the method that moved.")
        print_err("Fix: {binary} api schema --json > {recorded_path}")
        exit(1)
    stdout = $`{binary} api schema --json`
    if stdout.trim() != recorded.content.trim():
        print_err(red("herdr {version} reports a different API schema than the one recorded."))
        print_err("Impact: this daemon's wire is not the wire the corpus was recorded")
        print_err("against, so passing tests would prove less than they appear to.")
        print_err("Look at what moved - the schema is one JSON object per method:")
        print_err("  {binary} api schema --json | diff {recorded_path} -")
        print_err("If the change is real and wanted, re-record the corpus in the same")
        print_err("commit so the two never disagree.")
        exit(1)
    print(dim("herdr {version} verified, schema unchanged"))

fn read_pin():
    result = read_file("deps/ghostty.pin") catch:
        print_err(red("deps/ghostty.pin is missing or unreadable."))
        print_err("It names the libghostty commit this tree builds against, so without it")
        print_err("nothing can be built. Restore it from git.")
        exit(1)
    return result.content.trim()

// Everything under deps/ is reproducible from the pin, so the check is only ever
// "is what sits there the commit we asked for". libghostty takes minutes to build and
// changes only when the pin does.
//
// The stamp alone is not enough: a deleted or half-copied artifact leaves the stamp
// saying yes, and the failure then surfaces minutes later as a linker error naming a
// path nobody recognizes.
fn deps_are_current(pin):
    stamp = read_file(BUILT_STAMP) catch:
        return false
    if stamp.content.trim() != pin:
        return false
    for artifact in DEP_ARTIFACTS:
        if not get_path(artifact).exists:
            print(dim("{artifact} is missing; rebuilding libghostty"))
            return false
    return true

fn build_deps():
    pin = read_pin()
    if deps_are_current(pin):
        print(dim("libghostty already built at {pin[:12]}"))
        return

    // Asked for only once there is something to build with it. Every other tier takes deps on
    // the way past now, so checking first would make zig a requirement for running the suite
    // on a tree that has libghostty sitting right there.
    stdout = $`zig version`
    installed = stdout.trim()
    if installed != ZIG_VERSION:
        print_err(red("zig {ZIG_VERSION} is required; found {installed}."))
        print_err("libghostty pins its own minimum, and a mismatch surfaces as a wall of")
        print_err("compiler errors inside ghostty rather than as a version complaint.")
        print_err("Try: brew install zig")
        exit(1)

    print(dim("building libghostty at {pin[:12]} - several minutes on a cold cache"))
    $`mkdir -p {GHOSTTY_DIR}`
    $`git init -q {GHOSTTY_DIR}`
    // A fresh clone and a re-pin take the same path: fetch exactly the one commit.
    $`git -C {GHOSTTY_DIR} remote add origin {GHOSTTY_REPO} 2>/dev/null || true`
    $`git -C {GHOSTTY_DIR} fetch -q --depth 1 origin {pin}`
    $`git -C {GHOSTTY_DIR} checkout -q FETCH_HEAD`

    // Two builds, because -Demit-lib-vt turns the xcframework off: the surface API that
    // the shell renders through, then the VT that the core encodes keys with and the
    // tests read grids from.
    $`cd {GHOSTTY_DIR} && zig build -Doptimize=ReleaseFast -Demit-xcframework=true -Dxcframework-target=native`
    $`cd {GHOSTTY_DIR} && zig build -Doptimize=ReleaseFast -Demit-lib-vt=true`
    write_file(BUILT_STAMP, pin)

// The contract tier is opt-in and never part of the gate: it needs a real herdr on PATH
// and a logged-in GUI session, and the default suite must stay offline and deterministic
// (docs/testing.md). Asking for it alone should not also take the whole gate.
if contract:
    build = true

// Same reasoning as the contract tier, a different missing thing: this one needs docker and
// a container, which a contributor's machine cannot be assumed to have running.
if ssh:
    build = true

if record and not perf:
    print_err(red("--record only means something with --perf."))
    print_err("It records what a perf run measured, so on its own there is nothing to")
    print_err("record and the baseline would be left untouched without saying so.")
    print_err("Try: ./dev --perf --record")
    exit(1)

if proto:
    build = true

// There is nothing to wrap a bundle around until the binary exists.
if bundle:
    build = true

if not (deps or build or test or lint or format or clean or bundle or contract or ssh or perf or latency):
    deps = true
    build = true
    test = true
    lint = true

// A narrowed flag still takes everything it cannot run without, and the two rules below are the
// whole of that chain. Without them the flags are only safe on a tree the full gate has already
// been through, which is the tree the person writing them happens to have - so a fresh checkout
// meets a wall of compiler errors, and the flag that would have prevented it is the one they
// skipped to save the minute.
//
// The suite takes a build, and that is a correctness rule rather than a convenience. The seam's
// Swift types are generated during `build` and committed nowhere, so a suite that skipped it
// compiled the shell against whatever was generated last - green while the schema said
// something else, which is exactly the disagreement `proto/muster.proto` being the one source
// is meant to make impossible. A fresh checkout at least fails loudly; a checkout with a stale
// generated file passes.
if test:
    build = true

// Compiling anything needs libghostty, which is reproduced from a pin rather than checked in.
// Lint is on this list because clippy is a compile - the style half of it needs nothing, but
// the half that runs after the build does. Cheap to demand: a tree that already has libghostty
// answers with one line, and the freshness check below costs a stamp read and four path tests.
if build or lint or perf:
    deps = true

if clean:
    announce("clean")
    $`cargo clean`
    $`swift package clean`

if format:
    announce("format")
    $`cargo fmt --all`
    $`swift format --recursive --in-place Sources Tests Package.swift`

// The cheapest signal this script has, and therefore the first. None of these needs a
// compiler, a dependency or an artifact, so they answer in seconds on a checkout with
// nothing built - and a misplaced brace found after the suite has run costs a minute to
// learn something a second would have said. After --format rather than before, so that
// asking for both means "fix it, then check the fix" rather than a refusal to start.
if lint:
    announce("style")
    $`cargo fmt --all --check`
    $`swift format lint --recursive --strict Sources Tests Package.swift`
    // The probe is a dev tool rather than a component, so it gets a syntax check and
    // no more. It has no test suite of its own; running it needs a real herdr daemon.
    $`python3 -m compileall -q tools`

if deps:
    announce("deps")
    build_deps()

if build:
    announce("build")
    if proto or not proto_is_current():
        generate_proto()
    // The core first: it is the layer the shell will call into, and its errors are the
    // ones a contributor can act on without a window.
    $`cargo build --workspace --all-targets`
    $`swift build`
    stage_helpers()

if bundle:
    announce("bundle")
    build_bundle()

// Clippy is a compile, so it cannot move up with the rest of the style checks - but it
// goes before the suite rather than after it. Which lints are on is declared in Cargo.toml,
// so that cargo, rust-analyzer and this all judge the code the same way; the gate's job is
// only to escalate them, because a warning a contributor can ignore forever is not a rule.
if lint:
    announce("lint")
    $`cargo clippy --workspace --all-targets -- -D warnings`

if test:
    announce("test")

    // Before anything, because a missing or mismatched daemon invalidates the run rather
    // than failing one test in it. Every daemon-backed test spawns this exact binary,
    // handed down through the environment rather than looked up on PATH.
    herdr = herdr_binary()

    // Before the suite, because the corpus is what most of the suite asserts against. A
    // file nobody loads is checked in, never run, and indistinguishable from coverage -
    // and no driver can catch that, since the check is about the file it never opened.
    stdout, stderr, code = $`python3 tools/corpus-lint.py` catch:
        print_err(stdout.trim())
        print_err(stderr.trim())
        exit(1)
    print(dim(stdout.trim()))

    // A suite that quietly stops running is worse than a red one: it reports green
    // forever. cmux shipped CI passing with "Executed 0 tests" for a while, and
    // docs/testing.md takes that as a standing hazard, so ask what the runner can see
    // before trusting what it reports.
    //
    // Note that a healthy run prints "Executed 0 tests" too - that is the empty XCTest
    // suite sitting alongside swift-testing - so the run's own output cannot be the
    // signal here.
    // Both suites get the same treatment, because adding a second language doubles the
    // places a suite can quietly stop running.
    stdout, stderr, code = $`cargo test --workspace -- --list` catch:
        print_err(red("Rust test discovery failed, so that suite never ran."))
        print_err("Until it does, nothing below has been verified. Compiler output:")
        print_err(stderr.trim())
        exit(1)

    // One line per test, each ending in ": test"; the per-binary totals land between them.
    rust_tests = stdout.split_lines().filter(fn(line) line.ends_with(": test"))
    if len(rust_tests) == 0:
        fail_empty_suite("Rust", "Usual causes: a crate dropped out of the workspace members, or a tests/ file was renamed. Try: cargo test --workspace -- --list")

    print(dim("{len(rust_tests)} Rust test(s) discovered"))
    // Handed down rather than looked up: a test that found its own herdr could find a
    // different one than the run verified, and would report on a daemon nobody pinned.
    $`MUSTER_HERDR={herdr} cargo test --workspace`

    stdout, stderr, code = $`swift test list` catch:
        if matches(stderr, "no tests found", partial=true):
            fail_empty_suite("Swift", "Try: swift test list")
        print_err(red("Swift test discovery failed, so that suite never ran."))
        print_err("Until it does, nothing below has been verified. Compiler output:")
        print_err(stderr.trim())
        exit(1)

    // Names land on stdout and build chatter on stderr, so every non-empty line is a
    // test.
    tests = stdout.trim().split_lines().filter(fn(line) line.trim() != "")
    if len(tests) == 0:
        fail_empty_suite("Swift", "Usual causes: a test target dropped out of Package.swift, or tests moved out of Tests/. Try: swift test list")

    print(dim("{len(tests)} Swift test(s) discovered"))
    $`swift test`

if contract:
    announce("contract")
    // The only check that runs the app itself. Everything else fakes one side or the
    // other; this spawns a real herdr, launches the real binary against it, and reads the
    // run log to see what actually connected.
    stdout, stderr, code = $`python3 tools/smoke-launch.py` catch:
        print_err(red("The app did not launch cleanly against a real daemon."))
        print_err(stdout.trim())
        print_err(stderr.trim())
        exit(1)
    print(stdout.trim())

if ssh:
    announce("ssh")
    run_ssh_tier()

if perf:
    announce("perf")
    // Release, always. A debug build runs several times slower than what ships, so a budget
    // measured there describes a binary nobody uses - and it would report headroom the
    // shipped binary does not have.
    $`cargo build --release --bin muster-perf`
    if record:
        stdout, stderr, code = $`target/release/muster-perf --record` catch:
            fail_perf(stdout, stderr, code)
    else:
        stdout, stderr, code = $`target/release/muster-perf` catch:
            fail_perf(stdout, stderr, code)
    print(stdout.trim())

if latency:
    announce("latency")
    // Reported rather than gated. It needs a real daemon, and the number it produces is
    // mostly herdr's render cadence rather than Muster's cost - so a threshold here would
    // fail builds over a dependency's behavior. ./dev --perf gates what is ours.
    stdout, stderr, code = $`python3 tools/latency.py` catch:
        print_err(red("Input-to-glyph could not be measured, so nothing was learned."))
        print_err(stdout.trim())
        print_err(stderr.trim())
        exit(1)
    print(stdout.trim())

print(green("\n✓ ok"))
