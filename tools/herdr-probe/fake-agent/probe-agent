#!/bin/sh
# A fake coding agent, for probing herdr and for the devenv fixture.
#
# herdr learns an agent's state two ways: by analyzing the pane's screen against a
# detection manifest, or by the agent reporting its own lifecycle. This fake uses the
# reporting path - it both paints a marker line and calls `herdr pane report-agent`,
# so its state is driven, not inferred, and a test never waits on screen scraping.
#
# Screen detection is deliberately not used here: custom manifests need an agent id
# that exists in herdr's known-agent enum, and overriding a stock manifest did not
# make its rules fire in a headless daemon (see docs/observations/herdr-0.8.0.md).
#
# Commands, one per line: working | blocked | idle | quit
# It reports `idle` on start, so a pane running it is a live agent immediately.
#
# POSIX sh with no dependencies beyond herdr itself, so the same script runs in the
# devenv container and on macOS - local and remote fixtures cannot drift.

state=idle
tick=0

paint() {
    printf '\033[2J\033[H'
    printf 'probe-agent - fake coding agent\n'
    printf 'tick %s\n\n' "$tick"
    printf 'PROBE-STATE:%s\n' "$(echo "$state" | tr '[:lower:]' '[:upper:]')"
}

report() {
    [ -n "$HERDR_PANE_ID" ] || return 0
    herdr pane report-agent "$HERDR_PANE_ID" \
        --source probe-agent --agent probe --state "$state" >/dev/null 2>&1 || true
}

paint
report

while IFS= read -r line; do
    tick=$((tick + 1))
    case "$line" in
        *working*) state=working ;;
        *blocked*) state=blocked ;;
        *idle*)    state=idle ;;
        *quit*)    exit 0 ;;
        # Emit raw bytes without touching state, so mode-setting sequences can be
        # injected into the stream mid-scenario.
        raw:*)     printf '%b' "${line#raw:}"; continue ;;
    esac
    paint
    report
done
