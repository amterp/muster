#!/usr/bin/env python3
"""Observe a real herdr daemon and record what it does.

Everything in docs/architecture.md about the backend was read out of herdr's source
rather than watched on the wire. This probe watches it, and saves raw transcripts so
the next herdr release can be re-observed instead of re-argued.

Each run spawns its own daemon under a scratch config dir; it never touches the one
holding your sessions.

    ./probe                     # every scenario
    ./probe frames input-path   # a subset
    ./probe --list
"""

from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
import traceback
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from herdrprobe import scenarios
from herdrprobe.client import ProtectedSocketError
from herdrprobe.daemon import DEFAULT_ROOT, IsolatedDaemon
from herdrprobe.recorder import Recorder
from herdrprobe.remote import RemoteDaemon

REPO_ROOT = Path(__file__).resolve().parents[2]
DEFAULT_CORPUS = REPO_ROOT / "corpus"
HERDR_PIN = REPO_ROOT / "deps/herdr.pin"


def pinned_herdr() -> str:
    """The same binary the suite runs against, not whatever is on PATH.

    The corpus is the oracle the tests are judged by, so recording it with a different
    daemon than the tests use would reintroduce exactly the drift the pin exists to
    remove - and it would do it silently, since both daemons answer.
    """
    pin = json.loads(HERDR_PIN.read_text())
    binary = REPO_ROOT / "deps/herdr" / pin["version"] / "herdr"
    if not binary.is_file():
        sys.exit(
            f"no pinned herdr at {binary}.\n"
            f"  Impact: a recording made with another daemon would become the oracle the\n"
            f"  suite is judged against, while looking like a normal corpus.\n"
            f"  Fix: ./dev -t downloads and verifies it, or pass --herdr explicitly."
        )
    return str(binary)


def herdr_identity(herdr_bin: str) -> tuple[str, int]:
    out = subprocess.run([herdr_bin, "--version"], capture_output=True, text=True, check=True).stdout
    version = out.strip().split()[-1]
    status = subprocess.run([herdr_bin, "api", "schema"], capture_output=True, text=True, check=False).stdout
    protocol = 0
    for line in status.splitlines():
        if line.startswith("protocol:"):
            protocol = int(line.split(":", 1)[1].strip())
    return version, protocol


def remote_identity(key: Path, port: int) -> tuple[str, int]:
    daemon = RemoteDaemon(key, port=port)
    version = daemon.ssh("herdr --version").stdout.strip().split()[-1]
    protocol = 0
    for line in daemon.ssh("herdr api schema").stdout.splitlines():
        if line.startswith("protocol:"):
            protocol = int(line.split(":", 1)[1].strip())
    return version, protocol


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("scenarios", nargs="*", help="scenarios to run (default: all)")
    parser.add_argument("--list", action="store_true", help="list scenarios and exit")
    parser.add_argument("--root", type=Path, default=DEFAULT_ROOT,
                        help=f"scratch dir for the probe's daemon (default: {DEFAULT_ROOT})")
    parser.add_argument("--corpus", type=Path, default=None,
                        help="where transcripts land (default: <repo>/corpus/herdr-<version>)")
    parser.add_argument("--herdr", default=None,
                        help="herdr binary to observe (default: the one deps/herdr.pin names)")
    parser.add_argument("--keep", action="store_true", help="leave the daemon running afterwards")
    parser.add_argument("--remote", action="store_true",
                        help="observe the devenv container's daemon over SSH instead of a local one")
    parser.add_argument("--remote-port", type=int, default=2222)
    args = parser.parse_args()

    if args.list:
        for name in scenarios.ALL:
            print(name)
        return 0

    selected = args.scenarios or list(scenarios.ALL)
    unknown = [s for s in selected if s not in scenarios.ALL]
    if unknown:
        print(f"unknown scenario(s): {', '.join(unknown)}\n"
              f"  Known: {', '.join(scenarios.ALL)}", file=sys.stderr)
        return 2

    if args.remote:
        key = REPO_ROOT / "devenv" / ".ssh" / "id_ed25519"
        if not key.exists():
            print(f"no devenv key at {key}.\n"
                  f"  Impact: the probe cannot reach the container's daemon.\n"
                  f"  Run ./devenv/devenv up first - it generates the keypair.", file=sys.stderr)
            return 4
        probe_daemon = lambda: RemoteDaemon(key, port=args.remote_port)
        version, protocol = remote_identity(key, args.remote_port)
        suffix = "-linux"
    else:
        herdr_bin = args.herdr or pinned_herdr()
        probe_daemon = lambda: IsolatedDaemon(args.root, herdr_bin=herdr_bin)
        version, protocol = herdr_identity(herdr_bin)
        suffix = ""

    corpus = args.corpus or (DEFAULT_CORPUS / f"herdr-{version}{suffix}")
    print(f"herdr {version} (protocol {protocol}){' via devenv' if args.remote else ''} -> {corpus}")

    failures = []
    for name in selected:
        print(f"\n[{name}]", flush=True)
        if not args.remote:
            shutil.rmtree(args.root, ignore_errors=True)
        daemon = probe_daemon()
        daemon.prepare()
        rec = Recorder(corpus, name, version, protocol)
        # A traceback from a run that has since been fixed sits beside a good recording
        # and reads as if the recording were the broken one. Cleared before the attempt
        # rather than after, so a crash mid-write cannot leave one behind either.
        (rec.dir / "FAILURE.txt").unlink(missing_ok=True)
        try:
            daemon.start()
            print(f"    daemon: {daemon.socket_path}", flush=True)
            scenarios.ALL[name](daemon, rec)
        except ProtectedSocketError as exc:
            print(f"\nrefused to run: {exc}", file=sys.stderr)
            return 3
        except Exception:
            failures.append(name)
            rec.write_text("FAILURE.txt", traceback.format_exc())
            print(f"    FAILED - traceback in {rec.dir / 'FAILURE.txt'}", file=sys.stderr, flush=True)
        finally:
            facts = rec.finish()
            print(f"    {len(facts)} facts -> {rec.dir}", flush=True)
            if not args.keep:
                daemon.stop()

    # A remote run stops the container's daemon on the way out of its last scenario, and the
    # container is a fixture other things share - the remote test tier, ./devenv/devenv
    # status. Left stopped, every one of them fails with a socket that opens and refuses.
    if args.remote:
        probe_daemon().leave_running()

    if failures:
        where = ("docker exec muster-devenv cat /home/dev/herdr-server.out" if args.remote
                 else f"{args.root}/config/herdr/herdr-server.log")
        print(f"\n{len(failures)} scenario(s) failed: {', '.join(failures)}.\n"
              f"  Impact: the findings doc cannot cite evidence that was never recorded.\n"
              f"  Look at the FAILURE.txt in each, and at the daemon's own log: {where}",
              file=sys.stderr)
        return 1
    print(f"\nall {len(selected)} scenario(s) recorded under {corpus}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
