#!/usr/bin/env python3
"""Builds the daemon's and detection's Linux tests here, and packs what running them needs.

    tools/linux-run/build-tests <target> <tarball>

For CI, where the build runs on a macOS runner, which has the toolchain `./dev` sets up, and
the tests on a Linux runner, which has none of it. The tarball holds, under this checkout's
paths, the test executables, the daemon they start, and the daemon's data directory, which
the tests find through paths compiled into them. `manifest` in it says where this checkout
was, which `tools/linux-run/ci` mounts the Linux checkout at so those paths resolve, and each
executable with the package directory cargo would run it from.
"""

from __future__ import annotations

import json
import subprocess
import sys
import tarfile
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
PACKAGES = ("muster-daemon", "muster-detect")
DATA = Path("deps/ghostty/zig-out/muster-daemon-data")


def main() -> int:
    if len(sys.argv) != 3:
        print(__doc__, file=sys.stderr)
        return 2
    target, tarball = sys.argv[1], Path(sys.argv[2]).resolve()
    command = ["cargo", "test", "--target", target, "--no-run", "--message-format=json-render-diagnostics"]
    for package in PACKAGES:
        command += ["-p", package]
    built = subprocess.run(command, cwd=REPO, stdout=subprocess.PIPE, text=True)
    if built.returncode != 0:
        print(f"build-tests: the {target} tests did not build", file=sys.stderr)
        return 1

    tests: list[tuple[Path, Path]] = []
    daemon = None
    for line in built.stdout.splitlines():
        message = json.loads(line)
        if message.get("reason") != "compiler-artifact" or not message.get("executable"):
            continue
        executable = Path(message["executable"]).relative_to(REPO)
        if message["profile"]["test"]:
            package = Path(message["manifest_path"]).parent.relative_to(REPO)
            tests.append((package, executable))
        elif message["target"]["name"] == "muster-daemon":
            daemon = executable
    # A test binary cargo did not rebuild is still reported, so an empty list is a real fault.
    if not tests:
        print(f"build-tests: cargo reported no {target} test executables", file=sys.stderr)
        return 1
    if daemon is None:
        # --no-run builds the binary the integration tests name, but reports it only when it
        # is rebuilt; it is where cargo always puts it.
        daemon = Path("target") / target / "debug" / "muster-daemon"
    if not (REPO / daemon).is_file() or not (REPO / DATA).is_dir():
        print(f"build-tests: missing {daemon} or {DATA}; run ./dev -d first", file=sys.stderr)
        return 1

    manifest = REPO / "target" / target / "linux-run-manifest"
    lines = [f"root\t{REPO}"] + [f"test\t{package}\t{executable}" for package, executable in tests]
    manifest.write_text("\n".join(lines) + "\n")
    with tarfile.open(tarball, "w:gz") as tar:
        for path in [daemon, DATA, manifest.relative_to(REPO)] + [exe for _, exe in tests]:
            tar.add(REPO / path, arcname=str(path))
    print(f"build-tests: {len(tests)} test executable(s) for {target} in {tarball}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
