#!/bin/sh
# Runs one Linux test binary in a container: cargo's runner for the musl targets
# (.cargo/config.toml), so `cargo test --target <arch>-unknown-linux-musl` runs on Linux.
#
# The checkout is mounted at its own path, so the paths cargo compiled into the tests -
# CARGO_BIN_EXE_muster-daemon, CARGO_MANIFEST_DIR - point at the same files inside. Only
# RUST_* and MUSTER_WAIT_LOG cross over: this Mac's other variables, a pane's MUSTER_SOCKET
# among them, mean nothing in the container or something wrong.
set -eu
platform=$1
shift

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
# Tagged by the Dockerfile's content, so an edited Dockerfile is a new image rather than a
# stale one reused.
tag="muster-linux-run:$(echo "$platform" | tr / -)-$(shasum -a 256 "$here/Dockerfile" | cut -c1-12)"
if ! docker image inspect "$tag" >/dev/null 2>&1; then
    # Built from a public base image, which needs no credentials - and asking Docker Desktop's
    # credential helper for them is where a build once sat for 37 minutes at no CPU. So the build
    # gets a docker config of its own: this one's context and plugins, and no credential store.
    # Under target/, rewritten each time rather than made and removed.
    real=${DOCKER_CONFIG:-$HOME/.docker}
    config="$root/target/linux-run-docker"
    mkdir -p "$config"
    for shared in contexts cli-plugins; do
        if [ -e "$real/$shared" ]; then
            ln -sfn "$real/$shared" "$config/$shared"
        fi
    done
    printf '{"currentContext": "%s"}\n' "$(docker context show)" > "$config/config.json"
    DOCKER_CONFIG=$config docker build -q --platform "$platform" -t "$tag" "$here" >/dev/null
fi

# Where the binaries were built, which is this checkout unless they were built elsewhere and
# brought here (tools/linux-run/ci): the checkout is mounted there, so the paths compiled into
# them resolve.
mount=${MUSTER_LINUX_ROOT:-$root}

# --init puts a reaping init at pid 1, as a real machine has: a daemon that hands its panes
# over exits, and whoever adopts their processes must reap them, which a test binary at pid 1
# never would.
set -- --rm --init --platform "$platform" --user "$(id -u):$(id -g)" \
    -v "$root:$mount" -w "$mount${PWD#"$root"}" -e HOME=/tmp "$tag" "$@"
for name in $(env | sed -n 's/^\(RUST_[A-Za-z0-9_]*\)=.*/\1/p') MUSTER_WAIT_LOG; do
    if [ -n "$(printenv "$name" || true)" ]; then
        set -- -e "$name" "$@"
    fi
done
exec docker run "$@"
