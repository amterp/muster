#!/usr/bin/env python3
"""Generate the key tables Muster's input path needs, from the pinned ghostty.

Two tables, and neither can be hand-maintained. `Key` is the physical-key vocabulary
Muster speaks in its own core, so nothing libghostty-shaped reaches the keymap or the
tests. `Key.ghosttyKey` maps it onto libghostty-vt's enum at the encoder seam. Both are
derived from ghostty's own source at the pinned commit, so a pin bump that renames or
renumbers a key fails the drift test instead of producing a keyboard where a few keys
quietly do nothing.

    tools/gen-keycodes/gen-keycodes    # rewrites both generated files

Sources, both read-only:
  deps/ghostty/src/input/keycodes.zig                   macOS keycode <-> W3C DOM code
  deps/ghostty/zig-out/include/ghostty/vt/key/event.h   the GhosttyKey enum

Naming: a DOM code (`ArrowUp`, `Digit0`) names its GhosttyKey member (`GHOSTTY_KEY_ARROW_UP`,
`GHOSTTY_KEY_DIGIT_0`) by splitting at lowercase-to-uppercase and lowercase-to-digit
boundaries and upper-casing the pieces - except `Key<Letter>`, which collapses to just the
letter (`KeyA` -> `GHOSTTY_KEY_A`), because the enum's own prefix already says "key".

That name is derived straight from the DOM code rather than read out of ghostty's own
`code_to_key` map in keycodes.zig, because that map is a hand-curated subset: it has no
entry for `AudioVolumeMute`, `IntlBackslash`, `IntlRo`, `IntlYen`, or `NumpadComma`, all of
which have real macOS keycodes and real GhosttyKey members. Trusting the map would carry
that gap into Muster as dead keys. Every derived name is instead validated against the
enum parsed from event.h, so a pin bump that breaks the naming rule fails this script
loudly instead of shipping a keyboard with keys that silently do nothing.
"""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
KEYCODES_ZIG = REPO / "deps/ghostty/src/input/keycodes.zig"
EVENT_H = REPO / "deps/ghostty/zig-out/include/ghostty/vt/key/event.h"
PIN = REPO / "deps/ghostty.pin"
SHELL_OUT = REPO / "Sources/MusterMac/KeyNames.generated.swift"
RUST_CORE_OUT = REPO / "crates/muster-core/src/input/key.rs"
RUST_VT_OUT = REPO / "crates/muster-vt/src/key_mapping.rs"

# Swift keywords that cannot be bare case names.
RESERVED = {"return", "default", "in", "for", "switch", "case", "break", "continue"}

# DOM codes with a real macOS keycode but no matching GhosttyKey member: Lang1 and Lang2
# are kVK_JIS_Kana and kVK_JIS_Eisu, keys that exist only on JIS keyboards. Chromium's DOM
# code table (which keycodes.zig is drawn from) carries them; ghostty's GhosttyKey enum
# does not, so there is no key identity to map them to. Excluded here on purpose, not
# because validation failed to notice them - re-check this set on every ghostty upgrade,
# since a pin bump that finally adds a matching GhosttyKey member should start using it.
KNOWN_UNMAPPABLE_MAC_CODES = {"Lang1", "Lang2"}


def die(message: str) -> None:
    print(f"gen-keycodes: {message}", file=sys.stderr)
    sys.exit(1)


def c_enum_names() -> list[str]:
    """Every GhosttyKey member, in declaration order, prefix included."""
    text = EVENT_H.read_text()
    body = re.search(r"GHOSTTY_KEY_UNIDENTIFIED = 0,(.*?)GHOSTTY_KEY_MAX_VALUE", text, re.S)
    if not body:
        die(f"could not find the GhosttyKey enum in {EVENT_H}")
    names = ["GHOSTTY_KEY_UNIDENTIFIED"]
    names += re.findall(r"^\s*(GHOSTTY_KEY_[A-Z0-9_]+),\s*$", body.group(1), re.M)
    if len(names) < 100:
        die(f"only {len(names)} keys parsed from {EVENT_H}; the enum shape must have changed")
    if len(names) != len(set(names)):
        die(f"duplicate GhosttyKey member parsed from {EVENT_H}")
    return names


def raw_entries() -> list[tuple[str, str]]:
    """(macOS keycode hex, W3C DOM code) for every row in raw_entries, unfiltered.

    Column 4 is the Mac keycode; 0xffff means the platform has no code for that key.
    Filtering happens downstream, and differently for the two tables that need it: the
    macOS switch only wants rows with a real keycode, but a key's DOM code (for Key's raw
    value) is worth capturing even on rows where macOS has none, e.g. PrintScreen.
    """
    text = KEYCODES_ZIG.read_text()
    block = re.search(r"pub const raw_entries: \[\]const RawEntry = &\.\{(.*?)\n\};", text, re.S)
    if not block:
        die(f"could not find raw_entries in {KEYCODES_ZIG}")

    # Drop commented-out rows before matching, so a documentation example with a real-
    # looking code (there are several, all currently empty-coded) can never leak in.
    live_lines = (line for line in block.group(1).splitlines() if not line.strip().startswith("//"))
    body = "\n".join(live_lines)

    pattern = (
        r"\.\{\s*0x[0-9a-fA-F]+,\s*0x[0-9a-fA-F]+,\s*0x[0-9a-fA-F]+,\s*0x[0-9a-fA-F]+,\s*"
        r"(0x[0-9a-fA-F]+),\s*\"([^\"]*)\"\s*\}"
    )
    rows = re.findall(pattern, body)
    if len(rows) < 200:
        die(f"only {len(rows)} raw_entries rows parsed; the table shape must have changed")
    return rows


def derive_c_name(dom_code: str) -> str:
    """The GhosttyKey member a DOM code should name, by ghostty's own convention.

    See the module docstring for the rule. `KeyA` -> `GHOSTTY_KEY_A`, `Digit0` ->
    `GHOSTTY_KEY_DIGIT_0`, `AudioVolumeMute` -> `GHOSTTY_KEY_AUDIO_VOLUME_MUTE`.
    """
    if re.fullmatch(r"Key[A-Z]", dom_code):
        suffix = dom_code[3:]
    else:
        suffix = re.sub(r"(?<=[a-z])(?=[A-Z])", "_", dom_code)
        suffix = re.sub(r"(?<=[a-z])(?=[0-9])", "_", suffix)
        suffix = suffix.upper()
    return f"GHOSTTY_KEY_{suffix}"


def dom_codes_for_known_keys(rows: list[tuple[str, str]], known: set[str]) -> dict[str, str]:
    """DOM code for every GhosttyKey member that has one, keyed by full C name.

    A code whose derived name is not a real GhosttyKey member is one of the DOM codes
    ghostty never modeled at all (media/legacy codes like `Hyper` or `Open`, which have no
    macOS keycode either - see mac_keycode_table) and is dropped here without complaint.
    Only mac_keycode_table treats an unresolved name as an error, because only there does
    it mean an actual physical key with nowhere to go.
    """
    dom_for_c: dict[str, str] = {}
    for _mac, code in rows:
        if not code:
            continue
        c_name = derive_c_name(code)
        if c_name not in known:
            continue
        if c_name in dom_for_c and dom_for_c[c_name] != code:
            die(f"DOM codes {dom_for_c[c_name]!r} and {code!r} both derive {c_name}")
        dom_for_c[c_name] = code
    return dom_for_c


def mac_keycode_table(rows: list[tuple[str, str]], known: set[str]) -> dict[int, str]:
    """macOS virtual keycode -> GhosttyKey C name, for every key macOS names."""
    table: dict[int, str] = {}
    for mac_hex, code in rows:
        if not code or mac_hex.lower() == "0xffff":
            continue
        c_name = derive_c_name(code)
        if c_name not in known:
            if code in KNOWN_UNMAPPABLE_MAC_CODES:
                continue
            die(
                f"DOM code {code!r} has macOS keycode {mac_hex} and derives {c_name}, which "
                f"is not in the GhosttyKey enum parsed from event.h. If this key genuinely "
                f"has no GhosttyKey identity, add {code!r} to KNOWN_UNMAPPABLE_MAC_CODES with "
                f"a comment saying why; otherwise derive_c_name() is naming it wrong."
            )
            continue
        mac = int(mac_hex, 16)
        if mac in table and table[mac] != c_name:
            die(f"macOS keycode {mac_hex} maps to both {table[mac]} and {c_name}")
        table[mac] = c_name
    if len(table) < 80:
        die(f"only {len(table)} macOS keycodes resolved; the table shape must have changed")
    return table


def swift_name(c_name: str) -> str:
    """lowerCamelCase of a C enum member, minus its prefix.

    GHOSTTY_KEY_ARROW_UP -> arrowUp, GHOSTTY_KEY_DIGIT_0 -> digit0. The single letters
    become keyA..keyZ rather than a..z, matching ghostty's own zig spelling and keeping
    them readable at a call site.
    """
    stem = c_name.removeprefix("GHOSTTY_KEY_").lower()
    if len(stem) == 1 and stem.isalpha():
        stem = f"key_{stem}"
    head, *rest = stem.split("_")
    name = head + "".join(part.capitalize() for part in rest)
    return f"`{name}`" if name in RESERVED else name


def rust_name(c_name: str) -> str:
    """UpperCamelCase of a C enum member, minus its prefix.

    The same derivation as `swift_name`, capitalized, so the two languages name one key
    the same way up to their conventions. Rust's keywords are all lowercase, so unlike
    Swift there is nothing here to escape - but a future ghostty key called `Self` would
    be a compile error rather than a wrong answer, which is the acceptable failure.
    """
    name = swift_name(c_name).strip("`")
    return name[0].upper() + name[1:]


def emit_rust(pin: str, names: list[str], dom_for_c: dict[str, str]) -> str:
    """The same vocabulary, for the core that will own it.

    Rust carries no macOS keycode table: translating a platform's keycodes is the shell's
    job, and the shell is per-OS. What crosses into the core is the W3C name.
    """
    lines = [
        header(pin),
        "// 176 keys, so the tables below are as long as the vocabulary is. Generated code",
        "// is not the place to argue with a style lint.",
        "#![allow(clippy::too_many_lines)]",
        "",
        "/// A physical key, named as the W3C UI Events code standard names it.",
        "///",
        "/// Layout-independent: this is the key's place on the keyboard, not the character",
        "/// it produces. The `a` key on a US layout and the `ф` key on a Russian one are",
        "/// both `KeyA`, and what the layout produced travels separately as text.",
        "#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord)]",
        "pub enum Key {",
    ]
    lines += [f"    {rust_name(c)}," for c in names]
    lines += ["}", "", "impl Key {"]
    lines += [
        "    /// Every key, in the order libghostty declares them.",
        f"    pub const ALL: [Key; {len(names)}] = [",
    ]
    lines += [f"        Key::{rust_name(c)}," for c in names]
    lines += [
        "    ];",
        "",
        "    /// The name this key travels under: into the corpus, the log, and the schema",
        "    /// the shell and core speak. A key is only ever spelled this way outside the",
        "    /// process.",
        "    pub fn as_str(self) -> &'static str {",
        "        match self {",
    ]
    for c in names:
        raw = dom_for_c.get(c, c.removeprefix("GHOSTTY_KEY_").lower())
        lines.append(f'            Key::{rust_name(c)} => "{raw}",')
    lines += [
        "        }",
        "    }",
        "",
        "    /// Reads a W3C code, or nothing.",
        "    ///",
        "    /// Failing rather than falling back to `Unidentified`: a corpus case or a config",
        "    /// file that misspells a key should say so, not quietly test a key nobody pressed.",
        "    pub fn parse(name: &str) -> Option<Key> {",
        "        match name {",
    ]
    for c in names:
        raw = dom_for_c.get(c, c.removeprefix("GHOSTTY_KEY_").lower())
        lines.append(f'            "{raw}" => Some(Key::{rust_name(c)}),')
    lines += ["            _ => None,", "        }", "    }", "}", ""]
    return "\n".join(lines)


def emit_rust_mapping(pin: str, names: list[str]) -> str:
    """Muster's key vocabulary onto libghostty-vt's, for the Rust encoder seam.

    bindgen prefixes a C enum's constants with the enum type name, so the member is
    `GhosttyKey_GHOSTTY_KEY_ARROW_UP`. That spelling is bindgen's rather than ghostty's,
    which is why it is generated here instead of typed out: a bindgen upgrade that changed
    it would break the build loudly, and a hand-written table would have to be found.
    """
    lines = [
        header(pin),
        "// One arm per key, which is what a complete mapping looks like.",
        "#![allow(clippy::too_many_lines)]",
        "",
        "use muster_core::input::Key;",
        "",
        "use crate::ffi;",
        "",
        "/// This key as libghostty-vt names it.",
        "///",
        "/// The encoder seam, and the only place the two vocabularies meet.",
        "pub(crate) fn ghostty_key(key: Key) -> ffi::GhosttyKey {",
        "    match key {",
    ]
    lines += [f"        Key::{rust_name(c)} => ffi::GhosttyKey_{c}," for c in names]
    lines += ["    }", "}", ""]
    return "\n".join(lines)


def header(pin: str) -> str:
    return (
        "// Generated by tools/gen-keycodes/gen-keycodes from libghostty at\n"
        f"// {pin}. Do not edit by hand: re-run the generator.\n"
    )


def main() -> int:
    pin = PIN.read_text().strip()
    names = c_enum_names()
    known = set(names)
    rows = raw_entries()

    dom_for_c = dom_codes_for_known_keys(rows, known)
    mac_table = mac_keycode_table(rows, known)

    shell = [
        header(pin),
        "",
        "/// The W3C name of the key a macOS virtual keycode identifies.",
        "///",
        "/// The whole of the shell's key vocabulary. Muster's seam carries a key by the name",
        "/// the core and the conformance corpus both speak, so translating into that name is",
        "/// all a shell does with a keystroke's identity - a GTK shell writes its own table",
        "/// producing the same names (docs/testing.md, what stays native).",
        "enum KeyNames {",
        "  /// Nil for a key macOS names and libghostty does not, which today is the two JIS",
        "  /// keys. Those still type their character, so the caller sends them unidentified",
        "  /// with text rather than dropping the keystroke.",
        "  static func name(forMacOSKeycode keycode: UInt16) -> String? {",
        "    switch keycode {",
    ]
    for mac in sorted(mac_table):
        c_name = mac_table[mac]
        raw = dom_for_c.get(c_name, c_name.removeprefix("GHOSTTY_KEY_").lower())
        shell.append(f'    case {mac:#04x}: "{raw}"')
    shell += [
        "    default: nil",
        "    }",
        "  }",
        "}",
        "",
    ]

    SHELL_OUT.parent.mkdir(parents=True, exist_ok=True)
    RUST_CORE_OUT.parent.mkdir(parents=True, exist_ok=True)
    SHELL_OUT.write_text("\n".join(shell))
    RUST_CORE_OUT.write_text(emit_rust(pin, names, dom_for_c))
    RUST_VT_OUT.parent.mkdir(parents=True, exist_ok=True)
    RUST_VT_OUT.write_text(emit_rust_mapping(pin, names))

    subprocess.run(
        ["swift", "format", "--in-place", str(SHELL_OUT)], check=True, cwd=REPO
    )
    subprocess.run(
        ["rustfmt", "--edition", "2024", str(RUST_CORE_OUT), str(RUST_VT_OUT)],
        check=True,
        cwd=REPO,
    )

    print(
        f"{len(names)} keys, {len(mac_table)} macOS keycodes -> "
        f"{SHELL_OUT.name}, {RUST_CORE_OUT.name}, {RUST_VT_OUT.name}"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
