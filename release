#!/usr/bin/env rad
---
Cut a Muster release, from the version bump to both Homebrew casks.

Write packaging/release-notes/<version>.md first: it is the one part a script cannot do,
and this refuses to start without it. Then './release minor' bumps the version, takes the
gate and the contract tier, commits, pushes main, waits for CI, tags, waits for the
notarized build, checks the artifact, and points both casks at it.

It pushes main, a tag and both casks without asking: running it is the decision to publish.
Run the same command again after an interruption and it picks up where it stopped.
---
args:
    bump str  # Which part of the last release's version to raise.

    bump enum ["major", "minor", "patch"]

REPO = "amterp/muster"
TAP = "amterp/homebrew-tap"
CASK = "packaging/homebrew/muster.rb"
TAP_CASK = "Casks/muster.rb"
// Each schema whose compatible test holds it to a baseline: the daemon's own protocol, and the
// API for other programs (MIP-10). `version` is the Rust file declaring the schema's version as
// `constant`. `corpus` is the conversations recorded against it, and `shipped` where a release
// keeps them as it shipped them, with the schema they were recorded against, which the corpus is
// held to while the daemon still serves that version (docs/testing.md); the daemon's protocol
// has none, since nothing outside Muster speaks it.
SCHEMAS = [
    {"name": "daemon protocol", "schema": "proto/muster_daemon.proto",
     "baseline": "proto/muster_daemon.v1.baseline.proto",
     "version": "crates/muster-daemon-proto/src/version.rs", "constant": "PROTOCOL",
     "corpus": "", "shipped": ""},
    {"name": "API", "schema": "proto/muster_api.proto",
     "baseline": "proto/muster_api.v0.baseline.proto",
     "version": "crates/muster-api/src/version.rs", "constant": "API",
     "corpus": "corpus/conformance/api-*.json", "shipped": "corpus/api-baseline"},
]
SHIPPED = SCHEMAS.filter(fn(schema) schema["shipped"] != "")

// The cask's line saying its checksum is still the last release's. Its presence is what
// says a release is under way: the bump writes it, and pointing the cask at the published
// artifact removes it. Keeping the state in a file the release commits anyway, rather than
// a file of its own, is what lets a rerun resume without anything to clean up.
fn marker(last, target):
    return "  # Still {last}'s checksum, until the notarized {target} build gives its own."

fn step(name):
    print(bold("\n▸ {name}"))

fn fail(lines):
    print_err(red(lines[0]))
    for line in lines[1:]:
        print_err(line)
    exit(1)

fn workspace_version():
    return quiet $`sed -n '/^\[workspace\.package\]/,$ s/^version *= *"\(.*\)"/\1/p' Cargo.toml | head -1`.stdout.trim()

fn latest_tag():
    tags = quiet $`git tag --list 'v*' --sort=-v:refname`.stdout.trim()
    if tags == "":
        fail(["No v* tag in this checkout, so there is no last release to bump from.",
              "Fetch the tags (git fetch --tags origin), or tag the first release by hand."])
    return tags.split_lines()[0].trim_prefix("v")

fn bumped(version, bump):
    parts = version.split(".")
    major = parse_int(parts[0])
    minor = parse_int(parts[1])
    patch = parse_int(parts[2])
    if bump == "major":
        return "{major + 1}.0.0"
    if bump == "minor":
        return "{major}.{minor + 1}.0"
    return "{major}.{minor}.{patch + 1}"

fn parts_of(version):
    return version.split(".").map(fn(p) parse_int(p))

fn newer(version, than):
    a = parts_of(version)
    b = parts_of(than)
    for i in range(3):
        if a[i] != b[i]:
            return a[i] > b[i]
    return false

// Whether `target` is a `bump` of `version` by any amount: 0.16.0 is a minor bump of 0.14.0 when
// 0.15.0 was bumped and never published.
fn raises(version, target, bump):
    a = parts_of(version)
    b = parts_of(target)
    if bump == "major":
        return b[0] > a[0] and b[1] == 0 and b[2] == 0
    if bump == "minor":
        return b[0] == a[0] and b[1] > a[1] and b[2] == 0
    return b[0] == a[0] and b[1] == a[1] and b[2] > a[2]

fn cask_marker_line():
    for line in read_file(CASK).content.split_lines():
        if line.starts_with("  # Still ") and "'s checksum, until the notarized " in line:
            return line
    return ""

fn schema_version(schema):
    file = schema["version"]
    constant = schema["constant"]
    name = schema["name"]
    for line in read_file(file).content.split_lines():
        if line.starts_with("pub const {constant}: Version"):
            return replace(line, ".*major: (\\d+), minor: (\\d+).*", "$1.$2", regex=true)
    fail(["{file} declares no {constant}, so the {name}'s baseline cannot be brought up to it.",
          "Impact: the release would ship without saying which {name} version it speaks.",
          "Restore the `pub const {constant}: Version` line."])

fn baseline_version(schema):
    baseline = schema["baseline"]
    name = schema["name"]
    for line in read_file(baseline).content.split_lines():
        if line.starts_with("// Version: "):
            return line.trim_prefix("// Version: ").trim()
    fail(["{baseline} has no '// Version:' line in its header.",
          "Impact: nothing says which {name} version the last release shipped, so its",
          "compatible test's baseline cannot be moved forward. Restore the header from git history."])

fn push_main():
    $`git push origin HEAD:main` catch:
        fail(["origin/main refused the push.",
              "Impact: nothing is released until main carries this commit.",
              "Usually somebody pushed in the meantime: fetch, rebase onto origin/main, check",
              "the result still passes ./dev, and run this again."])

// Every run GitHub started for the commit, or only one workflow's, waited on until each has
// finished. A commit no run has appeared for yet is waited on too, for a while: a push
// reaches Actions some seconds before its runs are listed.
fn wait_for_runs(sha, workflow, what):
    waited = 0
    while:
        if workflow == "":
            listed = quiet $`gh run list -R {REPO} --commit {sha} --json name,status,conclusion,url`.stdout
        else:
            listed = quiet $`gh run list -R {REPO} --commit {sha} --workflow {workflow} --json name,status,conclusion,url`.stdout
        runs = parse_json(listed)
        if len(runs) == 0:
            if waited > 300:
                fail(["No {what} run appeared for {sha[:8]} in five minutes.",
                      "Impact: nothing has checked this commit, so it is not tagged or published.",
                      "Check https://github.com/{REPO}/actions, then run this again."])
        else:
            pending = runs.filter(fn(r) r.status != "completed")
            if len(pending) == 0:
                failed = runs.filter(fn(r) r.conclusion != "success")
                if len(failed) > 0:
                    lines = ["{what} failed on {sha[:8]}."]
                    for r in failed:
                        lines += ["  {r.name}: {r.conclusion} - {r.url}"]
                    lines += ["Impact: the release stops here, and nothing is published.",
                              "A failure outside the code - Apple refusing a submission, an expired credential, a",
                              "runner - is re-run in place once fixed: gh run rerun <id> --failed, then run this",
                              "again. A failure in the code means fixing main; a tag already pushed is not moved."]
                    fail(lines)
                print("{what} passed on {sha[:8]}.")
                return
        sleep(30)
        waited += 30

fn verify_artifact(target, dir):
    zip = "Muster-{target}-arm64.zip"
    $`gh release download v{target} -R {REPO} --pattern {zip} --dir {dir} --clobber`
    sha = quiet $`shasum -a 256 {dir}/{zip}`.stdout.split(" ")[0]
    body = quiet $`gh release view v{target} -R {REPO} --json body -q .body`.stdout
    if "sha256 `{sha}`" not in body:
        fail(["The downloaded {zip} hashes to {sha}, which the release body does not name.",
              "Impact: the cask would pin a checksum that does not match what the release says.",
              "Look at https://github.com/{REPO}/releases/tag/v{target} before going further."])
    quiet $`unzip -q -o {dir}/{zip} -d {dir}`
    app = "{dir}/Muster.app"
    plist = quiet $`/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' {app}/Contents/Info.plist`.stdout.trim()
    cli = quiet $`{app}/Contents/MacOS/muster-cli --version`.stdout.trim()
    if plist != target or cli != "muster {target}":
        fail(["The published app says it is {plist}, and its CLI '{cli}', not {target}.",
              "Impact: Launch Services and brew would disagree about which version is installed.",
              "The tag and Cargo.toml must have disagreed; release.yml checks this, so look at its run."])
    $`xcrun stapler validate {app}`
    stdout, stderr, code = $`spctl -a -vv -t exec {app}`
    if "source=Notarized Developer ID" not in "{stdout}{stderr}":
        fail(["Gatekeeper does not accept the published app as notarized.",
              "Impact: a person installing it gets a warning, or a refusal, instead of the app.",
              "What spctl said is above. The release stays published; do not point the casks at it."])
    print("v{target}: {sha}, notarized and stapled.")
    return sha

fn point_cask_at(target, sha):
    text = read_file(CASK).content
    lines = text.split_lines().filter(fn(l) not (l.starts_with("  # Still ") and "'s checksum" in l))
    lines = lines.map(fn(l) (l.starts_with("  sha256 \"") ? "  sha256 \"{sha}\"" : l))
    write_file(CASK, join(lines, "\n") + "\n")
    $`git add {CASK}`
    subject = "chore: the cask names the artifact v{target} ships"
    $`git commit -q -m {subject}`
    code = $`git push origin HEAD:main`.code
    if code != 0:
        // Most likely somebody's board commit landed during the wait. The cask commit
        // touches one file, so it replays onto theirs unless they edited the cask too.
        if not $`git pull --rebase -q origin main`.ok:
            $`git rebase --abort` catch:
                pass
            fail(["The cask commit conflicts with something pushed to main meanwhile.",
                  "Impact: the repo's cask still names the old checksum; the release itself is out.",
                  "Resolve it by hand: the cask wants sha256 {sha} and no 'Still' line."])
        push_main()

fn update_tap(target, dir):
    tap = "{dir}/homebrew-tap"
    $`gh repo clone {TAP} {tap} -- -q`
    $`cp {CASK} {tap}/{TAP_CASK}`
    if $`git -C {tap} diff --quiet`.ok:
        print("The tap already carries this cask.")
        return
    $`git -C {tap} add {TAP_CASK}`
    subject = "muster {target}"
    $`git -C {tap} commit -q -m {subject}`
    $`git -C {tap} push -q origin HEAD`

// ---------------------------------------------------------------------------------------

step("preflight")
if quiet $`git branch --show-current`.stdout.trim() != "main":
    fail(["Releases are cut from main, and this checkout is not on it.",
          "Switch to main, or run this from the checkout that is."])
quiet $`git fetch -q --tags origin`
if not quiet $`git merge-base --is-ancestor origin/main HEAD`.ok:
    fail(["origin/main has commits this checkout does not.",
          "Impact: the release would be built from a tree without them, and pushing main would be refused.",
          "Rebase onto origin/main, check the result still passes ./dev, and run this again."])
if not quiet $`gh auth status -h github.com >/dev/null 2>&1`.ok:
    fail(["gh is not logged in to github.com.",
          "It is how this waits on CI and reads the release. Run: gh auth login"])

current = workspace_version()
latest = latest_tag()
pending_marker = cask_marker_line()

// The version Cargo.toml is bumped from. It is the last release, unless a release was bumped and
// then abandoned before anything was published: that version may already be in somebody's hands
// as a local build, so it is skipped rather than published as a different tree.
base = latest
if pending_marker == "":
    abandoned = current != latest and newer(current, latest) and not quiet $`git ls-remote --tags origin refs/tags/v{current} | grep -q .`.ok
    if abandoned:
        base = current
        print("{current} was bumped and never published, so it is skipped.")
    else if current != latest:
        fail(["Cargo.toml says {current}, but the last release is {latest} and the cask names no release under way.",
              "Impact: there is no telling which version this is meant to release.",
              "Set Cargo.toml back to {latest} to release {bumped(latest, bump)}, or finish {current} by hand."])
    target = bumped(base, bump)
    resuming = false
else:
    target = current
    resuming = true
    tagged = quiet $`git rev-parse -q --verify refs/tags/v{target} >/dev/null`.ok
    if not tagged and not raises(latest, target, bump):
        fail(["A {target} release is under way, which is not a {bump} bump of {latest}.",
              "Run this again with the bump that started it."])
    print("A {target} release is under way: picking up where it stopped.")

notes = "packaging/release-notes/{target}.md"
if not quiet $`test -f {notes}`.ok:
    commits = quiet $`git rev-list --count v{latest}..HEAD`.stdout.trim()
    fail(["No release notes for {target}.",
          "Impact: the GitHub release would say nothing about what changed, and nobody updating learns what to do.",
          "Write {notes}: what somebody updating from {latest} has to know, shaped like",
          "packaging/release-notes/{latest}.md. git log v{latest}..HEAD has the {commits} commits since."])

if not resuming:
    step("{latest} -> {target}")
    if quiet $`git status --porcelain -- . :!{notes}`.stdout.trim() != "":
        fail(["The working tree has changes besides {notes}.",
              "Impact: the release commit would carry them, or the gate would judge a tree that is not the one tagged.",
              "Commit or stash them, then run this again."])

    cargo = read_file("Cargo.toml").content
    if cargo.count("\nversion = \"{base}\"\n") != 1:
        fail(["Cargo.toml has no single 'version = \"{base}\"' line to bump.",
              "Bump [workspace.package] version by hand and run this again."])
    write_file("Cargo.toml", cargo.replace("\nversion = \"{base}\"\n", "\nversion = \"{target}\"\n"))
    quiet $`cargo metadata -q --format-version 1 >/dev/null`

    cask = read_file(CASK).content
    old_version = "  version \"{latest}\"\n"
    if cask.count(old_version) != 1:
        fail(["{CASK} does not name {latest}, so it cannot be moved to {target}.",
              "Impact: brew would keep offering the old version. Fix the cask's version line by hand."])
    write_file(CASK, cask.replace(old_version, "  version \"{target}\"\n{marker(latest, target)}\n"))

    // A schema's minor that ships becomes the baseline its compatible test holds it to, so a
    // later change to the schema is the next minor rather than this one again.
    for schema in SCHEMAS:
        version = schema_version(schema)
        baseline = baseline_version(schema)
        if version != baseline:
            file = schema["baseline"]
            name = schema["name"]
            header = read_file(file).content.split_lines()[:6]
            header = header.map(fn(l) (l == "// Version: {baseline}" ? "// Version: {version}" : l))
            write_file(file, join(header, "\n") + "\n" + read_file(schema["schema"]).content)
            print("The {name} baseline moves from {baseline} to {version}.")

// A gate that went red leaves the bump in the working tree, marker and all, so a rerun has
// to tell a bump that was committed from one that never got that far.
pending_marker = cask_marker_line()
committed = pending_marker != "" and pending_marker in quiet $`git show HEAD:{CASK}`.stdout
if not committed:
    step("gate")
    $`./dev` catch:
        fail(["The gate is red on the {target} tree.",
              "The bump is left in the working tree. Fix what failed and run this again, or",
              "git checkout the bumped files to abandon the release."])
    $`./dev --contract` catch:
        fail(["The contract tier is red on the {target} tree.",
              "The bump is left in the working tree. Fix what failed and run this again, or",
              "git checkout the bumped files to abandon the release."])

    // What the conversations say as this release ships them, with the version they ship as. Only
    // once the gate has passed: the gate is what holds the corpus to the copy the last release
    // left, and replacing the copy first would compare the corpus to itself. Copied whether or
    // not the version moved: while it has not, the gate has just shown the shipped cases are
    // unchanged, and the ones added since are promised from this release on.
    // The schema goes with them, since the check asks it which fields a shipped case could have
    // shown: a field added since stands, and the baseline has moved on by the time it is asked.
    for schema in SHIPPED:
        shipped = schema["shipped"]
        corpus = schema["corpus"]
        $`mkdir -p {shipped} && rm -f {shipped}/*.json && cp {corpus} {shipped}/`
        $`cp {schema["schema"]} {shipped}/`
        write_file("{shipped}/VERSION", schema_version(schema) + "\n")
        print("The {schema["name"]}'s conversations are kept as {target} ships them, in {shipped}.")

    message = "chore: {target}\n\nWhat somebody updating has to know is in\n{notes}, which the release\nworkflow puts above the install lines.\n"
    for schema in SCHEMAS:
        file = schema["baseline"]
        name = schema["name"]
        if not quiet $`git diff --quiet HEAD -- {file}`.ok:
            version = schema_version(schema)
            message += "\nThe {name} ships as {version}, so its schema's baseline\nbecomes {version} here: from now on a change to the schema is the next\nminor.\n"
    for schema in SHIPPED:
        shipped = schema["shipped"]
        if quiet $`git status --porcelain -- {shipped}`.stdout.trim() != "":
            message += "\nThe {schema["name"]}'s recorded conversations are kept in {shipped}\nas {target} ships them, with its schema, and stand while that version\nis served.\n"
    message += "\nThe cask names {target} and still carries {latest}'s checksum, marked\nas such, until the notarized build gives its own.\n"
    message_file = quiet $`mktemp`.stdout.trim()
    write_file(message_file, message)
    baselines = [schema["baseline"] for schema in SCHEMAS]
    shipped = [schema["shipped"] for schema in SHIPPED]
    $`git add Cargo.toml Cargo.lock {CASK} {baselines} {shipped} {notes}`
    $`git commit -q -F {message_file}`

step("publish v{target}")

tag_pushed = quiet $`git ls-remote --tags origin refs/tags/v{target}`.stdout.trim() != ""
if not tag_pushed:
    if quiet $`git rev-parse -q --verify refs/tags/v{target} >/dev/null`.ok:
        sha = quiet $`git rev-list -n 1 v{target}`.stdout.trim()
    else:
        sha = quiet $`git rev-parse HEAD`.stdout.trim()
        if quiet $`git rev-list --count origin/main..HEAD`.stdout.trim() != "0":
            push_main()
        wait_for_runs(sha, "", "CI")
        $`git tag v{target} {sha}`
    $`git push -q origin v{target}`
sha = quiet $`git rev-list -n 1 v{target}`.stdout.trim()
wait_for_runs(sha, "release.yml", "The release build")

step("verify and point the casks at v{target}")
dir = quiet $`mktemp -d`.stdout.trim()
artifact_sha = verify_artifact(target, dir)
if cask_marker_line() != "":
    point_cask_at(target, artifact_sha)
update_tap(target, dir)

if quiet $`which brew >/dev/null`.ok:
    quiet $`brew update -q`
    $`brew fetch --cask amterp/tap/muster` catch:
        fail(["brew could not fetch the new cask.",
              "Impact: brew install and brew upgrade fail for everybody until the tap is fixed.",
              "What brew said is above; check {TAP}'s {TAP_CASK} against {CASK}."])

print(green("\nMuster {target} is out: https://github.com/{REPO}/releases/tag/v{target}"))
