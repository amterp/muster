#!/bin/sh
# A fake agent that the daemon detects by reading its screen.
#
# It paints a marker line and says nothing, so it exercises the path a real coding agent
# takes: the daemon analyzes the pane against a detection manifest and decides. Install
# fake-agent/claude.toml as the override manifest for the markers to mean anything, and
# run this script as `claude` - the daemon identifies the agent from the pane's foreground
# process name (crates/muster-harness/src/agents.rs does both).
#
# Commands, one per line: working | blocked | idle | menu | nomenu | animate | still | quit, or
# notify <text>, which asks the terminal to notify somebody the way Claude Code does in Ghostty
# (OSC 777), or say <text>, which prints the text above its prompt without repainting, as an
# inline agent prints its output: over the line its echo left, with the prompt drawn again below. `menu` paints a menu opened from the prompt, which leaves the state as it was, and
# `nomenu` closes it. `animate` redraws a line above the state's five times a second, whatever the
# state, as an animated statusline or a clock does, and `still` stops it.
#
# Its last line is its prompt, `PROBE-PROMPT> `, left for the terminal's echo of what is typed,
# so a line half typed into it shows there as it would in an agent's prompt.
#
# Every line it reads is also appended to $HOME/fake-agent-heard, which is how a test sees what
# was typed into it (a daemon's doorbell, say) after the screen has been painted over.
#
# SIGUSR1 blocks it at once, without a line read, as an agent at work opens a dialog in the
# middle of a turn while something typed sits unsent in its prompt, and SIGUSR2 puts it back to
# work, as the dialog answered; its process id is in $HOME/fake-agent-pid. Both redraw only the
# state's line, so what sits unsent in the prompt still shows there, as Claude Code redraws its
# prompt box with it once a dialog closes.
#
# The first argument, if any, is how it starts:
# - `starting`: it treats the first line it reads as Claude Code treats what is typed while it
#   starts: the line fills its prompt, its Return is dropped, and nothing is sent until a later
#   Return sends it with whatever was typed after it.
# - `dialog`: blocked from its first frame, as an agent that opens on a question is.
# - `placeholder`: its prompt shows a suggestion nobody typed, faint, until something is.
# A second argument, `unechoed`, turns the terminal's echo off, so what is typed shows only once
# the agent has read a line and painted it: an agent slow to paint, held there for as long as a
# test needs. Any argument `animated` starts it animating, as `animate` does, from its first frame.

state=idle
tick=0
draft=
menu=
placeholder=
signalled=
animator=
case "$1" in
    dialog) state=blocked ;;
    placeholder) placeholder=yes ;;
esac

paint() {
    printf '\033[2J\033[H'
    printf 'screen-agent - fake coding agent, detected by screen\n'
    printf 'tick %s\n\n' "$tick"
    printf 'PROBE-STATE:%s\n' "$(echo "$state" | tr '[:lower:]' '[:upper:]')"
    if [ -n "$menu" ]; then
        printf 'PROBE-MENU\n'
    fi
    printf 'PROBE-PROMPT> %s' "$draft"
    if [ -n "$placeholder" ] && [ -z "$draft" ]; then
        # Drawn faint, then the cursor goes back to where typing starts, as a prompt's does.
        printf '\033[2mtry something\033[22m\033[13D'
    fi
}

if [ "$2" = unechoed ]; then
    stty -echo
fi

animate() {
    if [ -z "$animator" ]; then
        (while :; do printf '\0337\033[2;1Hframe %s\033[K\0338' "$(date +%s)"; sleep 0.2; done) &
        animator=$!
    fi
}

# The state's line alone, the cursor put back where typing goes on.
restate() {
    state=$1
    printf '\0337\033[4;1HPROBE-STATE:%s\033[K\0338' "$(echo "$state" | tr '[:lower:]' '[:upper:]')"
}

printf '%s\n' $$ > "$HOME/fake-agent-pid"
trap 'signalled=yes; restate blocked' USR1
trap 'signalled=yes; restate working' USR2

paint
case " $* " in *" animated "*) animate ;; esac

if [ "$1" = starting ]; then
    IFS= read -r draft
    paint
fi

while :; do
    IFS= read -r line
    read_status=$?
    # A signal's trap has painted, and may have cut the read short: dash then says it failed,
    # as it does at the end of input, while bash reads on.
    if [ -n "$signalled" ]; then
        signalled=
        [ "$read_status" -ne 0 ] && continue
    fi
    [ "$read_status" -ne 0 ] && break
    line=$draft$line
    draft=
    placeholder=
    printf '%s\n' "$line" >> "$HOME/fake-agent-heard"
    case "$line" in
        say\ *)
            printf '\033[1A\r\033[K%s\n\033[KPROBE-PROMPT> ' "${line#say }"
            continue ;;
    esac
    tick=$((tick + 1))
    case "$line" in
        notify\ *) printf '\033]777;notify;Claude Code;%s\a' "${line#notify }" ;;
        *animate*) animate ;;
        *still*)
            [ -n "$animator" ] && kill "$animator"
            animator= ;;
        *nomenu*)  menu= ;;
        *menu*)    menu=yes ;;
        *working*) state=working ;;
        *blocked*) state=blocked ;;
        *idle*)    state=idle ;;
        *quit*)
            [ -n "$animator" ] && kill "$animator"
            exit 0 ;;
    esac
    paint
done
