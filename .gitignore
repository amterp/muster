CLAUDE.md
.DS_Store

# SwiftPM
.build/
.swiftpm/

# The libghostty checkout and its build output. The pin is what we track; ./dev -d
# reproduces everything else from it.
deps/*
!deps/ghostty.pin

# Python bytecode (tools/herdr-probe)
__pycache__/
*.py[cod]

# devenv SSH keypair, generated on first use
devenv/.ssh/

# Rust
target/

# Protobuf, generated on both sides from proto/muster.proto and committed on neither, so
# a shell and a core that disagree is not a state this repo can be in. Rust generates into
# target/ on every cargo build; ./dev regenerates this one when the schema's hash changes.
Sources/MusterMac/Generated/
