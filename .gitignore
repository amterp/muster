CLAUDE.md
.DS_Store

# SwiftPM
.build/
.swiftpm/

# Dependency builds and downloads. The pins are what we track; ./dev reproduces
# everything else from them - libghostty built from source, herdr fetched as a release
# binary and checksummed. rad.pin is the exception ./dev cannot act on, since ./dev is
# written in it; CI reads that one.
deps/*
!deps/ghostty.pin
!deps/herdr.pin
!deps/rad.pin

# Python bytecode (tools/herdr-probe)
__pycache__/
*.py[cod]

# devenv SSH keypair, generated on first use
devenv/.ssh/

# Rust
target/

# Protobuf, generated on both sides from proto/muster.proto and committed on neither, so
# a shell and a core that disagree is not a state this repo can be in. Rust generates into
# target/ on every cargo build; ./dev regenerates this one when the schema's hash changes.
Sources/MusterMac/Generated/
