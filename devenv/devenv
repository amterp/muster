#!/usr/bin/env bash
# Drive the devenv container: the Linux machine Muster's remote path talks to, and the
# fixture the remote tests run against.
#
#   ./devenv/devenv build           build the image, and nothing else
#   ./devenv/devenv up              build and start it
#   ./devenv/devenv down            stop and remove it
#   ./devenv/devenv ssh             shell in as dev
#   ./devenv/devenv status          is it up, and is there a daemon in it
#   ./devenv/devenv rebuild         rebuild the image from scratch, then up
#   ./devenv/devenv port            the port this checkout's container listens on
#   ./devenv/devenv help            this list
#
# Each checkout gets its own container, image, port and key, named after the checkout's path,
# so two worktrees can run the remote tier at once without recreating each other's container.
#
# Nothing here installs a daemon. The image ships without one, because that absence is what
# makes the remote tests test Muster's install path rather than its adopt path.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# The same eight hex digits ./dev --contract names its directory with. The port is derived
# rather than picked by docker so that it survives a recreate, and an ssh config or a Muster
# host pointed at it stays right.
CHECKOUT="$(printf %s "$REPO_ROOT" | shasum -a 256 | cut -c1-8)"
IMAGE="muster-devenv-$CHECKOUT"
CONTAINER="muster-devenv-$CHECKOUT"
PORT=$((22000 + 0x$CHECKOUT % 1000))
KEY="$REPO_ROOT/devenv/.ssh/id_ed25519"

# StrictHostKeyChecking off and a null known-hosts file: the container gets a fresh
# host key every rebuild, and a fixture that demands the developer clear a host-key
# warning after every rebuild is a fixture nobody rebuilds.
SSH_OPTS=(-i "$KEY" -p "$PORT"
          -o StrictHostKeyChecking=no
          -o UserKnownHostsFile=/dev/null
          -o LogLevel=ERROR)

die() { printf '%s\n' "$@" >&2; exit 1; }

usage() {
    cat <<'USAGE'
usage: ./devenv/devenv <command>

  build      build the image, and nothing else
  up         build and start it, recreating a container on an older image or key
  down       stop and remove it
  ssh        shell in as dev
  status     is it up, and is there a daemon in it
  rebuild    rebuild the image from scratch, then up
  port       the port this checkout's container listens on
  help       this list
USAGE
}

need_docker() {
    command -v docker >/dev/null 2>&1 || die \
        "docker is not on PATH." \
        "  Impact: the devenv container cannot be built or started, so the remote path has nothing to talk to." \
        "  Install Docker Desktop, or point this script at another OCI runtime."
    docker info >/dev/null 2>&1 || die \
        "docker is installed but not responding." \
        "  Impact: same as above - no container, no remote path." \
        "  Start Docker Desktop and try again."
}

ensure_key() {
    [[ -f "$KEY" ]] && return
    mkdir -p "$(dirname "$KEY")"
    ssh-keygen -t ed25519 -N '' -C muster-devenv -f "$KEY" >/dev/null
    echo "generated a devenv keypair at devenv/.ssh/ (gitignored)"
}

build() {
    ensure_key
    docker build \
        --build-arg DEV_PUBKEY="$(cat "$KEY.pub")" \
        -t "$IMAGE" -f "$REPO_ROOT/devenv/Dockerfile" "$@" "$REPO_ROOT"
}

# Whether the running container runs the image `build` just produced. A running container keeps
# the image it started from, so an edited Dockerfile reaches it only once it is recreated.
image_matches() {
    [[ "$(docker inspect -f '{{.Image}}' "$CONTAINER" 2>/dev/null)" == \
       "$(docker image inspect -f '{{.Id}}' "$IMAGE" 2>/dev/null)" ]]
}

# Whether the running container lets this checkout's key in. It stops doing so when devenv/.ssh/
# is deleted and a new key generated, since the old one is baked into the running container.
# Asked through docker rather than ssh, because ssh with the wrong key cannot tell a refusal
# from a container that is not answering.
key_matches() {
    [[ "$(docker exec "$CONTAINER" cat /home/dev/.ssh/authorized_keys 2>/dev/null)" == "$(cat "$KEY.pub")" ]]
}

# No default: `up` recreates a container, and a bare invocation is more often somebody asking what
# the commands are than somebody asking for that.
case "${1:-}" in
    "")
        usage >&2
        exit 2
        ;;
    help|-h|--help)
        usage
        ;;
    up)
        need_docker
        # Built every time rather than only when the image is missing. Docker's layer cache
        # makes an unchanged build about a second, and the alternative was worse than slow:
        # an edited Dockerfile did nothing at all until somebody thought to say `rebuild`,
        # and a keypair generated in a second worktree produced a container that refused
        # every login with no hint that a stale image was why.
        build >/dev/null
        if [[ -n "$(docker ps -q -f "name=^${CONTAINER}$")" ]]; then
            # The rebuild above does not reach a container that is already running, so one
            # started before this checkout's key or image changed still holds the old one.
            if ! key_matches; then
                echo "devenv $CONTAINER was running with an older key of this checkout's; recreating it, and whatever was running in it"
            elif ! image_matches; then
                echo "devenv $CONTAINER was running an older image than this checkout builds; recreating it, and whatever was running in it"
            else
                echo "devenv $CONTAINER already running on port $PORT"
                exit 0
            fi
        fi
        docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
        # On loopback only: nothing outside this machine has any business with it, and docker
        # publishes on every interface unless told otherwise. The label is what ./dev --doctor
        # reads to say which checkout a container belongs to.
        docker run -d --name "$CONTAINER" --label "muster.checkout=$REPO_ROOT" \
            -p "127.0.0.1:$PORT:22" "$IMAGE" >/dev/null || die \
            "devenv $CONTAINER would not start on port $PORT." \
            "  Impact: the remote path and its tests cannot reach this checkout's container." \
            "  The port comes from this checkout's path, so another program holding it collides every time:" \
            "  check 'lsof -nP -iTCP:$PORT -sTCP:LISTEN', and stop whatever holds it."
        for _ in $(seq 1 100); do
            ssh "${SSH_OPTS[@]}" dev@localhost true 2>/dev/null && break
            sleep 0.2
        done
        ssh "${SSH_OPTS[@]}" dev@localhost true 2>/dev/null || die \
            "devenv $CONTAINER started but will not accept SSH on port $PORT." \
            "  Impact: the remote path and its tests cannot reach the container." \
            "  Check 'docker logs $CONTAINER'."
        echo "devenv $CONTAINER up: ssh -i devenv/.ssh/id_ed25519 -p $PORT dev@localhost"
        ;;
    build)
        # Its own command for one caller: CI, which wants to hand docker a cache the
        # container knows nothing about. Everything after `build` goes to `docker build`.
        need_docker
        shift
        build "$@"
        ;;
    down)
        need_docker
        docker rm -f "$CONTAINER" >/dev/null 2>&1 && echo "devenv $CONTAINER down" || echo "devenv $CONTAINER was not running"
        ;;
    ssh)
        shift
        exec ssh "${SSH_OPTS[@]}" dev@localhost "$@"
        ;;
    status)
        need_docker
        if [[ -z "$(docker ps -q -f "name=^${CONTAINER}$")" ]]; then
            echo "devenv $CONTAINER: not running"
            exit 1
        fi
        echo "devenv $CONTAINER: running on port $PORT"
        # Checked before anything goes over ssh, because every probe below fails quietly with
        # the wrong key and the report would read as an empty container.
        if ! key_matches; then
            echo "devenv: holds an older key of this checkout's, so ssh from here is refused - ./devenv/devenv up recreates it"
            exit 1
        fi
        # What is reported is what is there, rather than what ought to be. An empty
        # container is the correct state before Muster attaches, so a missing daemon is
        # news rather than a failure.
        installed="$(ssh "${SSH_OPTS[@]}" dev@localhost 'ls -d ~/.muster/daemon/*/muster-daemon 2>/dev/null' || true)"
        if [[ -n "$installed" ]]; then
            echo "$installed" | sed 's/^/devenv: installed by muster: /'
        else
            echo "devenv: no muster-daemon yet - Muster installs its own under ~/.muster on attach"
        fi
        ;;
    rebuild)
        need_docker
        docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
        build --no-cache
        exec "$0" up
        ;;
    port)
        # For ./dev, which needs the port and should not derive it a second time.
        echo "$PORT"
        ;;
    *)
        usage >&2
        die "unknown command: $1"
        ;;
esac
