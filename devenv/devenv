#!/usr/bin/env bash
# Drive the devenv container: the Linux machine Muster's remote path talks to, and the
# fixture the remote tests run against.
#
#   ./devenv/devenv build           build the image, and nothing else
#   ./devenv/devenv up              build and start it
#   ./devenv/devenv down            stop and remove it
#   ./devenv/devenv ssh             shell in as dev
#   ./devenv/devenv status          is it up, and is there a daemon in it
#   ./devenv/devenv rebuild         rebuild the image from scratch, then up
#
# Nothing here installs a daemon. The image ships without one, because that absence is what
# makes the remote tests test Muster's install path rather than its adopt path.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IMAGE=muster-devenv
CONTAINER=muster-devenv
PORT=2222
KEY="$REPO_ROOT/devenv/.ssh/id_ed25519"

# StrictHostKeyChecking off and a null known-hosts file: the container gets a fresh
# host key every rebuild, and a fixture that demands the developer clear a host-key
# warning after every rebuild is a fixture nobody rebuilds.
SSH_OPTS=(-i "$KEY" -p "$PORT"
          -o StrictHostKeyChecking=no
          -o UserKnownHostsFile=/dev/null
          -o LogLevel=ERROR)

die() { printf '%s\n' "$@" >&2; exit 1; }

need_docker() {
    command -v docker >/dev/null 2>&1 || die \
        "docker is not on PATH." \
        "  Impact: the devenv container cannot be built or started, so the remote path has nothing to talk to." \
        "  Install Docker Desktop, or point this script at another OCI runtime."
    docker info >/dev/null 2>&1 || die \
        "docker is installed but not responding." \
        "  Impact: same as above - no container, no remote path." \
        "  Start Docker Desktop and try again."
}

ensure_key() {
    [[ -f "$KEY" ]] && return
    mkdir -p "$(dirname "$KEY")"
    ssh-keygen -t ed25519 -N '' -C muster-devenv -f "$KEY" >/dev/null
    echo "generated a devenv keypair at devenv/.ssh/ (gitignored)"
}

build() {
    ensure_key
    docker build \
        --build-arg DEV_PUBKEY="$(cat "$KEY.pub")" \
        -t "$IMAGE" -f "$REPO_ROOT/devenv/Dockerfile" "$@" "$REPO_ROOT"
}

# Whether the running container lets this worktree's key in. The container name is global to
# the machine while devenv/.ssh/ is per worktree, so a container another worktree started
# refuses every login from this one (kan a_2Ky2ptlug). Asked through docker rather than ssh,
# because ssh with the wrong key cannot tell a refusal from a container that is not answering.
key_matches() {
    [[ "$(docker exec "$CONTAINER" cat /home/dev/.ssh/authorized_keys 2>/dev/null)" == "$(cat "$KEY.pub")" ]]
}

case "${1:-up}" in
    up)
        need_docker
        # Built every time rather than only when the image is missing. Docker's layer cache
        # makes an unchanged build about a second, and the alternative was worse than slow:
        # an edited Dockerfile did nothing at all until somebody thought to say `rebuild`,
        # and a keypair generated in a second worktree produced a container that refused
        # every login with no hint that a stale image was why.
        build >/dev/null
        if [[ -n "$(docker ps -q -f "name=^${CONTAINER}$")" ]]; then
            # The rebuild above does not reach a container that is already running, so one
            # started from another worktree still holds that worktree's key and refuses this
            # one's (kan a_2LONhlgwh).
            if key_matches; then
                echo "devenv already running on port $PORT"
                exit 0
            fi
            echo "devenv was running with a key other than this worktree's; recreating it, and whatever was running in it"
        fi
        docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
        docker run -d --name "$CONTAINER" -p "$PORT:22" "$IMAGE" >/dev/null
        for _ in $(seq 1 100); do
            ssh "${SSH_OPTS[@]}" dev@localhost true 2>/dev/null && break
            sleep 0.2
        done
        ssh "${SSH_OPTS[@]}" dev@localhost true 2>/dev/null || die \
            "devenv started but will not accept SSH on port $PORT." \
            "  Impact: the remote path and its tests cannot reach the container." \
            "  Check 'docker logs $CONTAINER', and whether something else holds port $PORT."
        echo "devenv up: ssh -i devenv/.ssh/id_ed25519 -p $PORT dev@localhost"
        ;;
    build)
        # Its own command for one caller: CI, which wants to hand docker a cache the
        # container knows nothing about. Everything after `build` goes to `docker build`.
        need_docker
        shift
        build "$@"
        ;;
    down)
        need_docker
        docker rm -f "$CONTAINER" >/dev/null 2>&1 && echo "devenv down" || echo "devenv was not running"
        ;;
    ssh)
        shift
        exec ssh "${SSH_OPTS[@]}" dev@localhost "$@"
        ;;
    status)
        need_docker
        if [[ -z "$(docker ps -q -f "name=^${CONTAINER}$")" ]]; then
            echo "devenv: not running"
            exit 1
        fi
        echo "devenv: running on port $PORT"
        # Checked before anything goes over ssh, because every probe below fails quietly with
        # the wrong key and the report would read as an empty container.
        if ! key_matches; then
            echo "devenv: holds a key other than this worktree's, so ssh from here is refused - ./devenv/devenv up recreates it"
            exit 1
        fi
        # What is reported is what is there, rather than what ought to be. An empty
        # container is the correct state before Muster attaches, so a missing daemon is
        # news rather than a failure.
        installed="$(ssh "${SSH_OPTS[@]}" dev@localhost 'ls -d ~/.muster/daemon/*/muster-daemon 2>/dev/null' || true)"
        if [[ -n "$installed" ]]; then
            echo "$installed" | sed 's/^/devenv: installed by muster: /'
        else
            echo "devenv: no muster-daemon yet - Muster installs its own under ~/.muster on attach"
        fi
        ;;
    rebuild)
        need_docker
        docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
        build --no-cache
        exec "$0" up
        ;;
    *)
        die "unknown command: $1" "  Try: build | up | down | ssh | status | rebuild"
        ;;
esac
