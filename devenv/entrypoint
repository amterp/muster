#!/bin/sh
# sshd in the foreground as PID 1, and nothing else.
#
# No daemon is started here, because none is installed - Muster puts its own herdr on a
# machine it attaches to, and a devenv that came with one running would test the adopt
# path and never the install path. Whoever wants a daemon in here starts one: Muster
# does it on attach, and the corpus probe does it over SSH.
set -eu

ssh-keygen -A

echo "devenv ready on $(uname -m): sshd only, no daemon"
exec /usr/sbin/sshd -D -e
