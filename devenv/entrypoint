#!/bin/sh
# sshd in the foreground as PID 1, and nothing else.
#
# No daemon is started here, because none is installed - Muster puts its own muster-daemon
# on a machine it attaches to, and a devenv that came with one running would test the adopt
# path and never the install path. Muster installs and starts one on attach.
set -eu

ssh-keygen -A

echo "devenv ready on $(uname -m): sshd only, no daemon"
exec /usr/sbin/sshd -D -e
