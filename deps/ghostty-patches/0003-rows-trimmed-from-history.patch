diff --git a/src/terminal/PageList.zig b/src/terminal/PageList.zig
index f46d75b6..afb3ab5d 100644
--- a/src/terminal/PageList.zig
+++ b/src/terminal/PageList.zig
@@ -469,6 +469,14 @@ limits: Limits,
 /// specifically for scrollbar information so we can have the total size.
 total_rows: usize,
 
+/// How many rows have left the top of this PageList since it was made:
+/// history pruned to fit the scrollback limits, history erased, and every
+/// row a reset discarded. Never decreases, so a row's index plus this is a
+/// number for it that stays put as rows above it go. Rows that a reflow
+/// rewraps or that erasing the active area removes are not counted: no
+/// count can renumber them.
+rows_trimmed: usize = 0,
+
 /// The list of tracked pins. These are kept up to date automatically.
 tracked_pins: PinSet,
 
@@ -1048,6 +1056,7 @@ pub fn reset(self: *PageList) void {
     ) catch @panic("initPages failed");
 
     // Our total rows always goes back to the default
+    self.rows_trimmed += self.total_rows;
     self.total_rows = self.rows;
 
     // The pages the hints were measured from are gone.
@@ -4092,6 +4101,7 @@ pub fn grow(self: *PageList) Allocator.Error!?*List.Node {
             self.total_rows += first.rows();
             break :prune;
         }
+        self.rows_trimmed += first.rows();
 
         // If we have a pin viewport cache then we need to update it.
         if (self.viewport == .pin) viewport: {
@@ -6173,6 +6183,7 @@ fn eraseRows(
 
     // Update our total row count
     self.total_rows -= erased;
+    if (tl_pt == .history) self.rows_trimmed += erased;
 
     // If we deleted active, we need to regrow because one of our invariants
     // is that we always have full active space.
@@ -7651,6 +7662,7 @@ const Limits = struct {
             // by paths that already adjusted total_rows.
             pagelist.erasePage(first);
             pagelist.total_rows -= first_rows;
+            pagelist.rows_trimmed += first_rows;
             removed += first_rows;
         }
 
