diff --git a/src/terminal/c/muster.zig b/src/terminal/c/muster.zig
index f9693fb1..5d0010b4 100644
--- a/src/terminal/c/muster.zig
+++ b/src/terminal/c/muster.zig
@@ -290,6 +290,19 @@ pub fn kitty_image_loading_bytes(
     return .success;
 }
 
+/// How many rows have left the top of the active screen's history since the screen was made:
+/// pruned to the scrollback limit, erased, or discarded by a reset. A row's index counted from
+/// the oldest row held, plus this, numbers it from the start of the screen's history, which
+/// rows leaving the top do not change.
+pub fn rows_trimmed(
+    terminal_: terminal_c.Terminal,
+    out: ?*u64,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    (out orelse return .invalid_value).* = @intCast(t.screens.active.pages.rows_trimmed);
+    return .success;
+}
+
 /// Drops the kitty images still arriving on both screens, as a full reset does. Nothing else
 /// does: a program cut off between two chunks leaves its image arriving until another
 /// transmission ends it, and that one is appended to it.
@@ -541,3 +554,24 @@ test "kitty_image_drop_loading ends an upload whose program stopped sending" {
     try testing.expectEqual(Result.success, kitty_image_loading_bytes(t, &bytes));
     try testing.expectEqual(@as(u64, 0), bytes);
 }
+
+test "rows_trimmed counts the history erased and the rows a reset discards" {
+    const t = try testTerminal(10, 3);
+    defer terminal_c.free(t);
+
+    var trimmed: u64 = 9;
+    try testing.expectEqual(Result.success, rows_trimmed(t, &trimmed));
+    try testing.expectEqual(@as(u64, 0), trimmed);
+
+    write(t, "a\r\nb\r\nc\r\nd\r\ne");
+    try testing.expectEqual(Result.success, rows_trimmed(t, &trimmed));
+    try testing.expectEqual(@as(u64, 0), trimmed);
+
+    write(t, "\x1b[3J");
+    try testing.expectEqual(Result.success, rows_trimmed(t, &trimmed));
+    try testing.expectEqual(@as(u64, 2), trimmed);
+
+    write(t, "\x1bc");
+    try testing.expectEqual(Result.success, rows_trimmed(t, &trimmed));
+    try testing.expectEqual(@as(u64, 5), trimmed);
+}
