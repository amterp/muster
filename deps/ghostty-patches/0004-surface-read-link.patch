diff --git a/src/Surface.zig b/src/Surface.zig
index 7f7b1df8..749dee55 100644
--- a/src/Surface.zig
+++ b/src/Surface.zig
@@ -4440,6 +4440,31 @@ const Link = struct {
     selection: terminal.Selection,
 };
 
+/// Reads a raw link without applying mouse capture, modifiers, or path resolution.
+/// The caller owns the returned URL, allocated with alloc.
+pub fn readLinkAtPos(
+    self: *Surface,
+    pos: apprt.CursorPos,
+    alloc: Allocator,
+) !?struct { kind: apprt.action.OpenUrl.Kind, url: [:0]const u8 } {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+
+    const screen = self.renderer_state.terminal.screens.active;
+    const pin = screen.pages.pin(.{ .viewport = self.posToViewport(pos.x, pos.y) }) orelse return null;
+    if (self.config.link_osc8) {
+        if (self.osc8URI(pin)) |uri| return .{
+            .kind = .osc8,
+            .url = try alloc.dupeSentinel(u8, uri, 0),
+        };
+    }
+    const link = try self.linkAtPin(pin, null) orelse return null;
+    return .{
+        .kind = .unknown,
+        .url = try screen.selectionString(alloc, .{ .sel = link.selection, .trim = false }),
+    };
+}
+
 /// Returns the link at the given cursor position, if any.
 ///
 /// Requires the renderer mutex is held.
diff --git a/src/apprt/embedded.zig b/src/apprt/embedded.zig
index 548169bc..c6e5ed96 100644
--- a/src/apprt/embedded.zig
+++ b/src/apprt/embedded.zig
@@ -2147,6 +2147,25 @@ pub const CAPI = struct {
     }
 
     /// Tell the surface that it needs to schedule a render
+    /// Coordinates are points from the surface's top left, as for mouse_pos.
+    /// Returns raw link text without path resolution. Free url with ghostty_string_free.
+    export fn ghostty_surface_read_link(
+        surface: *Surface,
+        x: f64,
+        y: f64,
+        kind: *apprt.action.OpenUrl.Kind,
+        url: *String,
+    ) bool {
+        const pos = surface.cursorPosToPixels(.{ .x = @floatCast(x), .y = @floatCast(y) }) catch return false;
+        const link = surface.core_surface.readLinkAtPos(pos, global.alloc()) catch |err| {
+            log.warn("error reading link err={}", .{err});
+            return false;
+        } orelse return false;
+        kind.* = link.kind;
+        url.* = .fromSlice(link.url);
+        return true;
+    }
+
     export fn ghostty_surface_mouse_button(
         surface: *Surface,
         action: input.MouseButtonState,
