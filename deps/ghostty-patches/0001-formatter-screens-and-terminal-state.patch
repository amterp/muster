+    try testing.expectEqual(Result.success, clear_screen(t, true, &at_prompt));
+    try testing.expect(at_prompt);
+}
+
+test "clear_screen leaves the alternate screen alone" {
+    const t = try testTerminal(10, 3);
+    defer terminal_c.free(t);
+
+    write(t, "\x1b[?1049hvim\r\nhere");
+    var at_prompt = true;
+    try testing.expectEqual(Result.success, clear_screen(t, true, &at_prompt));
+    try testing.expect(!at_prompt);
+
+    const text = try t.?.terminal.plainString(testing.allocator);
+    defer testing.allocator.free(text);
+    try testing.expectEqualStrings("vim\nhere", text);
+}
+
+test "kitty_image_loading is set from the first chunk until the last" {
+    const t = try testTerminal(10, 3);
+    defer terminal_c.free(t);
+
+    var loading = true;
+    try testing.expectEqual(Result.success, kitty_image_loading(t, &loading));
+    try testing.expect(!loading);
+
+    write(t, "\x1b_Ga=t,f=32,s=1,v=1,i=7,q=2,m=1;AAAA\x1b\\");
+    try testing.expectEqual(Result.success, kitty_image_loading(t, &loading));
+    try testing.expect(loading == build_options.kitty_graphics);
+
+    write(t, "\x1b_Gm=0;/w==\x1b\\");
+    try testing.expectEqual(Result.success, kitty_image_loading(t, &loading));
+    try testing.expect(!loading);
+}
+
+test "kitty_image_drop_loading ends an upload whose program stopped sending" {
+    const t = try testTerminal(10, 3);
+    defer terminal_c.free(t);
+
+    var bytes: u64 = 1;
+    try testing.expectEqual(Result.success, kitty_image_loading_bytes(t, &bytes));
+    try testing.expectEqual(@as(u64, 0), bytes);
+
+    write(t, "\x1b_Ga=t,f=32,s=1,v=1,i=7,q=2,m=1;AAAA\x1b\\");
+    write(t, "\r\n$ ");
+    try testing.expectEqual(Result.success, kitty_image_loading_bytes(t, &bytes));
+    if (!build_options.kitty_graphics) return;
+    try testing.expect(bytes > 0);
+
+    try testing.expectEqual(Result.success, kitty_image_drop_loading(t));
+    var loading = true;
+    try testing.expectEqual(Result.success, kitty_image_loading(t, &loading));
+    try testing.expect(!loading);
+    try testing.expectEqual(Result.success, kitty_image_loading_bytes(t, &bytes));
+    try testing.expectEqual(@as(u64, 0), bytes);
+}
