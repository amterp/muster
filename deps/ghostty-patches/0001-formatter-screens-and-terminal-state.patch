+++ b/src/terminal/c/muster.zig
@@ -0,0 +1,297 @@
+//! Terminal state and actions Muster needs that the rest of the C API does not reach: each
+//! screen's cursor style, the mouse tracking mode in effect, the shift-capture flag, and the
+//! terminal half of Ghostty's clear_screen, and the kitty image still arriving. Kept in a file of its own so a re-pin rebases only
+//! the lines that export it.
+
+const std = @import("std");
+const testing = std.testing;
+const build_options = @import("terminal_options");
+const lib = @import("../lib.zig");
+const terminal_c = @import("terminal.zig");
+const ScreenSet = @import("../ScreenSet.zig");
+const Result = @import("result.zig").Result;
+
+/// The cursor style of the given screen, which DECSCUSR sets per screen. A screen that was never
+/// entered has the style a terminal starts with.
+pub fn screen_cursor_style(
+    terminal_: terminal_c.Terminal,
+    screen: ScreenSet.Key,
+    out: ?*terminal_c.TerminalCursorStyle,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    const key = std.enums.fromInt(ScreenSet.Key, @intFromEnum(screen)) orelse
+        return .invalid_value;
+    const style = if (t.screens.get(key)) |s| s.cursor.cursor_style else .block;
+    (out orelse return .invalid_value).* = switch (style) {
+        .bar => .bar,
+        .block => .block,
+        .underline => .underline,
+        .block_hollow => .block_hollow,
+    };
+    return .success;
+}
+
+/// The mouse tracking mode in effect and the report format, as the DEC private mode numbers
+/// that set them: 9, 1000, 1002 or 1003, or 0 for none; 1005, 1006, 1015 or 1016, or 0 for the
+/// default. The mode bits alone cannot say this, since setting any tracking mode replaces the
+/// one before without clearing its bit.
+pub fn mouse_tracking(
+    terminal_: terminal_c.Terminal,
+    event_mode: ?*u16,
+    format_mode: ?*u16,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    (event_mode orelse return .invalid_value).* = switch (t.flags.mouse_event) {
+        .none => 0,
+        .x10 => 9,
+        .normal => 1000,
+        .button => 1002,
+        .any => 1003,
+    };
+    (format_mode orelse return .invalid_value).* = switch (t.flags.mouse_format) {
+        .x10 => 0,
+        .utf8 => 1005,
+        .sgr => 1006,
+        .urxvt => 1015,
+        .sgr_pixels => 1016,
+    };
+    return .success;
+}
+
+/// What a program said with XTSHIFTESCAPE: 0 if it has said nothing, 1 if shift-clicks are the
+/// terminal's to select with, 2 if they are to be reported to the program.
+pub fn mouse_shift_capture(
+    terminal_: terminal_c.Terminal,
+    out: ?*u8,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    (out orelse return .invalid_value).* = switch (t.flags.mouse_shift_capture) {
+        .null => 0,
+        .false => 1,
+        .true => 2,
+    };
+    return .success;
+}
+
+/// The terminal half of Ghostty's clear_screen binding (Termio.clearScreen), less the selection,
+/// which this terminal has none of. Nothing on the alternate screen. Otherwise history goes when
+/// `history` is set; at a prompt the whole screen is erased and `at_prompt` is set, so the caller
+/// sends the shell a form feed to draw its prompt again, as Ghostty does; elsewhere only the rows
+/// above the cursor go, with every kitty image.
+pub fn clear_screen(
+    terminal_: terminal_c.Terminal,
+    history: bool,
+    at_prompt: ?*bool,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    const prompt = at_prompt orelse return .invalid_value;
+    prompt.* = false;
+    if (t.screens.active_key == .alternate) return .success;
+    if (history) t.eraseDisplay(.scrollback, false);
+    if (!t.cursorIsAtPrompt()) {
+        const screen = t.screens.active;
+        if (screen.cursor.y > 0) screen.eraseActive(screen.cursor.y - 1);
+        if (comptime build_options.kitty_graphics) {
+            screen.kitty_images.delete(t.io(), screen.alloc, t, .{ .all = true });
+        }
+        return .success;
+    }
+    t.eraseDisplay(.complete, false);
+    prompt.* = true;
+    return .success;
+}
+
+/// Whether a kitty image is still arriving on either screen: a chunked transmission has begun
+/// and not ended.
+pub fn kitty_image_loading(
+    terminal_: terminal_c.Terminal,
+    out: ?*bool,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    const loading = out orelse return .invalid_value;
+    loading.* = false;
+    if (comptime build_options.kitty_graphics) {
+        for ([_]ScreenSet.Key{ .primary, .alternate }) |key| {
+            if (t.screens.get(key)) |screen| {
+                if (screen.kitty_images.loading != null) loading.* = true;
+            }
+        }
+    }
+    return .success;
+}
+
+/// How many bytes of the kitty images still arriving have arrived, across both screens: 0 when
+/// none is arriving. It grows with every chunk, so a caller can tell an upload still under way
+/// from one whose program stopped sending.
+pub fn kitty_image_loading_bytes(
+    terminal_: terminal_c.Terminal,
+    out: ?*u64,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    const bytes = out orelse return .invalid_value;
+    bytes.* = 0;
+    if (comptime build_options.kitty_graphics) {
+        for ([_]ScreenSet.Key{ .primary, .alternate }) |key| {
+            const screen = t.screens.get(key) orelse continue;
+            if (screen.kitty_images.loading) |loading| bytes.* += loading.data.items.len;
+        }
+    }
+    return .success;
+}
+
+/// Drops the kitty images still arriving on both screens, as a full reset does. Nothing else
+/// does: a program cut off between two chunks leaves its image arriving until another
+/// transmission ends it, and that one is appended to it.
+pub fn kitty_image_drop_loading(terminal_: terminal_c.Terminal) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    if (comptime build_options.kitty_graphics) {
+        for ([_]ScreenSet.Key{ .primary, .alternate }) |key| {
+            const screen = t.screens.get(key) orelse continue;
+            if (screen.kitty_images.loading) |loading| {
+                loading.destroy(screen.alloc);
+                screen.kitty_images.loading = null;
+            }
+        }
+    }
+    return .success;
+}
