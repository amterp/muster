+        .{ .emit = .vt, .unwrap = false, .trim = true, .content = true, .trailing_blank_rows = false, .extra = .{ .cursor = false, .style = false, .hyperlink = false, .protection = false, .kitty_keyboard = false, .charsets = false } },
+    ));
+    defer free(screen);
+
+    var buf: [1024]u8 = undefined;
+    var written: usize = 0;
+    // The existing formatter is unchanged: the gaps take the red of the text before them.
+    try testing.expectEqual(Result.success, format_buf(existing, &buf, buf.len, &written));
+    try testing.expectEqualStrings(
+        "\x1b[0m\x1b[48;5;1mred      \x1b[0mx    \x1b[0m\x1b[48;5;1my\x1b[0m\r\n" ++
+            "\x1b[0m\x1b[48;5;1ma   b\x1b[0m",
+        buf[0..written],
+    );
+
+    // A screen formatter closes the style before a gap, including a gap between two runs
+    // of the same style.
+    try testing.expectEqual(Result.success, format_buf(screen, &buf, buf.len, &written));
+    try testing.expectEqualStrings(
+        "\x1b[0m\x1b[48;5;1mred\x1b[0m      x    \x1b[0m\x1b[48;5;1my\x1b[0m\r\n" ++
+            "\x1b[0m\x1b[48;5;1ma\x1b[0m   \x1b[0m\x1b[48;5;1mb\x1b[0m",
+        buf[0..written],
+    );
+}
