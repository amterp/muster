+pub fn terminal_state_new(
+    alloc_: ?*const CAllocator,
+    result: *Formatter,
+    terminal_: terminal_c.Terminal,
+    opts: TerminalOptions,
+) callconv(lib.calling_conv) Result {
+    result.* = terminal_state_new_(
+        alloc_,
+        terminal_,
+        opts,
+    ) catch |err| {
+        result.* = null;
+        return switch (err) {
+            error.InvalidValue => .invalid_value,
+            error.OutOfMemory => .out_of_memory,
+        };
+    };
+
+    return .success;
+}
+
+fn terminal_state_new_(
+    alloc_: ?*const CAllocator,
+    terminal_: terminal_c.Terminal,
+    opts: TerminalOptions,
+) error{
+    InvalidValue,
+    OutOfMemory,
+}!*FormatterWrapper {
+    // A selection restricts content, and this formatter emits none.
+    if (opts.selection != null) return error.InvalidValue;
+
+    const ptr = try terminal_new_(alloc_, terminal_, opts);
+    ptr.kind.terminal.content = .none;
+    return ptr;
+}
+
+pub fn screen_new(
+    alloc_: ?*const CAllocator,
+    result: *Formatter,
+    terminal_: terminal_c.Terminal,
+    screen: ScreenSet.Key,
+    opts: ScreenOptions,
+) callconv(lib.calling_conv) Result {
+    result.* = screen_new_(
+        alloc_,
+        terminal_,
+        screen,
+        opts,
+    ) catch |err| {
+        result.* = null;
+        return switch (err) {
+            error.InvalidValue => .invalid_value,
+            error.OutOfMemory => .out_of_memory,
+        };
+    };
+
+    return .success;
+}
+
+fn screen_new_(
+    alloc_: ?*const CAllocator,
+    terminal_: terminal_c.Terminal,
+    screen: ScreenSet.Key,
+    opts: ScreenOptions,
+) error{
+    InvalidValue,
+    OutOfMemory,
+}!*FormatterWrapper {
+    const t: *ZigTerminal = (terminal_ orelse return error.InvalidValue).terminal;
+    _ = std.enums.fromInt(ScreenSet.Key, @intFromEnum(screen)) orelse
+        return error.InvalidValue;
+
+    const alloc = lib.alloc.default(alloc_);
+    const ptr = alloc.create(FormatterWrapper) catch
+        return error.OutOfMemory;
+    errdefer alloc.destroy(ptr);
+
+    ptr.* = .{
+        .kind = .{ .screen = .{
+            .terminal = t,
+            .key = screen,
+            .opts = .{
