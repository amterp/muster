@@ -0,0 +1,171 @@
+/**
+ * @file muster.h
+ *
+ * Formatting and terminal state Muster reads through its own patch to
+ * libghostty: a screen whether or not it is active, the terminal's state
+ * with no content, each screen's cursor style, the mouse tracking mode in
+ * effect, the XTSHIFTESCAPE flag, the terminal half of clear_screen, and
+ * whether a kitty image is still arriving.
+ */
+
+#ifndef GHOSTTY_VT_MUSTER_H
+#define GHOSTTY_VT_MUSTER_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <ghostty/vt/allocator.h>
+#include <ghostty/vt/formatter.h>
+#include <ghostty/vt/types.h>
+#include <ghostty/vt/terminal.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** Rows for ghostty_terminal_format_screen: history and the active area. */
+#define GHOSTTY_MUSTER_ROWS_ALL 0
+/** Rows for ghostty_terminal_format_screen: the active area only. */
+#define GHOSTTY_MUSTER_ROWS_ACTIVE 1
+/**
+ * Rows for ghostty_terminal_format_screen: history only, ending at the row
+ * above the active area. Empty when the screen has no history.
+ */
+#define GHOSTTY_MUSTER_ROWS_HISTORY 2
+
+/**
+ * Format one screen of the terminal, whether or not it is the active one.
+ * The formatter's own functions reach only the active screen, so this is
+ * how the primary screen is read while a program holds the alternate one.
+ *
+ * `rows` is one of GHOSTTY_MUSTER_ROWS_*. `extras` may hold only screen
+ * extras (GHOSTTY_FORMATTER_EXTRA_CURSOR and above). A screen never
+ * entered formats to nothing. The output is allocated with `allocator`
+ * and freed with ghostty_free; empty output sets `*out_ptr` to NULL.
+ *
+ * @return GHOSTTY_SUCCESS, GHOSTTY_INVALID_VALUE for a NULL argument, an
+ *         unknown screen, rows or format, or a terminal extra in `extras`,
+ *         or GHOSTTY_OUT_OF_MEMORY
+ */
+GHOSTTY_API GhosttyResult ghostty_terminal_format_screen(
+    GhosttyTerminal terminal,
+    GhosttyTerminalScreen screen,
+    int rows,
+    GhosttyFormatterFormat emit,
+    bool unwrap,
+    bool trim,
+    GhosttyFormatterExtras extras,
+    const GhosttyAllocator* allocator,
+    uint8_t** out_ptr,
+    size_t* out_len);
+
+/**
+ * Format the terminal's state with no screen content, as VT sequences:
+ * the terminal extras in `extras`, then the active screen's. The cursor is
+ * written for the receiver's origin mode and right margin whether or not
+ * `extras` includes the modes, so a caller that writes modes itself still
+ * gets a cursor, and a pending wrap, where they put it.
+ *
+ * @return GHOSTTY_SUCCESS, GHOSTTY_INVALID_VALUE for a NULL argument or an
+ *         unknown extra, or GHOSTTY_OUT_OF_MEMORY
+ */
+GHOSTTY_API GhosttyResult ghostty_terminal_format_state(
+    GhosttyTerminal terminal,
+    GhosttyFormatterExtras extras,
+    const GhosttyAllocator* allocator,
+    uint8_t** out_ptr,
+    size_t* out_len);
+
+/**
+ * The cursor style of the given screen. DECSCUSR sets the style of the
+ * active screen only, so the primary screen's is its own while a program
+ * holds the alternate one. A screen never entered has the block style a
+ * terminal starts with.
+ *
+ * @return GHOSTTY_SUCCESS, or GHOSTTY_INVALID_VALUE for a NULL terminal or
+ *         out, or an unknown screen
+ */
+GHOSTTY_API GhosttyResult ghostty_terminal_screen_cursor_style(
+    GhosttyTerminal terminal,
+    GhosttyTerminalScreen screen,
+    GhosttyCursorStyle* out);
+
+/**
+ * The mouse tracking mode in effect and the report format, as the DEC
+ * private mode numbers that set them: 9, 1000, 1002 or 1003, or 0 for no
+ * tracking; 1005, 1006, 1015 or 1016, or 0 for the default format. Setting
+ * a tracking mode replaces the one before without clearing its mode bit,
+ * so the bits alone cannot say which is in effect.
+ *
+ * @return GHOSTTY_SUCCESS, or GHOSTTY_INVALID_VALUE for a NULL argument
+ */
+GHOSTTY_API GhosttyResult ghostty_terminal_mouse_tracking(
+    GhosttyTerminal terminal,
+    uint16_t* event_mode,
+    uint16_t* format_mode);
+
+/**
+ * What a program said with XTSHIFTESCAPE (CSI > Ps s): 0 if nothing, 1 if
+ * shift-clicks stay the terminal's to select with (Ps 0), 2 if they are to
+ * be reported to the program (Ps 1).
+ *
+ * @return GHOSTTY_SUCCESS, or GHOSTTY_INVALID_VALUE for a NULL argument
+ */
+GHOSTTY_API GhosttyResult ghostty_terminal_mouse_shift_capture(
+    GhosttyTerminal terminal,
+    uint8_t* out);
+
+/**
+ * The terminal half of Ghostty's clear_screen binding. Does nothing on the
+ * alternate screen. Otherwise erases history when history is set; at a
+ * prompt (shell integration's OSC 133 marks) erases the whole screen and
+ * sets at_prompt, so the caller sends the shell a form feed (0x0C) to draw
+ * its prompt again; elsewhere erases the rows above the cursor and every
+ * kitty image.
+ *
+ * @return GHOSTTY_SUCCESS, or GHOSTTY_INVALID_VALUE for a NULL argument
+ */
+GHOSTTY_API GhosttyResult ghostty_terminal_clear_screen(
+    GhosttyTerminal terminal,
+    bool history,
+    bool* at_prompt);
+
+/**
+ * Whether a kitty image is still arriving on either screen: a chunked
+ * transmission (m=1) has begun and not ended. Forgetting the images then
+ * would drop the chunks already received.
+ *
+ * @return GHOSTTY_SUCCESS, or GHOSTTY_INVALID_VALUE for a NULL argument
+ */
+GHOSTTY_API GhosttyResult ghostty_terminal_kitty_image_loading(
+    GhosttyTerminal terminal,
+    bool* out);
+
+/**
+ * How many bytes of the kitty images still arriving have arrived, across
+ * both screens: 0 when none is arriving. It grows with every chunk, so a
+ * caller can tell an upload still under way from one whose program
+ * stopped sending.
+ *
+ * @return GHOSTTY_SUCCESS, or GHOSTTY_INVALID_VALUE for a NULL argument
+ */
+GHOSTTY_API GhosttyResult ghostty_terminal_kitty_image_loading_bytes(
+    GhosttyTerminal terminal,
+    uint64_t* out);
+
+/**
+ * Drops the kitty images still arriving on both screens, as a full reset
+ * does. Nothing else does: a program cut off between two chunks leaves
+ * its image arriving until another transmission ends it, and that one is
+ * appended to it.
+ *
+ * @return GHOSTTY_SUCCESS, or GHOSTTY_INVALID_VALUE for a NULL terminal
+ */
+GHOSTTY_API GhosttyResult ghostty_terminal_kitty_image_drop_loading(
+    GhosttyTerminal terminal);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* GHOSTTY_VT_MUSTER_H */
