+/**
+ * Create a formatter for a terminal's state without any screen content.
+ *
+ * This emits the same extras as ghostty_formatter_terminal_new(), including
+ * the active screen's extras, but no rows. Combined with screen formatters
+ * it can reproduce a terminal whose screens are formatted separately, for
+ * example the primary screen while the alternate screen is active.
+ *
+ * The terminal must outlive the formatter. The selection option must be NULL.
+ *
+ * @param allocator Pointer to allocator, or NULL to use the default allocator
+ * @param formatter Pointer to store the created formatter handle
+ * @param terminal The terminal to format (must not be NULL)
+ * @param options Formatting options
+ * @return GHOSTTY_SUCCESS on success, or an error code on failure
+ *
+ * @ingroup formatter
+ */
+GHOSTTY_API GhosttyResult ghostty_formatter_terminal_state_new(
+    const GhosttyAllocator* allocator,
+    GhosttyFormatter* formatter,
+    GhosttyTerminal terminal,
+    GhosttyFormatterTerminalOptions options);
+
+/**
+ * Create a formatter for one of a terminal's screens, active or not.
+ *
+ * The screen is looked up on each format call. A screen the terminal has
+ * never initialized formats as empty output.
+ *
+ * Unlike ghostty_formatter_terminal_new(), blank cells between text are
+ * written unstyled, as the screen holds them, rather than in the style of
+ * the text before them.
+ *
+ * The terminal must outlive the formatter.
+ *
+ * @param allocator Pointer to allocator, or NULL to use the default allocator
+ * @param formatter Pointer to store the created formatter handle
+ * @param terminal The terminal to format (must not be NULL)
+ * @param screen The screen to format
+ * @param options Formatting options
+ * @return GHOSTTY_SUCCESS on success, or an error code on failure
+ *
+ * @ingroup formatter
+ */
+GHOSTTY_API GhosttyResult ghostty_formatter_screen_new(
+    const GhosttyAllocator* allocator,
+    GhosttyFormatter* formatter,
+    GhosttyTerminal terminal,
+    GhosttyTerminalScreen screen,
+    GhosttyFormatterScreenOptions options);
+
 /**
