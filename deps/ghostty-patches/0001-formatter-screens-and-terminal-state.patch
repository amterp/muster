diff --git a/src/terminal/c/muster.zig b/src/terminal/c/muster.zig
new file mode 100644
index 00000000..f9693fb1
--- /dev/null
+++ b/src/terminal/c/muster.zig
@@ -0,0 +1,543 @@
+//! Terminal state and actions Muster needs that the rest of the C API does not reach: formatting
+//! a screen that is not the active one, formatting terminal state with no content, each screen's
+//! cursor style, the mouse tracking mode in effect, the shift-capture flag, the terminal half of
+//! Ghostty's clear_screen, and the kitty image still arriving. Kept in a file of its own, built
+//! only from the formatter's and terminal's public Zig API, so a re-pin rebases only the lines
+//! that export it.
+
+const std = @import("std");
+const testing = std.testing;
+const build_options = @import("terminal_options");
+const lib = @import("../lib.zig");
+const CAllocator = lib.alloc.Allocator;
+const terminal_c = @import("terminal.zig");
+const formatter_c = @import("formatter.zig");
+const CursorStyle = @import("types.zig").CursorStyle;
+const formatterpkg = @import("../formatter.zig");
+const ScreenSet = @import("../ScreenSet.zig");
+const Selection = @import("../Selection.zig");
+const Result = @import("result.zig").Result;
+
+const TerminalExtra = formatterpkg.TerminalFormatter.Extra;
+const ScreenExtra = formatterpkg.ScreenFormatter.Extra;
+
+/// GHOSTTY_MUSTER_ROWS_*: which rows of a screen ghostty_terminal_format_screen writes.
+pub const Rows = enum(c_int) {
+    /// History and the active area.
+    all = 0,
+    /// The active area only.
+    active = 1,
+    /// History only, ending at the row above the active area.
+    history = 2,
+};
+
+/// The screen extras' bits within a GhosttyFormatterExtras value. The terminal extras come first
+/// in `TerminalFormatter.Extra`, as formatter_c's bit check makes sure.
+const screen_extras_shift = @bitOffsetOf(TerminalExtra, "screen");
+const extras_valid: formatter_c.Extras = (@as(formatter_c.Extras, 1) << @bitSizeOf(TerminalExtra)) - 1;
+const screen_extras_mask: formatter_c.Extras = extras_valid & ~((@as(formatter_c.Extras, 1) << screen_extras_shift) - 1);
+
+fn terminalExtra(extras: formatter_c.Extras) ?TerminalExtra {
+    if (extras & ~extras_valid != 0) return null;
+    const Int = @typeInfo(TerminalExtra).@"struct".backing_integer.?;
+    return @bitCast(@as(Int, @intCast(extras)));
+}
+
+/// Formats one screen of the terminal, whichever is active: the primary screen's history while a
+/// program holds the alternate one is the case that needs it, since the C formatter formats only
+/// the active screen. `extras` may hold screen extras only.
+pub fn format_screen(
+    terminal_: terminal_c.Terminal,
+    screen: c_int,
+    rows: c_int,
+    emit: c_int,
+    unwrap: bool,
+    trim: bool,
+    extras: formatter_c.Extras,
+    alloc_: ?*const CAllocator,
+    out_ptr: ?*?[*]u8,
+    out_len: ?*usize,
+) callconv(lib.calling_conv) Result {
+    if (comptime !lib.feature(.formatter)) return .unsupported;
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    const key = std.enums.fromInt(ScreenSet.Key, screen) orelse return .invalid_value;
+    const which = std.enums.fromInt(Rows, rows) orelse return .invalid_value;
+    const format = std.enums.fromInt(formatterpkg.Format, emit) orelse return .invalid_value;
+    if (extras & ~screen_extras_mask != 0) return .invalid_value;
+    const extra = (terminalExtra(extras) orelse return .invalid_value).screen;
+
+    // A screen never entered has no rows to write.
+    const s = t.screens.get(key) orelse return writeAlloc(alloc_, out_ptr, out_len, &.{});
+
+    var formatter: formatterpkg.ScreenFormatter = .init(s, .{
+        .emit = format,
+        .unwrap = unwrap,
+        .trim = trim,
+    });
+    formatter.extra = extra;
+    formatter.content = .{ .selection = switch (which) {
+        .all => null,
+        .active => Selection.init(
+            s.pages.getTopLeft(.active),
+            s.pages.getBottomRight(.active).?,
+            false,
+        ),
+        .history => Selection.init(
+            s.pages.getTopLeft(.history),
+            s.pages.getBottomRight(.history) orelse
+                return writeAlloc(alloc_, out_ptr, out_len, &.{}),
+            false,
+        ),
+    } };
+    return formatAlloc(formatterpkg.ScreenFormatter, &formatter, alloc_, out_ptr, out_len);
+}
+
+/// Formats the terminal's state with no content, as VT: the terminal extras in `extras` first,
+/// then its active screen's. Unlike the C formatter, the cursor is placed for the receiver's
+/// origin mode and right margin whether or not `extras` asks for the modes, because a caller
+/// that writes modes itself still needs the cursor to land where they put it.
+pub fn format_state(
+    terminal_: terminal_c.Terminal,
+    extras: formatter_c.Extras,
+    alloc_: ?*const CAllocator,
+    out_ptr: ?*?[*]u8,
+    out_len: ?*usize,
+) callconv(lib.calling_conv) Result {
+    if (comptime !lib.feature(.formatter)) return .unsupported;
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    const extra = terminalExtra(extras) orelse return .invalid_value;
+    const alloc = lib.alloc.default(alloc_);
+    const opts: formatterpkg.Options = .{ .emit = .vt, .unwrap = false, .trim = false };
+
+    var aw: std.Io.Writer.Allocating = .init(alloc);
+    defer aw.deinit();
+
+    var terminal_formatter: formatterpkg.TerminalFormatter = .init(t, opts);
+    terminal_formatter.content = .none;
+    terminal_formatter.extra = extra;
+    terminal_formatter.extra.screen = .none;
+    terminal_formatter.format(&aw.writer) catch return .out_of_memory;
+
+    var screen_formatter: formatterpkg.ScreenFormatter = .init(t.screens.active, opts);
+    screen_formatter.content = .none;
+    screen_formatter.extra = extra.screen;
+    if (t.modes.get(.origin)) screen_formatter.cursor_origin = .{
+        .x = t.scrolling_region.left,
+        .y = t.scrolling_region.top,
+    };
+    if (t.screens.active.cursor.x <= t.scrolling_region.right) {
+        screen_formatter.wrap_column = t.scrolling_region.right;
+    }
+    screen_formatter.format(&aw.writer) catch return .out_of_memory;
+
+    return finishAlloc(&aw, out_ptr, out_len);
+}
+
+fn formatAlloc(
+    comptime Formatter: type,
+    formatter: *const Formatter,
+    alloc_: ?*const CAllocator,
+    out_ptr: ?*?[*]u8,
+    out_len: ?*usize,
+) Result {
+    var aw: std.Io.Writer.Allocating = .init(lib.alloc.default(alloc_));
+    defer aw.deinit();
+    formatter.format(&aw.writer) catch return .out_of_memory;
+    return finishAlloc(&aw, out_ptr, out_len);
+}
+
+fn writeAlloc(
+    alloc_: ?*const CAllocator,
+    out_ptr: ?*?[*]u8,
+    out_len: ?*usize,
+    bytes: []const u8,
+) Result {
+    var aw: std.Io.Writer.Allocating = .init(lib.alloc.default(alloc_));
+    defer aw.deinit();
+    aw.writer.writeAll(bytes) catch return .out_of_memory;
+    return finishAlloc(&aw, out_ptr, out_len);
+}
+
+/// Hands the bytes over as the C formatter's format_alloc does: freed with ghostty_free.
+fn finishAlloc(aw: *std.Io.Writer.Allocating, out_ptr_: ?*?[*]u8, out_len_: ?*usize) Result {
+    const out_ptr = out_ptr_ orelse return .invalid_value;
+    const out_len = out_len_ orelse return .invalid_value;
+    const buf = aw.toOwnedSlice() catch return .out_of_memory;
+    out_ptr.* = if (buf.len == 0) null else buf.ptr;
+    out_len.* = buf.len;
+    return .success;
+}
+
+/// The cursor style of the given screen, which DECSCUSR sets per screen. A screen that was never
+/// entered has the style a terminal starts with.
+pub fn screen_cursor_style(
+    terminal_: terminal_c.Terminal,
+    screen: c_int,
+    out: ?*CursorStyle,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    const key = std.enums.fromInt(ScreenSet.Key, screen) orelse return .invalid_value;
+    const style = if (t.screens.get(key)) |s| s.cursor.cursor_style else .block;
+    (out orelse return .invalid_value).* = .fromZig(style);
+    return .success;
+}
+
+/// The mouse tracking mode in effect and the report format, as the DEC private mode numbers
+/// that set them: 9, 1000, 1002 or 1003, or 0 for none; 1005, 1006, 1015 or 1016, or 0 for the
+/// default. The mode bits alone cannot say this, since setting any tracking mode replaces the
+/// one before without clearing its bit.
+pub fn mouse_tracking(
+    terminal_: terminal_c.Terminal,
+    event_mode: ?*u16,
+    format_mode: ?*u16,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    (event_mode orelse return .invalid_value).* = switch (t.flags.mouse_event) {
+        .none => 0,
+        .x10 => 9,
+        .normal => 1000,
+        .button => 1002,
+        .any => 1003,
+    };
+    (format_mode orelse return .invalid_value).* = switch (t.flags.mouse_format) {
+        .x10 => 0,
+        .utf8 => 1005,
+        .sgr => 1006,
+        .urxvt => 1015,
+        .sgr_pixels => 1016,
+    };
+    return .success;
+}
+
+/// What a program said with XTSHIFTESCAPE: 0 if it has said nothing, 1 if shift-clicks are the
+/// terminal's to select with, 2 if they are to be reported to the program.
+pub fn mouse_shift_capture(
+    terminal_: terminal_c.Terminal,
+    out: ?*u8,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    (out orelse return .invalid_value).* = switch (t.flags.mouse_shift_capture) {
+        .null => 0,
+        .false => 1,
+        .true => 2,
+    };
+    return .success;
+}
+
+/// The terminal half of Ghostty's clear_screen binding (Termio.clearScreen), less the selection,
+/// which this terminal has none of. Nothing on the alternate screen. Otherwise history goes when
+/// `history` is set; at a prompt the whole screen is erased and `at_prompt` is set, so the caller
+/// sends the shell a form feed to draw its prompt again, as Ghostty does; elsewhere only the rows
+/// above the cursor go, with every kitty image.
+pub fn clear_screen(
+    terminal_: terminal_c.Terminal,
+    history: bool,
+    at_prompt: ?*bool,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    const prompt = at_prompt orelse return .invalid_value;
+    prompt.* = false;
+    if (t.screens.active_key == .alternate) return .success;
+    if (history) t.eraseDisplay(.scrollback, false);
+    if (!t.cursorIsAtPrompt()) {
+        const screen = t.screens.active;
+        if (screen.cursor.y > 0) screen.eraseActive(screen.cursor.y - 1);
+        if (comptime build_options.kitty_graphics) {
+            screen.kitty_images.delete(t.io(), screen.alloc, t, .{ .all = true });
+        }
+        return .success;
+    }
+    t.eraseDisplay(.complete, false);
+    prompt.* = true;
+    return .success;
+}
+
+/// Whether a kitty image is still arriving on either screen: a chunked transmission has begun
+/// and not ended.
+pub fn kitty_image_loading(
+    terminal_: terminal_c.Terminal,
+    out: ?*bool,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    const loading = out orelse return .invalid_value;
+    loading.* = false;
+    if (comptime build_options.kitty_graphics) {
+        for ([_]ScreenSet.Key{ .primary, .alternate }) |key| {
+            if (t.screens.get(key)) |screen| {
+                if (screen.kitty_images.loading != null) loading.* = true;
+            }
+        }
+    }
+    return .success;
+}
+
+/// How many bytes of the kitty images still arriving have arrived, across both screens: 0 when
+/// none is arriving. It grows with every chunk, so a caller can tell an upload still under way
+/// from one whose program stopped sending.
+pub fn kitty_image_loading_bytes(
+    terminal_: terminal_c.Terminal,
+    out: ?*u64,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    const bytes = out orelse return .invalid_value;
+    bytes.* = 0;
+    if (comptime build_options.kitty_graphics) {
+        for ([_]ScreenSet.Key{ .primary, .alternate }) |key| {
+            const screen = t.screens.get(key) orelse continue;
+            if (screen.kitty_images.loading) |loading| bytes.* += loading.data.items.len;
+        }
+    }
+    return .success;
+}
+
+/// Drops the kitty images still arriving on both screens, as a full reset does. Nothing else
+/// does: a program cut off between two chunks leaves its image arriving until another
+/// transmission ends it, and that one is appended to it.
+pub fn kitty_image_drop_loading(terminal_: terminal_c.Terminal) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    if (comptime build_options.kitty_graphics) {
+        for ([_]ScreenSet.Key{ .primary, .alternate }) |key| {
+            const screen = t.screens.get(key) orelse continue;
+            if (screen.kitty_images.loading) |loading| {
+                loading.destroy(screen.alloc);
+                screen.kitty_images.loading = null;
+            }
+        }
+    }
+    return .success;
+}
+
+fn testTerminal(cols: u16, rows: u16) !terminal_c.Terminal {
+    var t: terminal_c.Terminal = null;
+    try testing.expectEqual(Result.success, terminal_c.new(&lib.alloc.test_allocator, &t, cols, rows));
+    return t;
+}
+
+fn write(t: terminal_c.Terminal, bytes: []const u8) void {
+    terminal_c.vt_write(t, bytes.ptr, bytes.len);
+}
+
+const Formatted = struct {
+    bytes: []const u8,
+
+    fn deinit(self: Formatted) void {
+        lib.alloc.default(&lib.alloc.test_allocator).free(@constCast(self.bytes));
+    }
+};
+
+fn screenText(t: terminal_c.Terminal, key: ScreenSet.Key, rows: Rows, emit: formatterpkg.Format, trim: bool, extras: formatter_c.Extras) !Formatted {
+    var ptr: ?[*]u8 = null;
+    var len: usize = 0;
+    try testing.expectEqual(Result.success, format_screen(t, @intFromEnum(key), @intFromEnum(rows), @intFromEnum(emit), false, trim, extras, &lib.alloc.test_allocator, &ptr, &len));
+    return .{ .bytes = if (ptr) |p| p[0..len] else &.{} };
+}
+
+fn stateText(t: terminal_c.Terminal, extras: formatter_c.Extras) !Formatted {
+    var ptr: ?[*]u8 = null;
+    var len: usize = 0;
+    try testing.expectEqual(Result.success, format_state(t, extras, &lib.alloc.test_allocator, &ptr, &len));
+    return .{ .bytes = if (ptr) |p| p[0..len] else &.{} };
+}
+
+const cursor_extra = formatter_c.ExtraBit.cursor.mask();
+
+test "format_screen writes the primary screen while the alternate is active" {
+    const t = try testTerminal(10, 3);
+    defer terminal_c.free(t);
+    write(t, "a\r\nb\r\nc\r\nd\x1b[?1049h\x1b[Hvim");
+
+    const primary = try screenText(t, .primary, .all, .plain, true, 0);
+    defer primary.deinit();
+    try testing.expectEqualStrings("a\nb\nc\nd", primary.bytes);
+
+    const alternate = try screenText(t, .alternate, .all, .plain, true, 0);
+    defer alternate.deinit();
+    try testing.expectEqualStrings("vim", alternate.bytes);
+}
+
+test "format_screen splits history from the active area at the exact row" {
+    const t = try testTerminal(10, 3);
+    defer terminal_c.free(t);
+    // Two rows of history, then an active area whose bottom two rows are blank.
+    write(t, "a\r\nb\r\nc\r\n\r\n");
+
+    const history = try screenText(t, .primary, .history, .plain, true, 0);
+    defer history.deinit();
+    try testing.expectEqualStrings("a\nb", history.bytes);
+
+    const active = try screenText(t, .primary, .active, .plain, true, 0);
+    defer active.deinit();
+    try testing.expectEqualStrings("c", active.bytes);
+}
+
+test "format_screen writes no history for a screen without any" {
+    const t = try testTerminal(10, 3);
+    defer terminal_c.free(t);
+    write(t, "a");
+    const history = try screenText(t, .primary, .history, .plain, true, 0);
+    defer history.deinit();
+    try testing.expectEqualStrings("", history.bytes);
+}
+
+test "format_screen refuses terminal extras and a screen never entered is empty" {
+    const t = try testTerminal(10, 3);
+    defer terminal_c.free(t);
+    var ptr: ?[*]u8 = null;
+    var len: usize = 0;
+    try testing.expectEqual(Result.invalid_value, format_screen(t, @intFromEnum(ScreenSet.Key.primary), 0, @intFromEnum(formatterpkg.Format.vt), false, false, formatter_c.ExtraBit.palette.mask(), &lib.alloc.test_allocator, &ptr, &len));
+
+    const alternate = try screenText(t, .alternate, .all, .vt, false, 0);
+    defer alternate.deinit();
+    try testing.expectEqualStrings("", alternate.bytes);
+}
+
+test "format_state writes no content and places the cursor relative to origin mode" {
+    const t = try testTerminal(10, 6);
+    defer terminal_c.free(t);
+    write(t, "text\x1b[2;5r\x1b[?6h\x1b[2;3H");
+
+    const state = try stateText(t, cursor_extra);
+    defer state.deinit();
+    // Row 3, column 3 of the screen is row 2 of the region starting at row 2.
+    try testing.expectEqualStrings("\x1b[2;3H", state.bytes);
+}
+
+test "format_state restores a pending wrap on a blank cell" {
+    const t = try testTerminal(5, 3);
+    defer terminal_c.free(t);
+    // The cursor waits to wrap at the last column, whose cell holds nothing visible.
+    write(t, "abcd ");
+    try testing.expect(t.?.terminal.screens.active.cursor.pending_wrap);
+
+    const state = try stateText(t, cursor_extra);
+    defer state.deinit();
+
+    const replayed = try testTerminal(5, 3);
+    defer terminal_c.free(replayed);
+    write(replayed, state.bytes);
+    try testing.expect(replayed.?.terminal.screens.active.cursor.pending_wrap);
+    try testing.expectEqual(@as(u16, 4), replayed.?.terminal.screens.active.cursor.x);
+}
+
+test "screen_cursor_style reads each screen's own style" {
+    const t = try testTerminal(10, 4);
+    defer terminal_c.free(t);
+
+    var style: CursorStyle = .bar;
+    try testing.expectEqual(Result.success, screen_cursor_style(t, @intFromEnum(ScreenSet.Key.alternate), &style));
+    try testing.expectEqual(CursorStyle.block, style);
+
+    write(t, "\x1b[5 q\x1b[?1049h\x1b[4 q");
+    try testing.expectEqual(Result.success, screen_cursor_style(t, @intFromEnum(ScreenSet.Key.primary), &style));
+    try testing.expectEqual(CursorStyle.bar, style);
+    try testing.expectEqual(Result.success, screen_cursor_style(t, @intFromEnum(ScreenSet.Key.alternate), &style));
+    try testing.expectEqual(CursorStyle.underline, style);
+}
+
+test "mouse_tracking reads the mode set last, not the highest" {
+    const t = try testTerminal(10, 4);
+    defer terminal_c.free(t);
+
+    var event: u16 = 1;
+    var format: u16 = 1;
+    try testing.expectEqual(Result.success, mouse_tracking(t, &event, &format));
+    try testing.expectEqual(@as(u16, 0), event);
+    try testing.expectEqual(@as(u16, 0), format);
+
+    write(t, "\x1b[?1002h\x1b[?1000h\x1b[?1006h");
+    try testing.expectEqual(Result.success, mouse_tracking(t, &event, &format));
+    try testing.expectEqual(@as(u16, 1000), event);
+    try testing.expectEqual(@as(u16, 1006), format);
+}
+
+test "mouse_shift_capture says whether and what a program asked" {
+    const t = try testTerminal(10, 4);
+    defer terminal_c.free(t);
+
+    var capture: u8 = 9;
+    try testing.expectEqual(Result.success, mouse_shift_capture(t, &capture));
+    try testing.expectEqual(@as(u8, 0), capture);
+    write(t, "\x1b[>1s");
+    try testing.expectEqual(Result.success, mouse_shift_capture(t, &capture));
+    try testing.expectEqual(@as(u8, 2), capture);
+    write(t, "\x1b[>0s");
+    try testing.expectEqual(Result.success, mouse_shift_capture(t, &capture));
+    try testing.expectEqual(@as(u8, 1), capture);
+}
+
+test "clear_screen away from a prompt erases above the cursor and history" {
+    const t = try testTerminal(10, 3);
+    defer terminal_c.free(t);
+
+    write(t, "old\r\na\r\nb\r\nc");
+    var at_prompt = true;
+    try testing.expectEqual(Result.success, clear_screen(t, true, &at_prompt));
+    try testing.expect(!at_prompt);
+
+    const text = try t.?.terminal.plainString(testing.allocator);
+    defer testing.allocator.free(text);
