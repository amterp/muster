@@ -16,6 +19,68 @@ const FormatterWrapper = struct {
 
     const Kind = union(enum) {
         terminal: formatterpkg.TerminalFormatter,
+        screen: ScreenKind,
+    };
+
+    /// A screen formatter holds the terminal and the screen's key rather
+    /// than a screen pointer, and resolves the screen on every format call,
+    /// so it follows the terminal like a terminal formatter does (for
+    /// example, an alternate screen that is created after the formatter).
+    const ScreenKind = struct {
+        terminal: *const ZigTerminal,
+        key: ScreenSet.Key,
+        opts: formatterpkg.Options,
+        content: bool,
+        trailing_blank_rows: bool,
+        extra: formatterpkg.ScreenFormatter.Extra,
+
+        fn format(self: *const ScreenKind, writer: *std.Io.Writer) std.Io.Writer.Error!void {
+            // A screen that was never initialized has no content or state,
+            // so it formats as nothing.
+            const screen = self.terminal.screens.get(self.key) orelse return;
+
+            // Content and extras are formatted separately so that trailing
+            // blank rows, when requested, come between the two: extras such
+            // as the cursor position must be emitted last.
+            if (self.content) {
+                var content: formatterpkg.ScreenFormatter = .init(screen, self.opts);
+                content.extra = .none;
+                try content.format(writer);
+                if (self.trailing_blank_rows) try self.formatTrailingBlankRows(screen, writer);
+            }
+
+            var extra: formatterpkg.ScreenFormatter = .init(screen, self.opts);
+            extra.content = .none;
+            extra.extra = self.extra;
+            try extra.format(writer);
+        }
+
+        /// The formatter always omits blank rows below the last row with
+        /// text. Emitting them makes the output span every row of the
+        /// screen, so replaying it lines the screen up with the original.
+        fn formatTrailingBlankRows(
+            self: *const ScreenKind,
+            screen: *const Screen,
+            writer: *std.Io.Writer,
+        ) std.Io.Writer.Error!void {
+            var blank: usize = 0;
+            const bl_pin = screen.pages.getBottomRight(.screen) orelse return;
+            var it = bl_pin.rowIterator(.left_up, null);
+            while (it.next()) |row_pin| {
+                if (pagepkg.Cell.hasTextAny(row_pin.cells(.all))) break;
+                blank += 1;
+            }
+
+            // With no text at all, the content was empty and already
+            // occupies the first row.
+            if (blank == screen.pages.total_rows) blank -|= 1;
+
+            const sequence: []const u8 = switch (self.opts.emit) {
+                .plain, .html => "\n",
+                .vt => "\r\n",
+            };
+            for (0..blank) |_| try writer.writeAll(sequence);
+        }
     };
 };
 
