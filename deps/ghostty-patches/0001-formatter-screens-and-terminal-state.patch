+    terminal_c.vt_write(t, first, first.len);
+    const prompt = "\r\n$ ";
+    terminal_c.vt_write(t, prompt, prompt.len);
+    try testing.expectEqual(Result.success, kitty_image_loading_bytes(t, &bytes));
