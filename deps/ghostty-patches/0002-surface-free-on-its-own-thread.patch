+    /// Frees a surface as ghostty_surface_free does, except that its
+    /// threads are stopped and joined on a thread of their own.
+    ///
+    /// Joining them on the main thread can wait forever: they push to the
+    /// app mailbox with no timeout, only the main thread drains it, and an
+    /// IO thread joins its reader on the way out. So a main thread that
+    /// let the mailbox fill and then freed a surface waits on itself.
+    ///
+    /// Call this on the main thread. The surface leaves the app before it
+    /// returns, so nothing still queued for it is delivered. Once its
+    /// threads have exited, the rest of the free runs on the main queue,
+    /// because the renderer's teardown stops a display link and that is
+    /// only safe on the main thread; `done` is then called there with
+    /// `userdata`. The app must not be freed before then, and the main
+    /// queue must keep being serviced.
+    export fn ghostty_surface_free_detached(
+        ptr: *Surface,
+        done: ?*const fn (?*anyopaque) callconv(.c) void,
+        userdata: ?*anyopaque,
+    ) void {
+        // The half of Surface.deinit that touches the app, which only the
+        // main thread may.
+        ptr.freeInspector();
+        if (ptr.title) |v| ptr.app.core_app.alloc.free(v);
+        ptr.title = null;
+        ptr.app.core_app.deleteSurface(ptr);
+
+        // The layer's display pass runs on the main thread and calls into
+        // the renderer, whose thread is about to stop on another.
+        const api = &ptr.core_surface.renderer.api;
+        if (comptime @hasField(@TypeOf(api.*), "layer")) {
+            api.layer.setDisplayCallback(null, null);
+        }
+
+        const alloc = ptr.app.core_app.alloc;
+        const free = alloc.create(DetachedFree) catch {
+            log.warn("out of memory freeing a surface off the main thread, freeing it here", .{});
+            ptr.core_surface.deinit();
+            alloc.destroy(ptr);
+            if (done) |callback| callback(userdata);
+            return;
+        };
+        free.* = .{ .surface = ptr, .done = done, .userdata = userdata };
+
+        const thread = std.Thread.spawn(.{}, DetachedFree.stop, .{free}) catch |err| {
+            log.warn("error spawning a thread to free a surface, freeing it here err={}", .{err});
+            free.surface.core_surface.stopThreads();
+            DetachedFree.finish(free);
+            return;
+        };
+        thread.detach();
+    }
+
+    const DetachedFree = struct {
+        surface: *Surface,
+        done: ?*const fn (?*anyopaque) callconv(.c) void,
+        userdata: ?*anyopaque,
+
+        /// On the spawned thread: the joins, then the rest on the main queue.
+        fn stop(self: *DetachedFree) void {
+            self.surface.core_surface.stopThreads();
+            if (comptime builtin.target.os.tag.isDarwin()) {
+                const macos = @import("macos");
+                macos.dispatch.c.dispatch_async_f(
+                    macos.dispatch.c.dispatch_get_main_queue(),
+                    self,
+                    &finishCallback,
+                );
+            } else finish(self);
+        }
+
+        fn finishCallback(ud: ?*anyopaque) callconv(.c) void {
+            finish(@ptrCast(@alignCast(ud.?)));
+        }
+
+        fn finish(self: *DetachedFree) void {
+            const surface = self.surface;
+            const alloc = surface.app.core_app.alloc;
+            const done = self.done;
+            const userdata = self.userdata;
+            alloc.destroy(self);
+            surface.core_surface.deinitStopped();
+            alloc.destroy(surface);
+            if (done) |callback| callback(userdata);
+        }
+    };
+
     /// Returns the userdata associated with the surface.
     export fn ghostty_surface_userdata(surface: *Surface) ?*anyopaque {
         return surface.userdata;
