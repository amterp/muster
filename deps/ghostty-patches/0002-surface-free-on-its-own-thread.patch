+
+/// The first half of deinit: stops and joins the search, renderer and IO
+/// threads. It blocks on them, so an embedder can run it on a thread of its
+/// own. deinitStopped is the rest, and must then run on the main thread,
+/// since it destroys the renderer.
+pub fn stopThreads(self: *Surface) void {
     // Stop search thread
