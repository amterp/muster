{
  "concept": "herdr.layout.reconstruction",
  "why": "herdr describes a tab's arrangement as a flat list of pane rectangles beside a flat list of split borders, with no parent or child links between them, and the tree it will not give you is exactly what a window has to render. Rebuilding it from the rectangles is the whole of Muster's structure adapter, and it is code that is either right or quietly catastrophic: a wrong tree puts panes in the wrong places, which looks like a rendering bug and is not. These are layouts a real daemon published, including the two shapes that make the problem hard - splits under both sides of the root, and a split nested under a first child along the axis it is already split on. Every expected tree is herdr's own layout.export rendered in Muster's words, so the oracle is the daemon's answer rather than a second copy of the code being judged. Cases that refuse are here in the same number as cases that succeed, because this reads untrusted input from a dependency that ships weekly, and the failure that matters is inventing a plausible tree out of rectangles that describe none.",
  "source": "recorded",
  "regenerate": "tools/herdr-probe/probe layout",
  "cases": [
    {
      "name": "one pane is the whole tree",
      "why": "A tab nobody has split has no borders at all, so the answer comes from the panes alone. The wrong shape here is a root split with one child, which every consumer downstream would then have to defend against forever.",
      "given": {
        "area": {
          "x": 26,
          "y": 1,
          "width": 54,
          "height": 23
        },
        "focused_pane_id": "w1:p1",
        "panes": [
          {
            "pane_id": "w1:p1",
            "focused": true,
            "rect": {
              "x": 26,
              "y": 1,
              "width": 54,
              "height": 23
            }
          }
        ],
        "splits": [],
        "tab_id": "w1:t1",
        "workspace_id": "w1",
        "zoomed": false
      },
      "expect": {
        "tab": "w1:t1",
        "tree": "w1:p1",
        "focused": "w1:p1"
      }
    },
