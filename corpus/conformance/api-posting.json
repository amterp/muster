          {
            "as": "watcher",
            "send": {"correlation": "1", "api": {"subscribe": {"topics": ["TOPIC_MESSAGES"]}}},
            "heard": [{"answer": {"correlation": "1", "outcome": "OUTCOME_DONE", "epoch": "$epoch", "snapshot": "*"}}]
          },
          {
            "as": "foreman",
            "hello": {"kind": "KIND_API", "api": "$api", "client": {"name": "foreman"}},
            "heard": [{"welcome": "*"}]
          },
          {
            "as": "foreman",
            "send": {"correlation": "1", "msg": {"post": {"operation": "op-1", "group": "g", "to": ["a"], "body": "go ahead"}}},
            "then": "hang_up"
          },
          {
            "as": "watcher",
            "read": 1,
            "heard": [
              {
                "event": {
                  "epoch": "$epoch",
                  "number": "1",
                  "source": "*",
                  "logged": {
                    "group": "g",
                    "entry": {"number": "4", "atMs": "*", "post": {"author": "@human", "to": ["a"], "body": "go ahead", "via": "foreman"}}
                  }
                }
              }
            ]
          },
          {
            "as": "foreman",
            "hello": {"kind": "KIND_API", "api": "$api", "client": {"name": "foreman"}},
            "heard": [{"welcome": "*"}]
          },
          {
            "as": "foreman",
            "send": {"correlation": "2", "msg": {"post": {"operation": "op-1", "group": "g", "to": ["a"], "body": "go ahead"}}},
            "heard": [{"answer": {"correlation": "2", "outcome": "OUTCOME_ALREADY_SO", "posted": {"group": "g", "number": "4"}}}]
          },
          {"daemon": "hand_off"},
          {
            "as": "foreman",
            "hello": {"kind": "KIND_API", "api": "$api", "client": {"name": "foreman"}},
            "heard": [{"welcome": "*"}]
          },
          {
            "as": "foreman",
            "send": {"correlation": "3", "msg": {"post": {"operation": "op-1", "group": "g", "to": ["a"], "body": "go ahead"}}},
            "heard": [{"answer": {"correlation": "3", "outcome": "OUTCOME_ALREADY_SO", "posted": {"group": "g", "number": "4"}}}]
          },
          {"daemon": "restart"},
          {
            "as": "foreman",
            "hello": {"kind": "KIND_API", "api": "$api", "client": {"name": "foreman"}},
            "heard": [{"welcome": "*"}]
          },
          {
            "as": "foreman",
            "send": {"correlation": "4", "msg": {"post": {"operation": "op-1", "group": "g", "to": ["a"], "body": "go ahead"}}},
            "heard": [{"answer": {"correlation": "4", "outcome": "OUTCOME_ALREADY_SO", "posted": {"group": "g", "number": "4"}}}]
          },
          {
            "as": "foreman",
            "send": {"correlation": "5", "msg": {"history": {"group": "g", "after": "3"}}},
            "heard": [
              {
                "answer": {
                  "correlation": "5",
                  "outcome": "OUTCOME_DONE",
                  "page": {
                    "group": "g",
                    "entries": [
                      {"number": "4", "atMs": "*", "post": {"author": "@human", "to": ["a"], "body": "go ahead", "via": "foreman"}}
                    ]
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
