    {
      "name": "acknowledging what a phone showed leaves what arrived since unread, and never moves back",
      "why": "`msg.ack` moves the human's place on to the number the client showed them, at their home, and what arrived since stays unread at the desk; the move reaches subscribers as an Unread event before the answer. Already there or further on is ALREADY_SO, a number past the newest is INVALID, and a group the human is not in is NOT_FOUND. Only an acknowledgement moves the place for a program: reading at the desk still reads to the end (MIP-10, section 5).",
      "given": {"daemon": {}},
      "expect": {
        "conversation": [
          {"agent": "@human", "joins": "g"},
          {"agent": "a", "joins": "g"},
          {"agent": "b", "joins": "other"},
          {
            "as": "foreman",
            "hello": {"kind": "KIND_API", "api": "$api", "client": {"name": "foreman"}},
            "heard": [{"welcome": "*"}]
          },
          {
            "as": "foreman",
            "send": {"correlation": "1", "api": {"subscribe": {"topics": ["TOPIC_MESSAGES"]}}},
            "heard": [{"answer": {"correlation": "1", "outcome": "OUTCOME_DONE", "epoch": "$epoch", "snapshot": "*"}}]
          },
          {"agent": "a", "posts": "one", "group": "g", "to": ["@human"]},
          {"agent": "a", "posts": "two", "group": "g", "to": ["@human"]},
          {
            "as": "foreman",
            "read": 4,
            "heard": [
              {"event": {"epoch": "$epoch", "number": "1", "source": "*", "logged": {"group": "g", "entry": {"number": "4", "atMs": "*", "post": {"author": "a", "to": ["@human"], "body": "one"}}}}},
              {"event": {"epoch": "$epoch", "number": "2", "source": "*", "unread": {"group": "g", "place": "2", "count": "1", "waiting": [{"number": "4", "atMs": "*", "author": "a", "addressed": true}]}}},
              {"event": {"epoch": "$epoch", "number": "3", "source": "*", "logged": {"group": "g", "entry": {"number": "5", "atMs": "*", "post": {"author": "a", "to": ["@human"], "body": "two"}}}}},
              {
                "event": {
                  "epoch": "$epoch",
                  "number": "4",
                  "source": "*",
                  "unread": {
                    "group": "g",
                    "place": "2",
                    "count": "2",
                    "waiting": [{"number": "4", "atMs": "*", "author": "a", "addressed": true}, {"number": "5", "atMs": "*", "author": "a", "addressed": true}]
                  }
                }
              }
            ]
          },
          {
            "as": "foreman",
            "send": {"correlation": "2", "msg": {"ack": {"group": "g", "through": "4"}}},
            "heard": [
              {
                "event": {
                  "epoch": "$epoch",
                  "number": "5",
                  "source": "*",
                  "correlation": "2",
                  "unread": {"group": "g", "place": "4", "count": "1", "waiting": [{"number": "5", "atMs": "*", "author": "a", "addressed": true}]}
                }
              },
              {"answer": {"correlation": "2", "outcome": "OUTCOME_DONE", "epoch": "$epoch", "through": "5"}}
            ]
          },
          {
            "as": "foreman",
            "send": {"correlation": "3", "msg": {"ack": {"group": "g", "through": "4"}}},
            "heard": [{"answer": {"correlation": "3", "outcome": "OUTCOME_ALREADY_SO", "epoch": "$epoch", "through": "5"}}]
          },
          {
            "as": "foreman",
            "send": {"correlation": "4", "msg": {"ack": {"group": "g", "through": "3"}}},
            "heard": [{"answer": {"correlation": "4", "outcome": "OUTCOME_ALREADY_SO", "epoch": "$epoch", "through": "5"}}]
          },
          {
            "as": "foreman",
            "send": {"correlation": "5", "msg": {"ack": {"group": "g", "through": "9"}}},
            "heard": [{"answer": {"correlation": "5", "outcome": "OUTCOME_REFUSED", "epoch": "$epoch", "through": "5", "reason": "*", "refusal": "REFUSAL_INVALID"}}]
          },
          {
            "as": "foreman",
            "send": {"correlation": "6", "msg": {"ack": {"group": "other", "through": "1"}}},
            "heard": [{"answer": {"correlation": "6", "outcome": "OUTCOME_REFUSED", "epoch": "$epoch", "through": "5", "reason": "*", "refusal": "REFUSAL_NOT_FOUND"}}]
          },
          {
            "as": "foreman",
            "send": {"correlation": "7", "msg": {"ack": {"group": "nowhere", "through": "1"}}},
            "heard": [{"answer": {"correlation": "7", "outcome": "OUTCOME_REFUSED", "epoch": "$epoch", "through": "5", "reason": "*", "refusal": "REFUSAL_NOT_FOUND"}}]
          },
          {"app": "attending"},
          {"human": "reads", "group": "g"},
          {
            "as": "foreman",
            "read": 1,
            "heard": [{"event": {"epoch": "$epoch", "number": "6", "source": "*", "unread": {"group": "g", "place": "5"}}}]
          }
        ]
      }
    }
  ]
