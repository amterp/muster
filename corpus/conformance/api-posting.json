{
  "concept": "api-posting",
  "source": "authored",
  "citation": "docs/mip/0010-api-for-other-tools.md, sections 5 and 7; proto/muster_api.proto, its NewPost, Ack and Posted, and its header's Operation ids",
  "why": "`msg.post` posts as the human, as `muster msg post` does, with the client's name from its Hello shown beside the author, and `msg.ack` acknowledges the human's messages only as far as the one a client showed them. A post carries an operation id the client chooses, so a client that lost an answer asks again and never posts twice. In each case the human and an agent `a` are in group `g`: entries 1 to 3 are its making and the two joins, and the human's place is 2. A post across machines, NOT_SENT and UNKNOWN when its reply is lost, UNSUPPORTED where the human is homed on another machine, and UNAVAILABLE while a handoff holds the messages, take two daemons or a held handoff, and are the daemon's Rust tests (api_posting.rs, linked.rs). Each case is a conversation in protobuf's canonical JSON; docs/testing.md has the steps and tokens.",
  "cases": [
    {
      "name": "a post as the human is logged with the program's name, and its event carries the request's correlation id",
      "why": "A program posts as the human, and every post records the program by the name in its Hello, shown beside the author as `Alex (@human) via foreman`: attribution, not identity (MIP-10, section 5). The post's events reach the poster before the answer, with the request's correlation id, and the answer gives the post's group and number.",
      "given": {"daemon": {}},
      "expect": {
        "conversation": [
          {"agent": "@human", "joins": "g"},
          {"agent": "a", "joins": "g"},
          {
            "as": "foreman",
            "hello": {"kind": "KIND_API", "api": "$api", "client": {"name": "foreman"}},
            "heard": [{"welcome": "*"}]
          },
          {
            "as": "foreman",
            "send": {"correlation": "1", "api": {"subscribe": {"topics": ["TOPIC_MESSAGES"]}}},
            "heard": [{"answer": {"correlation": "1", "outcome": "OUTCOME_DONE", "epoch": "$epoch", "snapshot": "*"}}]
          },
          {
            "as": "foreman",
            "send": {"correlation": "2", "msg": {"post": {"operation": "op-1", "group": "g", "to": ["a"], "body": "go ahead"}}},
            "heard": [
              {
                "event": {
                  "epoch": "$epoch",
                  "number": "1",
                  "source": "*",
                  "correlation": "2",
                  "logged": {
                    "group": "g",
                    "entry": {"number": "4", "atMs": "*", "post": {"author": "@human", "to": ["a"], "body": "go ahead", "via": "foreman"}}
                  }
                }
              },
              {
                "answer": {
                  "correlation": "2",
                  "outcome": "OUTCOME_DONE",
                  "epoch": "$epoch",
                  "through": "1",
                  "posted": {"group": "g", "number": "4"}
                }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "a post asked again after a lost answer is posted once, across a reconnect, a handoff and a restart",
      "why": "The group's home keeps a post's operation id in the post's own log entry, so a client that hung up before its answer asks again under the same id, of the same daemon or the one that took over or started after it, and is told ALREADY_SO with the first post's group and number; nothing is posted twice (the header, Operation ids). Another subscriber's event is how the case knows the first post was made.",
      "given": {"daemon": {}},
      "expect": {
        "conversation": [
          {"agent": "@human", "joins": "g"},
          {"agent": "a", "joins": "g"},
          {
            "as": "watcher",
            "hello": {"kind": "KIND_API", "api": "$api", "client": {"name": "watcher"}},
            "heard": [{"welcome": "*"}]
