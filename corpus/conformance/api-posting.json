          {"agent": "a", "joins": "g"},
          {"agent": "a", "posts": "Ship?", "group": "g", "to": ["@human"], "answers": ["Yes", "No"]},
          {"agent": "@human", "posts": "Answer: Yes", "group": "g", "to": ["a"], "answering": {"question": 4, "answer": "Yes"}},
          {
