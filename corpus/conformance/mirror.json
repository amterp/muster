            "state": "deliberating"
          }
        ]
      },
      "expect": {
        "panes": [
          "w1:p1"
        ],
        "tabs": [],
        "workspaces": [],
        "agentStates": {
          "w1:p1": "unknown"
        },
        "focus": {},
        "health": "connected",
        "changes": [
          "agentStateChanged:w1:p1:idle->unknown"
        ]
