      "expect": {
        "panes": [
          "w1:p1",
          "w1:p2"
        ],
        "tabs": [
          "w1:t1"
        ],
        "workspaces": [
          "w1"
        ],
        "agentStates": {
          "w1:p1": "idle",
          "w1:p2": "idle"
        },
        "focus": {
          "workspace": "w1",
          "tab": "w1:t1",
          "pane": "w1:p2"
        },
        "health": "connected",
        "changes": [
          "focusChanged"
        ]
      }
    },
    {
      "name": "focus does not survive the pane it names",
      "why": "A cursor pointing at a removed pane is worse than an empty one: every reader has to handle the dangling case, and the one that forgets renders a pane that is gone. Clearing it here lets the rest of the core treat a focused id as one that exists. The reported change matters as much as the clearing - an earlier version cleared the cursor and told nobody, so a view watching for changes would have kept the stale highlight.",
      "given": {
        "snapshot": {
          "tabs": [
            {
              "id": "w1:t1",
              "workspace": "w1",
              "label": "1"
            }
          ],
          "panes": [
            {
              "id": "w1:p1",
              "tab": "w1:t1",
              "workspace": "w1",
              "agentState": "idle"
            }
          ],
          "focus": {
            "tab": "w1:t1",
            "pane": "w1:p1"
          }
        },
        "events": [
          {
            "kind": "paneRemoved",
            "id": "w1:p1"
          }
        ]
      },
      "expect": {
        "panes": [],
        "tabs": [
          "w1:t1"
        ],
        "workspaces": [],
        "agentStates": {},
        "focus": {
          "tab": "w1:t1"
        },
        "health": "connected",
        "changes": [
          "paneRemoved:w1:p1:announced",
          "focusChanged"
        ]
      }
    },
    {
      "name": "a state nobody has heard of reads as unknown, never as idle",
      "why": "herdr's API is explicitly unstable and ships weekly, so a newer daemon can name a state this build has never seen. Unknown renders as itself; idle would tell the user nothing needs them, which is the one wrong answer that looks like a right one.",
      "given": {
        "snapshot": {
          "panes": [
            {
              "id": "w1:p1",
              "tab": "w1:t1",
              "workspace": "w1",
              "agentState": "idle"
