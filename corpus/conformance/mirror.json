        "tabs": [
          "w1:t1"
        ],
        "workspaces": [],
        "agentStates": {
          "w1:p1": "idle"
        },
        "focus": {},
        "health": "connected",
        "changes": [
          "paneRemoved:w1:p2:announced"
        ]
      }
    },
    {
      "name": "removing something already gone changes nothing",
      "why": "Not defensive coding: it is routine. A reconnect re-snapshots and the replay that follows describes a world the mirror has already caught up with, so a removal for an unknown id arrives in normal operation. Reporting it as a change would repaint for no news; failing on it would take the window down over an event that carried none.",
      "given": {
        "snapshot": {
          "panes": [
            {
              "id": "w1:p1",
              "tab": "w1:t1",
              "workspace": "w1",
              "agentState": "idle"
            }
          ]
        },
        "events": [
          {
            "kind": "paneRemoved",
            "id": "w1:p9"
          },
          {
            "kind": "tabRemoved",
            "id": "w1:t9"
          },
          {
            "kind": "workspaceRemoved",
            "id": "w9"
          }
        ]
      },
      "expect": {
        "panes": [
          "w1:p1"
        ],
        "tabs": [],
        "workspaces": [],
        "agentStates": {
          "w1:p1": "idle"
        },
        "focus": {},
        "health": "connected",
        "changes": []
      }
    },
    {
      "name": "an agent state change is reported once, and only when it moves",
      "why": "The one change this whole product is about. Reported once so a listener can act on it, and not at all when the state repeats - herdr sends a status event per transition, and a mirror that echoed every one would flash the indicator on no news.",
      "given": {
        "snapshot": {
          "panes": [
            {
              "id": "w1:p1",
              "tab": "w1:t1",
              "workspace": "w1",
              "agentState": "idle"
            }
          ]
        },
        "events": [
