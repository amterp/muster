    },
    {
      "name": "a reconnect reports what moved, not that everything did",
      "why": "Bootstrap runs again on every reconnection, and a mirror that reported the whole world as new would repaint every pane each time the network hiccupped. What a reader needs is the difference: this pane's agent changed while we were away, that one is gone, this one is new.",
      "given": {
        "snapshot": {
          "tabs": [
            {
              "id": "w1:t1",
              "workspace": "w1",
              "label": "1"
            }
