        "tabs": [],
        "workspaces": [],
        "agentStates": {
          "w1:p1": "blocked"
        },
        "focus": {},
        "health": "connected",
        "changes": [
          "agentStateChanged:w1:p1:idle->working",
          "agentStateChanged:w1:p1:working->blocked"
        ]
      }
    },
    {
      "name": "focus cursors are absolute and independent",
      "why": "herdr moves three cursors with separate events, each naming only its own. Treating absence as a clear would make a pane focus silently unfocus the workspace. Absolute values are also what makes ordering not matter: two events racing land on the later value rather than compounding.",
      "given": {
        "snapshot": {
          "workspaces": [
            {
              "id": "w1",
              "label": "tmp"
            }
          ],
          "tabs": [
            {
              "id": "w1:t1",
              "workspace": "w1",
              "label": "1"
            }
          ],
          "panes": [
            {
              "id": "w1:p1",
              "tab": "w1:t1",
              "workspace": "w1",
              "agentState": "idle"
            },
            {
              "id": "w1:p2",
              "tab": "w1:t1",
              "workspace": "w1",
              "agentState": "idle"
            }
          ],
          "focus": {
            "workspace": "w1",
            "tab": "w1:t1",
            "pane": "w1:p1"
          }
        },
        "events": [
          {
            "kind": "focusMoved",
            "pane": "w1:p2"
          }
        ]
