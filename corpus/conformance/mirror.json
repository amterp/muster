        "tabs": [
          "w1:t1"
        ],
        "workspaces": [],
        "agentStates": {
          "w1:p1": "blocked",
          "w1:p3": "idle"
        },
        "focus": {},
        "health": "connected",
        "changes": [
          "agentStateChanged:w1:p1:idle->blocked",
          "paneAdded:w1:p3",
          "paneRemoved:w1:p2:announced"
        ]
      }
    }
  ]
