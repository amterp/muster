              "id": "w1:p1",
              "tab": "w1:t1",
              "workspace": "w1",
              "agentState": "unknown"
            },
            {
              "id": "w1:p2",
              "tab": "w1:t1",
              "workspace": "w1",
              "agentState": "working"
            }
          ],
          "focus": {
            "workspace": "w1",
            "tab": "w1:t1",
            "pane": "w1:p1"
          }
        },
        "events": []
