      "expect": {
        "panes": [
          "w1:p1",
          "w1:p2"
        ],
        "tabs": [
          "w1:t1"
        ],
        "workspaces": [
          "w1"
        ],
        "agentStates": {
          "w1:p1": "unknown",
          "w1:p2": "working"
        },
        "layouts": {},
        "focus": {
          "workspace": "w1",
          "tab": "w1:t1",
          "pane": "w1:p1"
