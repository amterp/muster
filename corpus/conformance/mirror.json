              "id": "w1:t1",
              "workspace": "w1",
              "label": "1"
            },
            {
              "id": "w2:t1",
              "workspace": "w2",
              "label": "1"
            }
          ],
          "panes": [
            {
              "id": "w1:p1",
              "tab": "w1:t1",
              "workspace": "w1",
              "agentState": "idle"
            },
            {
              "id": "w2:p1",
              "tab": "w2:t1",
              "workspace": "w2",
              "agentState": "working"
