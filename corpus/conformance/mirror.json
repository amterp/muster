        "snapshot": {
          "panes": [
            {
              "id": "w1:p1",
              "tab": "w1:t1",
              "workspace": "w1",
              "agentState": "idle"
            }
          ],
          "agentStateSeq": 4
        },
        "events": [
          {
            "kind": "agentStateChanged",
            "pane": "w1:p1",
            "state": "working"
          }
        ],
        "resnapshot": {
          "panes": [
            {
              "id": "w1:p1",
              "tab": "w1:t1",
              "workspace": "w1",
              "agentState": "working"
