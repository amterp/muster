        "tabs": [],
        "workspaces": [],
        "agentStates": {
          "w1:p1": "working"
        },
        "layouts": {},
        "focus": {},
        "health": "connected",
        "changes": [
          "agentStateChanged:w1:p1:idle->working",
          "agentTransitionsMissed:5..9"
        ]
      }
    },
