// libghostty-vt's C API, as a module Swift can import.
//
// Hand-written rather than using the ghostty-vt.xcframework that sits next to the
// dylib, because that xcframework carries the static archive and Muster cannot link it:
// see the note in Package.swift.
module CGhosttyVt {
  header "../../deps/ghostty/zig-out/include/ghostty/vt.h"
  link "ghostty-vt"
  export *
}
